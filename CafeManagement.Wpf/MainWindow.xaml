<Window x:Class="CafeManagement.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:CafeManagement.Wpf.ViewModels"
        mc:Ignorable="d"
        Title="Hệ Thống Quản Lý Chuỗi Quán Cà Phê - POS &amp; KDS Barista" 
        Height="800" Width="1280"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        Background="#F4F6F9"
        FontFamily="Segoe UI">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220" /> <!-- Cột 0: Thanh Menu Trái (Sidebar) -->
            <ColumnDefinition Width="*" />   <!-- Cột 1: Khu vực Menu Món Ăn (hoặc KDS toàn màn hình) -->
            <ColumnDefinition Width="430" /> <!-- Cột 2: Khu vực Giỏ Hàng & Thanh Toán (POS) -->
        </Grid.ColumnDefinitions>

        <!-- ==================== CỘT 0: SIDEBAR ĐIỀU HƯỚNG ==================== -->
        <Border Grid.Column="0" Background="#1E1E2D">
            <DockPanel LastChildFill="True">
                <!-- Logo & Tên Quán -->
                <StackPanel DockPanel.Dock="Top" Margin="20,25,20,30">
                    <TextBlock Text="☕ CAFE CHAIN" FontSize="20" FontWeight="Bold" Foreground="#FFA726" HorizontalAlignment="Center"/>
                    <TextBlock Text="Hệ Thống Quản Lý" FontSize="12" Foreground="#8A8A9E" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                </StackPanel>

                <!-- Thông tin phiên đăng nhập ở đáy & Nút Đăng xuất -->
                <Border DockPanel.Dock="Bottom" Background="#151521" Padding="15" Margin="10,0,10,15" CornerRadius="8">
                    <StackPanel>
                        <TextBlock Text="👤 Đang làm việc:" Foreground="#8A8A9E" FontSize="11"/>
                        <TextBlock Text="{Binding CurrentCashier}" Foreground="White" FontWeight="SemiBold" FontSize="13" Margin="0,2,0,5" TextWrapping="Wrap"/>
                        <TextBlock Text="📍 Chi nhánh:" Foreground="#8A8A9E" FontSize="11"/>
                        <TextBlock Text="{Binding BranchName}" Foreground="#FFA726" FontWeight="SemiBold" FontSize="12" TextWrapping="Wrap" Margin="0,2,0,12"/>

                        <!-- Nút Đăng xuất -->
                        <Button Content="🚪 Đăng Xuất (Đổi ca)" 
                                Command="{Binding LogoutCommand}"
                                Background="#2B2B40" Foreground="#E57373" FontWeight="Bold" FontSize="12" Height="36" BorderThickness="0" Cursor="Hand">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="6"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                    </StackPanel>
                </Border>

                <!-- Các nút Menu chức năng -->
                <StackPanel Margin="10,0">
                    <!-- Nút 1: Bán Hàng (POS) -->
                    <Border CornerRadius="8" Padding="15,12" Margin="0,0,0,8" Cursor="Hand"
                            Visibility="{Binding CanAccessPos, Converter={StaticResource BoolToVis}}">
                        <Border.InputBindings>
                            <MouseBinding Gesture="LeftClick" Command="{Binding SwitchToPosCommand}" />
                        </Border.InputBindings>
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="Transparent"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsPosView}" Value="True">
                                        <Setter Property="Background" Value="#2B2B40"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🛒" FontSize="16" Margin="0,0,12,0"/>
                            <TextBlock Text="Bán Hàng (POS)" FontSize="13" FontWeight="Bold" VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#8A8A9E"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsPosView}" Value="True">
                                                <Setter Property="Foreground" Value="White"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <!-- Nút 2: Pha Chế (KDS Barista) -->
                    <Border CornerRadius="8" Padding="15,12" Margin="0,0,0,8" Cursor="Hand"
                            Visibility="{Binding CanAccessKds, Converter={StaticResource BoolToVis}}">
                        <Border.InputBindings>
                            <MouseBinding Gesture="LeftClick" Command="{Binding SwitchToKdsCommand}" />
                        </Border.InputBindings>
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="Transparent"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsKdsView}" Value="True">
                                        <Setter Property="Background" Value="#2B2B40"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                                <TextBlock Text="🍳" FontSize="16" Margin="0,0,12,0"/>
                                <TextBlock Text="Pha Chế (KDS)" FontSize="13" FontWeight="Bold" VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="#8A8A9E"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsKdsView}" Value="True">
                                                    <Setter Property="Foreground" Value="White"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                            <!-- Badge số đơn đang chờ pha chế -->
                            <Border DockPanel.Dock="Right" Background="#E65100" CornerRadius="10" Padding="6,2" VerticalAlignment="Center">
                                <TextBlock Text="{Binding KdsTickets.Count}" Foreground="White" FontSize="11" FontWeight="Bold"/>
                            </Border>
                        </DockPanel>
                    </Border>

                    <!-- Nút 3: Kho Nguyên Liệu -->
                    <Border CornerRadius="8" Padding="15,12" Margin="0,0,0,8" Cursor="Hand"
                            Visibility="{Binding CanAccessInventory, Converter={StaticResource BoolToVis}}">
                        <Border.InputBindings>
                            <MouseBinding Gesture="LeftClick" Command="{Binding SwitchToInventoryCommand}" />
                        </Border.InputBindings>
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="Transparent"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsInventoryView}" Value="True">
                                        <Setter Property="Background" Value="#2B2B40"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                                <TextBlock Text="📦" FontSize="16" Margin="0,0,12,0"/>
                                <TextBlock Text="Kho Nguyên Liệu" FontSize="13" FontWeight="Bold" VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="#8A8A9E"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsInventoryView}" Value="True">
                                                    <Setter Property="Foreground" Value="White"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                            <!-- Badge cảnh báo nếu có món sắp hết -->
                            <Border DockPanel.Dock="Right" Background="#C0392B" CornerRadius="10" Padding="6,2" VerticalAlignment="Center">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding LowStockCount}" Value="0">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="{Binding LowStockCount}" Foreground="White" FontSize="11" FontWeight="Bold"/>
                            </Border>
                        </DockPanel>
                    </Border>

                    <!-- Nút 4: Món & Định Giá -->
                    <Border CornerRadius="8" Padding="15,12" Margin="0,0,0,8" Cursor="Hand"
                            Visibility="{Binding CanAccessProduct, Converter={StaticResource BoolToVis}}">
                        <Border.InputBindings>
                            <MouseBinding Gesture="LeftClick" Command="{Binding SwitchToProductCommand}" />
                        </Border.InputBindings>
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="Transparent"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsProductView}" Value="True">
                                        <Setter Property="Background" Value="#2B2B40"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📋" FontSize="16" Margin="0,0,12,0"/>
                            <TextBlock Text="Món &amp; Định Giá" FontSize="13" FontWeight="Bold" VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#8A8A9E"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsProductView}" Value="True">
                                                <Setter Property="Foreground" Value="White"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <!-- Nút 5: Báo Cáo Doanh Thu -->
                    <Border CornerRadius="8" Padding="15,12" Margin="0,0,0,8" Cursor="Hand"
                            Visibility="{Binding CanAccessReport, Converter={StaticResource BoolToVis}}">
                        <Border.InputBindings>
                            <MouseBinding Gesture="LeftClick" Command="{Binding SwitchToReportCommand}" />
                        </Border.InputBindings>
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="Transparent"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsReportView}" Value="True">
                                        <Setter Property="Background" Value="#2B2B40"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📊" FontSize="16" Margin="0,0,12,0"/>
                            <TextBlock Text="Báo Cáo Doanh Thu" FontSize="13" FontWeight="Bold" VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#8A8A9E"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsReportView}" Value="True">
                                                <Setter Property="Foreground" Value="White"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ==================== GIAO DIỆN 1: MÀN HÌNH BÁN HÀNG POS ==================== -->
        <!-- Menu Món Ăn (Cột 1) -->
        <Grid Grid.Column="1" Margin="20" Visibility="{Binding IsPosView, Converter={StaticResource BoolToVis}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Thanh Tabs Danh mục Món -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,15">
                <Button Content="Tất Cả Món" 
                        Command="{Binding FilterProductsCommand}" CommandParameter="{x:Null}"
                        Background="#FFA726" Foreground="White" FontWeight="Bold"
                        Padding="18,10" Margin="0,0,10,0" BorderThickness="0" Cursor="Hand">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="8"/>
                        </Style>
                    </Button.Resources>
                </Button>

                <ItemsControl ItemsSource="{Binding Categories}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Content="{Binding CategoryName}" 
                                    Command="{Binding DataContext.FilterProductsCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding}"
                                    Background="White" Foreground="#2C3E50" FontWeight="SemiBold"
                                    Padding="18,10" Margin="0,0,10,0" BorderThickness="1" BorderBrush="#E0E0E0" Cursor="Hand">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="8"/>
                                    </Style>
                                </Button.Resources>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <!-- Danh Sách Món Dạng Lưới -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Products}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Width="200" Height="220" Margin="0,0,15,15" Background="White" CornerRadius="12"
                                    BorderBrush="#E8ECEF" BorderThickness="1">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="8" Opacity="0.05" Direction="270" ShadowDepth="2"/>
                                </Border.Effect>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="100" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <!-- Ảnh / Icon minh họa món -->
                                    <Border Grid.Row="0" Background="#FFF3E0" CornerRadius="12,12,0,0">
                                        <TextBlock Text="☕" FontSize="45" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>

                                    <!-- Thông tin món -->
                                    <StackPanel Grid.Row="1" Margin="12,10,12,0">
                                        <TextBlock Text="{Binding ProductName}" FontWeight="Bold" FontSize="14" Foreground="#2C3E50" TextWrapping="Wrap" MaxHeight="38"/>
                                        <TextBlock Text="{Binding ProductCode}" FontSize="11" Foreground="#95A5A6" Margin="0,2,0,0"/>
                                        <TextBlock Text="{Binding BasePrice, StringFormat='{}{0:N0} đ'}" FontWeight="Bold" FontSize="15" Foreground="#E65100" Margin="0,4,0,0"/>
                                    </StackPanel>

                                    <!-- Nút Thêm vào đơn -->
                                    <Button Grid.Row="2" Content="+ Chọn món &amp; Tùy chỉnh"
                                            Command="{Binding DataContext.OpenCustomizeDialogCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}"
                                            Background="#27AE60" Foreground="White" FontWeight="Bold"
                                            Padding="0,8" Margin="12,0,12,12" BorderThickness="0" Cursor="Hand">
                                        <Button.Resources>
                                            <Style TargetType="Border">
                                                <Setter Property="CornerRadius" Value="6"/>
                                            </Style>
                                        </Button.Resources>
                                    </Button>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>

        <!-- Giỏ Hàng & Thanh Toán POS (Cột 2) -->
        <Border Grid.Column="2" Background="White" BorderBrush="#E8ECEF" BorderThickness="1,0,0,0"
                Visibility="{Binding IsPosView, Converter={StaticResource BoolToVis}}">
            <Grid Margin="18">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Tiêu đề đơn hàng & Nút xem đơn tạm -->
                <DockPanel Grid.Row="0" Margin="0,0,0,15">
                    <StackPanel DockPanel.Dock="Left">
                        <TextBlock Text="ĐƠN HÀNG HIỆN TẠI" FontWeight="Bold" FontSize="16" Foreground="#2C3E50"/>
                        <TextBlock Text="{Binding OrderNumber, StringFormat='Mã: {0}'}" FontSize="12" Foreground="#7F8C8D" Margin="0,2,0,0"/>
                    </StackPanel>

                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="{Binding HeldOrdersCount, StringFormat='Đơn tạm ({0})'}" 
                                Command="{Binding OpenHeldOrdersCommand}"
                                Background="#FFF3E0" Foreground="#E65100" BorderThickness="1" BorderBrush="#FFE0B2" FontWeight="Bold" Padding="8,4" Margin="0,0,8,0" Cursor="Hand">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="6"/>
                                </Style>
                            </Button.Resources>
                        </Button>

                        <Button Content="Xóa giỏ" 
                                Command="{Binding ClearCartCommand}"
                                Background="Transparent" Foreground="#E74C3C" BorderThickness="0" FontWeight="SemiBold" Cursor="Hand"/>
                    </StackPanel>
                </DockPanel>

                <!-- Danh sách món trong giỏ hàng -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding CartItems}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#F9FAFC" CornerRadius="8" Padding="12" Margin="0,0,0,8" BorderBrush="#EEEEEE" BorderThickness="1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <!-- Tên món, Tùy chọn chi tiết, Giá, và Nút Sửa -->
                                        <StackPanel Grid.Column="0">
                                            <DockPanel>
                                                <TextBlock Text="{Binding Product.ProductName}" FontWeight="Bold" FontSize="13" Foreground="#2C3E50" VerticalAlignment="Center"/>
                                                
                                                <Button Content="✏️ Sửa" 
                                                        Command="{Binding DataContext.EditCartItemCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}"
                                                        Background="#EBF5FB" Foreground="#2980B9" FontWeight="Bold" FontSize="11" 
                                                        Padding="6,2" Margin="8,0,0,0" BorderThickness="0" Cursor="Hand">
                                                    <Button.Resources>
                                                        <Style TargetType="Border">
                                                            <Setter Property="CornerRadius" Value="4"/>
                                                        </Style>
                                                    </Button.Resources>
                                                </Button>
                                            </DockPanel>

                                            <TextBlock Text="{Binding OptionsSummary}" FontSize="11" Foreground="#7F8C8D" TextWrapping="Wrap" Margin="0,3,0,4"/>
                                            <TextBlock Text="{Binding LineTotal, StringFormat='{}{0:N0} đ'}" FontWeight="Bold" FontSize="13" Foreground="#E65100"/>
                                        </StackPanel>

                                        <!-- Tăng giảm số lượng -->
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Content="-" 
                                                    Command="{Binding DataContext.DecreaseQuantityCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"
                                                    Width="28" Height="28" Background="#E0E0E0" FontWeight="Bold" BorderThickness="0" Cursor="Hand"/>
                                            <TextBlock Text="{Binding Quantity}" Width="30" TextAlignment="Center" FontWeight="Bold" FontSize="14" VerticalAlignment="Center"/>
                                            <Button Content="+" 
                                                    Command="{Binding DataContext.IncreaseQuantityCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"
                                                    Width="28" Height="28" Background="#27AE60" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- Tổng tiền và nút Thanh Toán -->
                <Border Grid.Row="2" BorderBrush="#EEEEEE" BorderThickness="0,1,0,0" Padding="0,15,0,0">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,6">
                            <TextBlock Text="Tạm tính:" Foreground="#7F8C8D" FontSize="13"/>
                            <TextBlock Text="{Binding SubTotal, StringFormat='{}{0:N0} đ'}" HorizontalAlignment="Right" FontWeight="SemiBold" FontSize="13"/>
                        </DockPanel>

                        <DockPanel Margin="0,0,0,10">
                            <TextBlock Text="Giảm giá:" Foreground="#7F8C8D" FontSize="13"/>
                            <TextBlock Text="{Binding DiscountAmount, StringFormat='{}{0:N0} đ'}" HorizontalAlignment="Right" FontWeight="SemiBold" FontSize="13" Foreground="#27AE60"/>
                        </DockPanel>

                        <DockPanel Margin="0,0,0,15">
                            <TextBlock Text="TỔNG TIỀN:" FontWeight="Bold" FontSize="16" Foreground="#2C3E50"/>
                            <TextBlock Text="{Binding FinalAmount, StringFormat='{}{0:N0} đ'}" HorizontalAlignment="Right" FontWeight="Bold" FontSize="20" Foreground="#E65100"/>
                        </DockPanel>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Button Grid.Column="0" Content="⏸ Tạm Giữ" 
                                    Command="{Binding HoldOrderCommand}" Margin="0,0,8,0"
                                    Background="#FFA726" Foreground="White" FontWeight="Bold" Height="48" BorderThickness="0" Cursor="Hand">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="8"/>
                                    </Style>
                                </Button.Resources>
                            </Button>

                            <Button Grid.Column="1" Content="THANH TOÁN (F9)" 
                                    Command="{Binding CheckoutCommand}"
                                    Background="#27AE60" Foreground="White" FontWeight="Bold" FontSize="15" Height="48" BorderThickness="0" Cursor="Hand">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="8"/>
                                    </Style>
                                </Button.Resources>
                            </Button>
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- ==================== GIAO DIỆN 2: MÀN HÌNH QUẦY PHA CHẾ (KDS BARISTA) ==================== -->
        <!-- Chiếm trọn Cột 1 và Cột 2 khi chọn Tab KDS -->
        <Grid Grid.Column="1" Grid.ColumnSpan="2" Margin="25" Visibility="{Binding IsKdsView, Converter={StaticResource BoolToVis}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" /> <!-- Header thống kê KDS -->
                <RowDefinition Height="*" />    <!-- Danh sách các Thẻ Ticket đang chờ làm -->
            </Grid.RowDefinitions>

            <!-- Header: Thống kê trạng thái đơn hàng trong quầy Bar -->
            <Border Grid.Row="0" Background="White" CornerRadius="12" Padding="20" Margin="0,0,0,20" BorderBrush="#E8ECEF" BorderThickness="1">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center">
                        <TextBlock Text="🍳 MÀN HÌNH QUẦY PHA CHẾ (KDS - KITCHEN DISPLAY SYSTEM)" FontWeight="Bold" FontSize="18" Foreground="#2C3E50"/>
                        <TextBlock Text="Tự động nhận đơn hàng từ Thu ngân và cập nhật tiến độ pha chế" FontSize="12" Foreground="#7F8C8D" Margin="0,3,0,0"/>
                    </StackPanel>

                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Badge Chờ làm -->
                        <Border Background="#EBF5FB" CornerRadius="8" Padding="12,8" Margin="0,0,10,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="⏳ Chờ pha: " Foreground="#2980B9" FontWeight="SemiBold" FontSize="13"/>
                                <TextBlock Text="{Binding KdsWaitingCount}" Foreground="#2980B9" FontWeight="Bold" FontSize="15"/>
                            </StackPanel>
                        </Border>

                        <!-- Badge Đang làm -->
                        <Border Background="#FEF9E7" CornerRadius="8" Padding="12,8" Margin="0,0,10,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="⚡ Đang pha: " Foreground="#D4AC0D" FontWeight="SemiBold" FontSize="13"/>
                                <TextBlock Text="{Binding KdsPreparingCount}" Foreground="#D4AC0D" FontWeight="Bold" FontSize="15"/>
                            </StackPanel>
                        </Border>

                        <!-- Badge Pha xong -->
                        <Border Background="#EAFAF1" CornerRadius="8" Padding="12,8" Margin="0,0,15,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="✅ Sẵn sàng: " Foreground="#27AE60" FontWeight="SemiBold" FontSize="13"/>
                                <TextBlock Text="{Binding KdsReadyCount}" Foreground="#27AE60" FontWeight="Bold" FontSize="15"/>
                            </StackPanel>
                        </Border>

                        <!-- Nút Làm Mới Thủ Công -->
                        <Button Content="🔄 Làm mới" 
                                Command="{Binding RefreshKdsCommand}"
                                Background="#F1F3F5" Foreground="#2C3E50" FontWeight="Bold" Padding="14,10" BorderThickness="0" Cursor="Hand">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="8"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Body: Danh sách Thẻ Ticket pha chế -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <Grid>
                    <!-- Thông báo khi quầy Bar không có đơn nào -->
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,80,0,0">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding KdsTickets.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Text="☕" FontSize="70" HorizontalAlignment="Center"/>
                        <TextBlock Text="Quầy pha chế đang trống!" FontWeight="Bold" FontSize="20" Foreground="#2C3E50" HorizontalAlignment="Center" Margin="0,15,0,5"/>
                        <TextBlock Text="Các đơn hàng vừa thanh toán từ Thu ngân sẽ tự động xuất hiện tại đây." FontSize="14" Foreground="#7F8C8D" HorizontalAlignment="Center"/>
                    </StackPanel>

                    <!-- Danh sách các Thẻ Ticket -->
                    <ItemsControl ItemsSource="{Binding KdsTickets}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Width="340" Margin="0,0,20,20" Background="White" CornerRadius="12" BorderBrush="#E8ECEF" BorderThickness="1">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="10" Opacity="0.08" Direction="270" ShadowDepth="3"/>
                                    </Border.Effect>
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" /> <!-- Header của thẻ: Mã đơn & Giờ đặt -->
                                            <RowDefinition Height="*" />    <!-- Danh sách các ly nước cần pha -->
                                            <RowDefinition Height="Auto" /> <!-- Nút Bàn Giao Đơn ở đáy -->
                                        </Grid.RowDefinitions>

                                        <!-- Header Thẻ -->
                                        <Border Grid.Row="0" Background="#2C3E50" CornerRadius="12,12,0,0" Padding="15,12">
                                            <DockPanel>
                                                <StackPanel DockPanel.Dock="Left">
                                                    <TextBlock Text="{Binding OrderNumber, StringFormat='#{0}'}" FontWeight="Bold" FontSize="14" Foreground="White"/>
                                                    <TextBlock Text="{Binding OrderTypeText}" FontSize="12" Foreground="#F39C12" FontWeight="SemiBold" Margin="0,2,0,0"/>
                                                </StackPanel>
                                                <StackPanel DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding WaitTimeText}" Foreground="#BDC3C7" FontSize="11" HorizontalAlignment="Right"/>
                                                    <TextBlock Text="{Binding CreatedAt, StringFormat='{}{0:HH:mm}'}" Foreground="White" FontWeight="Bold" FontSize="13" HorizontalAlignment="Right"/>
                                                </StackPanel>
                                            </DockPanel>
                                        </Border>

                                        <!-- Danh sách các ly nước trong đơn -->
                                        <ItemsControl Grid.Row="1" ItemsSource="{Binding Items}" Margin="12,10">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="#F8F9FA" CornerRadius="8" Padding="10" Margin="0,0,0,8" BorderBrush="#EEEEEE" BorderThickness="1">
                                                        <Grid>
                                                            <Grid.RowDefinitions>
                                                                <RowDefinition Height="Auto" />
                                                                <RowDefinition Height="Auto" />
                                                                <RowDefinition Height="Auto" />
                                                            </Grid.RowDefinitions>

                                                            <!-- Tên món và số lượng -->
                                                            <DockPanel Grid.Row="0">
                                                                <TextBlock Text="{Binding Quantity, StringFormat='x{0}'}" FontWeight="Bold" FontSize="15" Foreground="#E65100" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                                <TextBlock Text="{Binding ProductName}" FontWeight="Bold" FontSize="14" Foreground="#2C3E50" TextWrapping="Wrap" VerticalAlignment="Center"/>
                                                            </DockPanel>

                                                            <!-- Chi tiết Size, Đường, Đá, Toppings -->
                                                            <TextBlock Grid.Row="1" Text="{Binding OptionsSummary}" FontSize="11" Foreground="#7F8C8D" TextWrapping="Wrap" Margin="0,4,0,4"/>

                                                            <!-- Ghi chú và Nút chuyển trạng thái món -->
                                                            <DockPanel Grid.Row="2" Margin="0,4,0,0">
                                                                <!-- Badge trạng thái hiện tại -->
                                                                <Border DockPanel.Dock="Left" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                                                                    <Border.Style>
                                                                        <Style TargetType="Border">
                                                                            <Setter Property="Background" Value="#EBF5FB"/>
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding IsPreparing}" Value="True">
                                                                                    <Setter Property="Background" Value="#FEF9E7"/>
                                                                                </DataTrigger>
                                                                                <DataTrigger Binding="{Binding IsReady}" Value="True">
                                                                                    <Setter Property="Background" Value="#EAFAF1"/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </Border.Style>
                                                                    <TextBlock Text="{Binding StatusDisplay}" FontSize="11" FontWeight="Bold">
                                                                        <TextBlock.Style>
                                                                            <Style TargetType="TextBlock">
                                                                                <Setter Property="Foreground" Value="#2980B9"/>
                                                                                <Style.Triggers>
                                                                                    <DataTrigger Binding="{Binding IsPreparing}" Value="True">
                                                                                        <Setter Property="Foreground" Value="#D4AC0D"/>
                                                                                    </DataTrigger>
                                                                                    <DataTrigger Binding="{Binding IsReady}" Value="True">
                                                                                        <Setter Property="Foreground" Value="#27AE60"/>
                                                                                    </DataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </TextBlock.Style>
                                                                    </TextBlock>
                                                                </Border>

                                                                <!-- Nút thao tác nhanh cho Barista -->
                                                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                                                                    <!-- Nút Bắt đầu pha (Hiện khi QUEUED) -->
                                                                    <Button Content="⚡ Bắt đầu" 
                                                                            Command="{Binding DataContext.StartPreparingItemCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                            CommandParameter="{Binding}"
                                                                            Visibility="{Binding IsQueued, Converter={StaticResource BoolToVis}}"
                                                                            Background="#FFA726" Foreground="White" FontWeight="Bold" FontSize="11" Padding="8,4" BorderThickness="0" Cursor="Hand">
                                                                        <Button.Resources>
                                                                            <Style TargetType="Border">
                                                                                <Setter Property="CornerRadius" Value="4"/>
                                                                            </Style>
                                                                        </Button.Resources>
                                                                    </Button>

                                                                    <!-- Nút Pha xong (Hiện khi PREPARING) -->
                                                                    <Button Content="✅ Đã pha xong" 
                                                                            Command="{Binding DataContext.CompleteItemCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                            CommandParameter="{Binding}"
                                                                            Visibility="{Binding IsPreparing, Converter={StaticResource BoolToVis}}"
                                                                            Background="#27AE60" Foreground="White" FontWeight="Bold" FontSize="11" Padding="8,4" BorderThickness="0" Cursor="Hand">
                                                                        <Button.Resources>
                                                                            <Style TargetType="Border">
                                                                                <Setter Property="CornerRadius" Value="4"/>
                                                                            </Style>
                                                                        </Button.Resources>
                                                                    </Button>
                                                                </StackPanel>
                                                            </DockPanel>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <!-- Footer Thẻ: Nút Bàn Giao Cho Khách -->
                                        <Border Grid.Row="2" Background="#FDFEFE" BorderBrush="#EEEEEE" BorderThickness="0,1,0,0" Padding="12">
                                            <Button Content="🎉 BÀN GIAO CHO KHÁCH" 
                                                    Command="{Binding DataContext.ServeOrderCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"
                                                    Background="#27AE60" Foreground="White" FontWeight="Bold" FontSize="13" Height="38" BorderThickness="0" Cursor="Hand">
                                                <Button.Resources>
                                                    <Style TargetType="Border">
                                                        <Setter Property="CornerRadius" Value="6"/>
                                                    </Style>
                                                </Button.Resources>
                                            </Button>
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </ScrollViewer>
        </Grid>

        <!-- ==================== GIAO DIỆN 3: MÀN HÌNH QUẢN LÝ TỒN KHO NGUYÊN LIỆU ==================== -->
        <Grid Grid.Column="1" Grid.ColumnSpan="2" Margin="25" Visibility="{Binding IsInventoryView, Converter={StaticResource BoolToVis}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" /> <!-- Header thống kê & nút tác vụ kho -->
                <RowDefinition Height="*" />    <!-- Bố cục 2 cột: Danh sách tồn kho & Thẻ kho -->
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border Grid.Row="0" Background="White" CornerRadius="12" Padding="20" Margin="0,0,0,20" BorderBrush="#E8ECEF" BorderThickness="1">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center">
                        <TextBlock Text="📦 QUẢN LÝ TỒN KHO NGUYÊN LIỆU &amp; ĐỊNH MỨC CHI NHÁNH" FontWeight="Bold" FontSize="18" Foreground="#2C3E50"/>
                        <TextBlock Text="Theo dõi tồn kho theo thời gian thực và lịch sử biến động thẻ kho" FontSize="12" Foreground="#7F8C8D" Margin="0,3,0,0"/>
                    </StackPanel>

                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Badge Cảnh báo sắp hết -->
                        <Border Background="#FDEDEC" CornerRadius="8" Padding="12,8" Margin="0,0,15,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="⚠️ Sắp hết hàng: " Foreground="#C0392B" FontWeight="SemiBold" FontSize="13"/>
                                <TextBlock Text="{Binding LowStockCount, StringFormat='{}{0} món'}" Foreground="#C0392B" FontWeight="Bold" FontSize="14"/>
                            </StackPanel>
                        </Border>

                        <!-- Nút Thêm Nguyên Liệu Mới -->
                        <Button Content="➕ Thêm Nguyên Liệu" 
                                Command="{Binding OpenAddIngredientDialogCommand}"
                                Background="#E67E22" Foreground="White" FontWeight="Bold" FontSize="13" Padding="14,10" Margin="0,0,10,0" BorderThickness="0" Cursor="Hand">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="8"/>
                                </Style>
                            </Button.Resources>
                        </Button>

                        <!-- Nút Nhập Kho Nhanh -->
                        <Button Content="+ Nhập Kho Nhanh" 
                                Command="{Binding OpenImportStockDialogCommand}"
                                Background="#27AE60" Foreground="White" FontWeight="Bold" FontSize="13" Padding="16,10" Margin="0,0,10,0" BorderThickness="0" Cursor="Hand">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="8"/>
                                </Style>
                            </Button.Resources>
                        </Button>

                        <!-- Nút Làm Mới Thủ Công -->
                        <Button Content="🔄 Làm mới" 
                                Command="{Binding RefreshInventoryCommand}"
                                Background="#F1F3F5" Foreground="#2C3E50" FontWeight="Bold" Padding="14,10" BorderThickness="0" Cursor="Hand">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="8"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Body: Chia làm 2 cột: Cột trái (Tồn kho hiện tại), Cột phải (Thẻ kho gần đây) -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*" /> <!-- Danh sách tồn kho nguyên liệu -->
                    <ColumnDefinition Width="2*" /> <!-- Thẻ kho / Lịch sử xuất nhập -->
                </Grid.ColumnDefinitions>

                <!-- Bảng 1: Danh sách tồn kho nguyên liệu -->
                <Border Grid.Column="0" Background="White" CornerRadius="12" Padding="20" Margin="0,0,15,0" BorderBrush="#E8ECEF" BorderThickness="1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <DockPanel Grid.Row="0" Margin="0,0,0,15">
                            <TextBlock Text="📊 Danh Sách Nguyên Vật Liệu Trong Kho" FontWeight="Bold" FontSize="15" Foreground="#2C3E50"/>
                            <TextBlock Text="{Binding InventoryItems.Count, StringFormat='({0} nguyên liệu)'}" FontSize="13" Foreground="#7F8C8D" Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </DockPanel>

                        <!-- Danh sách nguyên liệu dạng Card list -->
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding InventoryItems}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="0,0,0,10" Padding="14,12" Background="#FAFAFA" CornerRadius="8" BorderBrush="#EEEEEE" BorderThickness="1">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="105" />
                                                    <ColumnDefinition Width="105" />
                                                    <ColumnDefinition Width="140" />
                                                </Grid.ColumnDefinitions>

                                                <!-- Tên & Mã nguyên liệu -->
                                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding IngredientName}" FontWeight="Bold" FontSize="14" Foreground="#2C3E50"/>
                                                    <TextBlock Text="{Binding IngredientCode, StringFormat='Mã: {0}'}" FontSize="11" Foreground="#95A5A6" Margin="0,2,0,0"/>
                                                </StackPanel>

                                                <!-- Tồn kho & ĐVT -->
                                                <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0">
                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                        <TextBlock Text="{Binding QuantityOnHand, StringFormat='{}{0:N1}'}" FontWeight="Bold" FontSize="15" Foreground="#2C3E50"/>
                                                        <TextBlock Text="{Binding BaseUom}" FontSize="12" Foreground="#7F8C8D" Margin="3,0,0,0" VerticalAlignment="Bottom"/>
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding MinStockAlert, StringFormat='Mức an toàn: {0:N0}'}" FontSize="10" Foreground="#BDC3C7" HorizontalAlignment="Right" Margin="0,2,0,0"/>
                                                </StackPanel>

                                                <!-- Badge Trạng thái tồn kho -->
                                                <Border Grid.Column="2" CornerRadius="6" Padding="8,5" VerticalAlignment="Center" HorizontalAlignment="Center">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="#EAFAF1"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsLowStock}" Value="True">
                                                                    <Setter Property="Background" Value="#FDEDEC"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock Text="{Binding StatusText}" FontWeight="Bold" FontSize="11">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground" Value="#27AE60"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsLowStock}" Value="True">
                                                                        <Setter Property="Foreground" Value="#C0392B"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Border>

                                                <!-- Thao tác: Sửa & Kiểm kê điều chỉnh -->
                                                <StackPanel Grid.Column="3" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                    <Button Content="✏️ Sửa" 
                                                            Command="{Binding DataContext.OpenEditIngredientDialogCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                            CommandParameter="{Binding}"
                                                            Background="#3498DB" Foreground="White" FontWeight="Bold" FontSize="11"
                                                            Padding="8,5" Margin="0,0,5,0" BorderThickness="0" Cursor="Hand" ToolTip="Chỉnh sửa tên &amp; mức an toàn">
                                                        <Button.Resources>
                                                            <Style TargetType="Border">
                                                                <Setter Property="CornerRadius" Value="5"/>
                                                            </Style>
                                                        </Button.Resources>
                                                    </Button>

                                                    <Button Content="⚖️ Kiểm Kê" 
                                                            Command="{Binding DataContext.OpenAdjustStockDialogCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                            CommandParameter="{Binding}"
                                                            Background="#E67E22" Foreground="White" FontWeight="Bold" FontSize="11"
                                                            Padding="8,5" BorderThickness="0" Cursor="Hand" ToolTip="Kiểm kê thực tế &amp; điều chỉnh tồn kho">
                                                        <Button.Resources>
                                                            <Style TargetType="Border">
                                                                <Setter Property="CornerRadius" Value="5"/>
                                                            </Style>
                                                        </Button.Resources>
                                                    </Button>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Border>

                <!-- Bảng 2: Thẻ kho (Lịch sử giao dịch biến động tồn kho gần nhất) -->
                <Border Grid.Column="1" Background="White" CornerRadius="12" Padding="20" BorderBrush="#E8ECEF" BorderThickness="1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" /> <!-- Tiêu đề -->
                            <RowDefinition Height="Auto" /> <!-- Thanh Tìm kiếm & Lọc Loại giao dịch -->
                            <RowDefinition Height="*" />    <!-- Danh sách Thẻ kho -->
                        </Grid.RowDefinitions>

                        <DockPanel Grid.Row="0" Margin="0,0,0,10">
                            <TextBlock Text="📜 Nhật Ký Biến Động Thẻ Kho" FontWeight="Bold" FontSize="15" Foreground="#2C3E50"/>
                            <TextBlock Text="{Binding InventoryTransactions.Count, StringFormat='({0} giao dịch)'}" FontSize="12" Foreground="#27AE60" FontWeight="SemiBold" Margin="6,0,0,0" VerticalAlignment="Center"/>
                        </DockPanel>

                        <!-- Thanh Tìm Kiếm & Lọc Loại Biến Động -->
                        <Grid Grid.Row="1" Margin="0,0,0,12">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Ô tìm kiếm từ khóa -->
                            <Grid Grid.Row="0" Margin="0,0,0,8">
                                <TextBox Text="{Binding InventoryTransSearchKeyword, UpdateSourceTrigger=PropertyChanged}"
                                         Height="34" Padding="28,0,10,0" VerticalContentAlignment="Center"
                                         FontSize="12" BorderBrush="#BDC3C7">
                                    <TextBox.Resources>
                                        <Style TargetType="Border">
                                            <Setter Property="CornerRadius" Value="6"/>
                                        </Style>
                                    </TextBox.Resources>
                                </TextBox>
                                <TextBlock Text="🔍" FontSize="12" Foreground="#95A5A6" VerticalAlignment="Center" Margin="8,0,0,0" IsHitTestVisible="False"/>
                                <TextBlock Text="Tìm nguyên liệu, mã phiếu, ghi chú..." FontSize="11" Foreground="#BDC3C7"
                                           VerticalAlignment="Center" Margin="30,0,0,0" IsHitTestVisible="False">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding InventoryTransSearchKeyword}" Value="">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>

                            <!-- Bộ lọc loại giao dịch (Tags nằm ngang cuộn được) -->
                            <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="Tất cả" Command="{Binding FilterInventoryTransByTypeCommand}" CommandParameter="ALL"
                                            Padding="10,4" Margin="0,0,5,0" FontSize="11" FontWeight="SemiBold" Cursor="Hand" BorderThickness="0">
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="Background" Value="#F1F3F5"/>
                                                <Setter Property="Foreground" Value="#2C3E50"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding InventoryTransTypeFilter}" Value="ALL">
                                                        <Setter Property="Background" Value="#2C3E50"/>
                                                        <Setter Property="Foreground" Value="White"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                        <Button.Resources>
                                            <Style TargetType="Border">
                                                <Setter Property="CornerRadius" Value="4"/>
                                            </Style>
                                        </Button.Resources>
                                    </Button>

                                    <Button Content="📥 Nhập kho" Command="{Binding FilterInventoryTransByTypeCommand}" CommandParameter="GOODS_RECEIPT"
                                            Padding="10,4" Margin="0,0,5,0" FontSize="11" FontWeight="SemiBold" Cursor="Hand" BorderThickness="0">
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="Background" Value="#F1F3F5"/>
                                                <Setter Property="Foreground" Value="#2C3E50"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding InventoryTransTypeFilter}" Value="GOODS_RECEIPT">
                                                        <Setter Property="Background" Value="#27AE60"/>
                                                        <Setter Property="Foreground" Value="White"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                        <Button.Resources>
                                            <Style TargetType="Border">
                                                <Setter Property="CornerRadius" Value="4"/>
                                            </Style>
                                        </Button.Resources>
                                    </Button>

                                    <Button Content="☕ Bán hàng" Command="{Binding FilterInventoryTransByTypeCommand}" CommandParameter="SALE_CONSUMPTION"
                                            Padding="10,4" Margin="0,0,5,0" FontSize="11" FontWeight="SemiBold" Cursor="Hand" BorderThickness="0">
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="Background" Value="#F1F3F5"/>
                                                <Setter Property="Foreground" Value="#2C3E50"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding InventoryTransTypeFilter}" Value="SALE_CONSUMPTION">
                                                        <Setter Property="Background" Value="#C0392B"/>
                                                        <Setter Property="Foreground" Value="White"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                        <Button.Resources>
                                            <Style TargetType="Border">
                                                <Setter Property="CornerRadius" Value="4"/>
                                            </Style>
                                        </Button.Resources>
                                    </Button>

                                    <Button Content="⚖️ Điều chỉnh" Command="{Binding FilterInventoryTransByTypeCommand}" CommandParameter="STOCK_ADJUSTMENT"
                                            Padding="10,4" Margin="0,0,5,0" FontSize="11" FontWeight="SemiBold" Cursor="Hand" BorderThickness="0">
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="Background" Value="#F1F3F5"/>
                                                <Setter Property="Foreground" Value="#2C3E50"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding InventoryTransTypeFilter}" Value="STOCK_ADJUSTMENT">
                                                        <Setter Property="Background" Value="#E67E22"/>
                                                        <Setter Property="Foreground" Value="White"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                        <Button.Resources>
                                            <Style TargetType="Border">
                                                <Setter Property="CornerRadius" Value="4"/>
                                            </Style>
                                        </Button.Resources>
                                    </Button>

                                    <Button Content="🌱 Tồn ban đầu" Command="{Binding FilterInventoryTransByTypeCommand}" CommandParameter="INITIAL_STOCK"
                                            Padding="10,4" Margin="0,0,5,0" FontSize="11" FontWeight="SemiBold" Cursor="Hand" BorderThickness="0">
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="Background" Value="#F1F3F5"/>
                                                <Setter Property="Foreground" Value="#2C3E50"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding InventoryTransTypeFilter}" Value="INITIAL_STOCK">
                                                        <Setter Property="Background" Value="#2980B9"/>
                                                        <Setter Property="Foreground" Value="White"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                        <Button.Resources>
                                            <Style TargetType="Border">
                                                <Setter Property="CornerRadius" Value="4"/>
                                            </Style>
                                        </Button.Resources>
                                    </Button>
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>

                        <!-- Danh sách Thẻ kho -->
                        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding InventoryTransactions}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="0,0,0,10" Padding="12,10" Background="#F8F9FA" CornerRadius="8" BorderBrush="#EEEEEE" BorderThickness="1">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>

                                                <!-- Dòng 1: Thời gian, Loại giao dịch & Mã chứng từ -->
                                                <DockPanel Grid.Row="0">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding CreatedAt, StringFormat='{}{0:dd/MM HH:mm}'}" FontSize="11" Foreground="#7F8C8D" FontWeight="SemiBold"/>
                                                        
                                                        <!-- Huy hiệu Loại giao dịch -->
                                                        <Border Background="{Binding TransactionBackground}" CornerRadius="3" Padding="5,1" Margin="6,0,0,0">
                                                            <TextBlock Text="{Binding TransactionTypeBadge}" Foreground="{Binding TransactionColor}" FontSize="9" FontWeight="Bold"/>
                                                        </Border>

                                                        <Border Background="#FDEDEC" CornerRadius="3" Padding="4,1" Margin="6,0,0,0"
                                                                Visibility="{Binding IsCancelled, Converter={StaticResource BoolToVis}}">
                                                            <TextBlock Text="ĐÃ HỦY" Foreground="#C0392B" FontSize="9" FontWeight="Bold"/>
                                                        </Border>
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding ReferenceId}" HorizontalAlignment="Right" FontSize="11" Foreground="#2980B9" FontWeight="Bold"/>
                                                </DockPanel>

                                                <!-- Dòng 2: Tên nguyên liệu & Biến động (+/-) -->
                                                <DockPanel Grid.Row="1" Margin="0,5,0,0">
                                                    <StackPanel DockPanel.Dock="Left">
                                                        <TextBlock Text="{Binding IngredientName}" FontWeight="Bold" FontSize="13" Foreground="#2C3E50"/>
                                                        <TextBlock Text="{Binding Note}" FontSize="11" Foreground="#95A5A6" TextTrimming="CharacterEllipsis" MaxWidth="190" ToolTip="{Binding Note}"/>
                                                    </StackPanel>

                                                    <StackPanel DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding ChangeDisplay}" FontWeight="Bold" FontSize="13" HorizontalAlignment="Right">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Foreground" Value="#C0392B"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsIncrease}" Value="True">
                                                                            <Setter Property="Foreground" Value="#27AE60"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                        <TextBlock Text="{Binding BalanceAfter, StringFormat='Tồn: {0:N1}'}" FontSize="11" Foreground="#7F8C8D" HorizontalAlignment="Right"/>
                                                    </StackPanel>
                                                </DockPanel>

                                                <!-- Dòng 3: Nút Hủy / Xóa phiếu nhập kho nếu nhập sai -->
                                                <DockPanel Grid.Row="2" Margin="0,6,0,0" Visibility="{Binding CanCancel, Converter={StaticResource BoolToVis}}">
                                                    <Button DockPanel.Dock="Right" Content="🗑️ Xóa / Hủy phiếu này" 
                                                            Command="{Binding DataContext.CancelGoodsReceiptCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}"
                                                            Background="#FDEDEC" Foreground="#C0392B" FontWeight="Bold" FontSize="11" Padding="8,4" BorderThickness="1" BorderBrush="#FADBD8" Cursor="Hand">
                                                        <Button.Resources>
                                                            <Style TargetType="Border">
                                                                <Setter Property="CornerRadius" Value="4"/>
                                                            </Style>
                                                        </Button.Resources>
                                                    </Button>
                                                </DockPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- ==================== GIAO DIỆN 4: MÀN HÌNH BÁO CÁO DOANH THU & THỐNG KÊ (REPORT) ==================== -->
        <Grid Grid.Column="1" Grid.ColumnSpan="2" Margin="25" Visibility="{Binding IsReportView, Converter={StaticResource BoolToVis}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" /> <!-- Header & Bộ lọc thời gian/chi nhánh -->
                <RowDefinition Height="Auto" /> <!-- 4 Thẻ KPI Thống Kê Tổng Quan -->
                <RowDefinition Height="*" />    <!-- Bố cục 2 cột: Top Món & Nhật Ký Hóa Đơn -->
            </Grid.RowDefinitions>

            <!-- 1. Header & Bộ lọc -->
            <Border Grid.Row="0" Background="White" CornerRadius="12" Padding="20" Margin="0,0,0,15" BorderBrush="#E8ECEF" BorderThickness="1">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center">
                        <TextBlock Text="📊 BÁO CÁO DOANH THU &amp; HIỆU QUẢ BÁN HÀNG" FontWeight="Bold" FontSize="18" Foreground="#2C3E50"/>
                        <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                            <TextBlock Text="Đang lọc: " FontSize="12" Foreground="#7F8C8D"/>
                            <TextBlock Text="{Binding ReportDateFilterText}" FontSize="12" FontWeight="Bold" Foreground="#FFA726"/>
                            <TextBlock Text=" | " FontSize="12" Foreground="#BDC3C7" Margin="5,0"/>
                            <TextBlock Text="{Binding ReportBranchFilterText}" FontSize="12" FontWeight="Bold" Foreground="#2980B9"/>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Bộ lọc thời gian: Hôm nay, 7 ngày, Tháng này, Tất cả -->
                        <Border Background="#F1F3F5" CornerRadius="8" Padding="4" Margin="0,0,10,0">
                            <StackPanel Orientation="Horizontal">
                                <Button Content="Hôm nay" Command="{Binding FilterReportByDateCommand}" CommandParameter="TODAY"
                                        Padding="10,6" Background="Transparent" Foreground="#2C3E50" FontWeight="SemiBold" FontSize="12" BorderThickness="0" Cursor="Hand"/>
                                <Button Content="7 Ngày" Command="{Binding FilterReportByDateCommand}" CommandParameter="WEEK"
                                        Padding="10,6" Background="Transparent" Foreground="#2C3E50" FontWeight="SemiBold" FontSize="12" BorderThickness="0" Cursor="Hand"/>
                                <Button Content="Tháng này" Command="{Binding FilterReportByDateCommand}" CommandParameter="MONTH"
                                        Padding="10,6" Background="Transparent" Foreground="#2C3E50" FontWeight="SemiBold" FontSize="12" BorderThickness="0" Cursor="Hand"/>
                                <Button Content="Tất cả" Command="{Binding FilterReportByDateCommand}" CommandParameter="ALL"
                                        Padding="10,6" Background="Transparent" Foreground="#2C3E50" FontWeight="SemiBold" FontSize="12" BorderThickness="0" Cursor="Hand"/>
                            </StackPanel>
                        </Border>

                        <!-- Bộ lọc chi nhánh: Chi nhánh hiện tại vs Toàn chuỗi -->
                        <Border Background="#F1F3F5" CornerRadius="8" Padding="4" Margin="0,0,10,0">
                            <StackPanel Orientation="Horizontal">
                                <Button Content="Chi nhánh này" Command="{Binding FilterReportByBranchCommand}" CommandParameter="CURRENT"
                                        Padding="10,6" Background="Transparent" Foreground="#2C3E50" FontWeight="SemiBold" FontSize="12" BorderThickness="0" Cursor="Hand"/>
                                <Button Content="Toàn chuỗi" Command="{Binding FilterReportByBranchCommand}" CommandParameter="ALL"
                                        Padding="10,6" Background="Transparent" Foreground="#2C3E50" FontWeight="SemiBold" FontSize="12" BorderThickness="0" Cursor="Hand"/>
                            </StackPanel>
                        </Border>

                        <!-- Nút Làm Mới -->
                        <Button Content="🔄 Làm mới" Command="{Binding RefreshReportCommand}"
                                Background="#FFA726" Foreground="White" FontWeight="Bold" FontSize="12" Padding="14,8" BorderThickness="0" Cursor="Hand">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="8"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- 2. Hàng 4 Thẻ KPI Tổng Quan -->
            <Grid Grid.Row="1" Margin="0,0,0,15">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- KPI 1: Tổng Doanh Thu -->
                <Border Grid.Column="0" Background="White" CornerRadius="12" Padding="18,15" Margin="0,0,10,0" BorderBrush="#E8ECEF" BorderThickness="1">
                    <Grid>
                        <StackPanel>
                            <DockPanel>
                                <TextBlock Text="💰 TỔNG DOANH THU" FontSize="11" FontWeight="Bold" Foreground="#7F8C8D"/>
                                <Border Background="#EAFAF1" CornerRadius="10" Padding="6,2" HorizontalAlignment="Right">
                                    <TextBlock Text="{Binding ReportTotalOrders, StringFormat='{}{0} đơn'}" FontSize="11" FontWeight="Bold" Foreground="#27AE60"/>
                                </Border>
                            </DockPanel>
                            <TextBlock Text="{Binding ReportTotalRevenue, StringFormat='{}{0:N0} đ'}" FontSize="22" FontWeight="Bold" Foreground="#27AE60" Margin="0,8,0,0"/>
                            <TextBlock Text="Doanh thu thực tế đã thu" FontSize="11" Foreground="#95A5A6" Margin="0,3,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- KPI 2: Tổng Ly Bán Ra -->
                <Border Grid.Column="1" Background="White" CornerRadius="12" Padding="18,15" Margin="0,0,10,0" BorderBrush="#E8ECEF" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="☕ TỔNG SỐ LY BÁN RA" FontSize="11" FontWeight="Bold" Foreground="#7F8C8D"/>
                        <TextBlock Text="{Binding ReportTotalCups, StringFormat='{}{0:N0} ly'}" FontSize="22" FontWeight="Bold" Foreground="#E65100" Margin="0,8,0,0"/>
                        <TextBlock Text="Đồ uống &amp; món đã pha chế" FontSize="11" Foreground="#95A5A6" Margin="0,3,0,0"/>
                    </StackPanel>
                </Border>

                <!-- KPI 3: Giá Trị Đơn Trung Bình (AOV) -->
                <Border Grid.Column="2" Background="White" CornerRadius="12" Padding="18,15" Margin="0,0,10,0" BorderBrush="#E8ECEF" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="🧾 GIÁ TRỊ ĐƠN TRUNG BÌNH" FontSize="11" FontWeight="Bold" Foreground="#7F8C8D"/>
                        <TextBlock Text="{Binding ReportAverageOrderValue, StringFormat='{}{0:N0} đ'}" FontSize="22" FontWeight="Bold" Foreground="#2980B9" Margin="0,8,0,0"/>
                        <TextBlock Text="Doanh thu / Tổng số đơn" FontSize="11" Foreground="#95A5A6" Margin="0,3,0,0"/>
                    </StackPanel>
                </Border>

                <!-- KPI 4: Tỷ Trọng Thanh Toán (Tiền Mặt vs VietQR) -->
                <Border Grid.Column="3" Background="White" CornerRadius="12" Padding="18,15" BorderBrush="#E8ECEF" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="💳 PHƯƠNG THỨC THANH TOÁN" FontSize="11" FontWeight="Bold" Foreground="#7F8C8D"/>
                        <DockPanel Margin="0,8,0,2">
                            <TextBlock Text="Tiền mặt:" FontSize="11" Foreground="#2C3E50" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding ReportCashRevenue, StringFormat='{}{0:N0} đ'}" HorizontalAlignment="Right" FontSize="11" FontWeight="Bold" Foreground="#27AE60"/>
                        </DockPanel>
                        <DockPanel Margin="0,2,0,0">
                            <TextBlock Text="VietQR:" FontSize="11" Foreground="#2C3E50" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding ReportQrRevenue, StringFormat='{}{0:N0} đ'}" HorizontalAlignment="Right" FontSize="11" FontWeight="Bold" Foreground="#2980B9"/>
                        </DockPanel>
                        <!-- Thanh tỷ lệ % -->
                        <ProgressBar Height="6" Value="{Binding ReportCashPercent}" Maximum="100" Margin="0,8,0,0" Foreground="#27AE60" Background="#2980B9" BorderThickness="0"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- 3. Bố Cục 2 Cột: Top Món Bán Chạy & Nhật Ký Hóa Đơn -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="4*" /> <!-- Cột Trái: Top Món Bán Chạy -->
                    <ColumnDefinition Width="6*" /> <!-- Cột Phải: Lịch Sử Hóa Đơn -->
                </Grid.ColumnDefinitions>

                <!-- Cột Trái: Top 10 Món Bán Chạy Nhất (Best Sellers) -->
                <Border Grid.Column="0" Background="White" CornerRadius="12" Padding="20" Margin="0,0,15,0" BorderBrush="#E8ECEF" BorderThickness="1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <DockPanel Grid.Row="0" Margin="0,0,0,15">
                            <TextBlock Text="🏆 Top Món Bán Chạy Nhất" FontWeight="Bold" FontSize="15" Foreground="#2C3E50"/>
                            <TextBlock Text="{Binding ReportTopProducts.Count, StringFormat='({0} món)'}" FontSize="12" Foreground="#7F8C8D" Margin="6,0,0,0" VerticalAlignment="Center"/>
                        </DockPanel>

                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding ReportTopProducts}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="0,0,0,8" Padding="12,10" Background="#F8F9FA" CornerRadius="8" BorderBrush="#EEEEEE" BorderThickness="1">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="45" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <!-- Rank Badge -->
                                                <TextBlock Grid.Column="0" Text="{Binding RankBadge}" FontWeight="Bold" FontSize="13" VerticalAlignment="Center"/>

                                                <!-- Tên món & Tỷ trọng -->
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="5,0">
                                                    <TextBlock Text="{Binding ProductName}" FontWeight="Bold" FontSize="13" Foreground="#2C3E50"/>
                                                    <TextBlock Text="{Binding PercentOfTotal, StringFormat='Chiếm {0:F1}% doanh thu'}" FontSize="11" Foreground="#95A5A6" Margin="0,2,0,0"/>
                                                </StackPanel>

                                                <!-- Số lượng ly & Tiền -->
                                                <StackPanel Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding TotalQuantity, StringFormat='{}{0} ly'}" FontWeight="Bold" FontSize="14" Foreground="#E65100" HorizontalAlignment="Right"/>
                                                    <TextBlock Text="{Binding TotalRevenue, StringFormat='{}{0:N0} đ'}" FontSize="11" Foreground="#7F8C8D" HorizontalAlignment="Right" Margin="0,2,0,0"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Border>

                <!-- Cột Phải: Nhật Ký Hóa Đơn Bán Hàng Gần Nhất -->
                <Border Grid.Column="1" Background="White" CornerRadius="12" Padding="20" BorderBrush="#E8ECEF" BorderThickness="1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" /> <!-- Tiêu đề -->
                            <RowDefinition Height="Auto" /> <!-- Thanh Tìm kiếm & Lọc Hình thức thanh toán -->
                            <RowDefinition Height="*" />    <!-- Danh sách hóa đơn -->
                        </Grid.RowDefinitions>

                        <DockPanel Grid.Row="0" Margin="0,0,0,10">
                            <TextBlock Text="📜 Nhật Ký Đơn Hàng Đã Bán" FontWeight="Bold" FontSize="15" Foreground="#2C3E50"/>
                            <TextBlock Text="{Binding ReportRecentOrders.Count, StringFormat='({0} đơn hàng)'}" FontSize="12" Foreground="#27AE60" FontWeight="SemiBold" Margin="6,0,0,0" VerticalAlignment="Center"/>
                        </DockPanel>

                        <!-- Thanh Tìm Kiếm & Lọc Hình thức thanh toán -->
                        <Grid Grid.Row="1" Margin="0,0,0,12">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Ô tìm kiếm từ khóa -->
                            <Grid Grid.Row="0" Margin="0,0,0,8">
                                <TextBox Text="{Binding OrderSearchKeyword, UpdateSourceTrigger=PropertyChanged}"
                                         Height="34" Padding="28,0,10,0" VerticalContentAlignment="Center"
                                         FontSize="12" BorderBrush="#BDC3C7">
                                    <TextBox.Resources>
                                        <Style TargetType="Border">
                                            <Setter Property="CornerRadius" Value="6"/>
                                        </Style>
                                    </TextBox.Resources>
                                </TextBox>
                                <TextBlock Text="🔍" FontSize="12" Foreground="#95A5A6" VerticalAlignment="Center" Margin="8,0,0,0" IsHitTestVisible="False"/>
                                <TextBlock Text="Tìm theo mã HĐ, tên món, thu ngân..." FontSize="11" Foreground="#BDC3C7"
                                           VerticalAlignment="Center" Margin="30,0,0,0" IsHitTestVisible="False">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding OrderSearchKeyword}" Value="">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>

                            <!-- Bộ lọc hình thức thanh toán -->
                            <StackPanel Grid.Row="1" Orientation="Horizontal">
                                <Button Content="Tất cả" Command="{Binding FilterOrderPaymentCommand}" CommandParameter="ALL"
                                        Padding="10,4" Margin="0,0,5,0" FontSize="11" FontWeight="SemiBold" Cursor="Hand" BorderThickness="0">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Background" Value="#F1F3F5"/>
                                            <Setter Property="Foreground" Value="#2C3E50"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding OrderPaymentFilter}" Value="ALL">
                                                    <Setter Property="Background" Value="#2C3E50"/>
                                                    <Setter Property="Foreground" Value="White"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                    <Button.Resources>
                                        <Style TargetType="Border">
                                            <Setter Property="CornerRadius" Value="4"/>
                                        </Style>
                                    </Button.Resources>
                                </Button>

                                <Button Content="💵 Tiền mặt" Command="{Binding FilterOrderPaymentCommand}" CommandParameter="CASH"
                                        Padding="10,4" Margin="0,0,5,0" FontSize="11" FontWeight="SemiBold" Cursor="Hand" BorderThickness="0">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Background" Value="#F1F3F5"/>
                                            <Setter Property="Foreground" Value="#2C3E50"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding OrderPaymentFilter}" Value="CASH">
                                                    <Setter Property="Background" Value="#27AE60"/>
                                                    <Setter Property="Foreground" Value="White"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                    <Button.Resources>
                                        <Style TargetType="Border">
                                            <Setter Property="CornerRadius" Value="4"/>
                                        </Style>
                                    </Button.Resources>
                                </Button>

                                <Button Content="📲 VietQR" Command="{Binding FilterOrderPaymentCommand}" CommandParameter="VIETQR"
                                        Padding="10,4" Margin="0,0,5,0" FontSize="11" FontWeight="SemiBold" Cursor="Hand" BorderThickness="0">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Background" Value="#F1F3F5"/>
                                            <Setter Property="Foreground" Value="#2C3E50"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding OrderPaymentFilter}" Value="VIETQR">
                                                    <Setter Property="Background" Value="#2980B9"/>
                                                    <Setter Property="Foreground" Value="White"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                    <Button.Resources>
                                        <Style TargetType="Border">
                                            <Setter Property="CornerRadius" Value="4"/>
                                        </Style>
                                    </Button.Resources>
                                </Button>
                            </StackPanel>
                        </Grid>

                        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding ReportRecentOrders}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="0,0,0,8" Padding="12,10" Background="#FAFAFA" CornerRadius="8" BorderBrush="#EEEEEE" BorderThickness="1">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>

                                                <!-- Dòng 1: Mã HĐ, Giờ thanh toán, Hình thức -->
                                                <DockPanel Grid.Row="0">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding OrderNumber, StringFormat='#{0}'}" FontWeight="Bold" FontSize="13" Foreground="#2C3E50"/>
                                                        <TextBlock Text="{Binding CreatedAt, StringFormat='{}{0:dd/MM HH:mm}'}" FontSize="11" Foreground="#7F8C8D" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                                        <TextBlock Text="{Binding BranchName, StringFormat='- {0}'}" FontSize="11" Foreground="#95A5A6" Margin="4,0,0,0" VerticalAlignment="Center"/>
                                                    </StackPanel>

                                                    <Border HorizontalAlignment="Right" CornerRadius="4" Padding="6,2">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Background" Value="#EAFAF1"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding PaymentMethod}" Value="VIETQR">
                                                                        <Setter Property="Background" Value="#EBF5FB"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <TextBlock Text="{Binding PaymentMethodDisplay}" FontSize="10" FontWeight="Bold">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Foreground" Value="#27AE60"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding PaymentMethod}" Value="VIETQR">
                                                                            <Setter Property="Foreground" Value="#2980B9"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </Border>
                                                </DockPanel>

                                                <!-- Dòng 2: Món đã mua & Tổng tiền -->
                                                <DockPanel Grid.Row="1" Margin="0,6,0,0">
                                                    <StackPanel DockPanel.Dock="Left">
                                                        <TextBlock Text="{Binding ItemsSummary}" FontSize="12" Foreground="#4A5568" TextTrimming="CharacterEllipsis" MaxWidth="360"/>
                                                        <TextBlock Text="{Binding CashierName, StringFormat='Thu ngân: {0}'}" FontSize="11" Foreground="#A0AEC0" Margin="0,2,0,0"/>
                                                    </StackPanel>

                                                    <TextBlock DockPanel.Dock="Right" Text="{Binding FinalAmount, StringFormat='{}{0:N0} đ'}" 
                                                               FontWeight="Bold" FontSize="15" Foreground="#27AE60" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                                </DockPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- ==================== GIAO DIỆN 5: MÀN HÌNH QUẢN LÝ MÓN NƯỚC, GIÁ & CÔNG THỨC PHA CHẾ (BOM) ==================== -->
        <Grid Grid.Column="1" Grid.ColumnSpan="2" Margin="25" Visibility="{Binding IsProductView, Converter={StaticResource BoolToVis}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" /> <!-- Header & Bộ lọc nhóm món -->
                <RowDefinition Height="*" />    <!-- Bảng danh sách món nước -->
            </Grid.RowDefinitions>

            <!-- 1. Header & Nút tác vụ -->
            <Grid Grid.Row="0" Margin="0,0,0,20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Tiêu đề & Nút Thêm mới -->
                <DockPanel Grid.Row="0">
                    <StackPanel DockPanel.Dock="Left">
                        <TextBlock Text="📋 QUẢN LÝ DANH MỤC MÓN, GIÁ &amp; CÔNG THỨC (BOM)" FontSize="20" FontWeight="Bold" Foreground="#2C3E50"/>
                        <TextBlock Text="Cấu hình thực đơn toàn chuỗi • Thiết lập giá bán cơ bản, phụ thu kích cỡ &amp; định mức nguyên liệu tiêu hao" FontSize="12" Foreground="#7F8C8D" Margin="0,4,0,0"/>
                    </StackPanel>

                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="➕ Thêm Món Mới" Command="{Binding OpenAddProductDialogCommand}"
                                Background="#E67E22" Foreground="White" FontWeight="Bold" FontSize="13"
                                Padding="16,10" Cursor="Hand" BorderThickness="0">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="8"/>
                                </Style>
                            </Button.Resources>
                        </Button>

                        <Button Content="🔄 Làm mới" Command="{Binding LoadManagementProductsCommand}"
                                Background="#34495E" Foreground="White" FontWeight="Bold" FontSize="13"
                                Padding="16,10" Margin="10,0,0,0" Cursor="Hand" BorderThickness="0">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="8"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                    </StackPanel>
                </DockPanel>

                <!-- Thanh phân loại nhóm món (Categories Filter) -->
                <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Margin="0,15,0,0">
                    <StackPanel Orientation="Horizontal">
                        <!-- Nút Tất cả -->
                        <Button Content="Tất cả món" Command="{Binding FilterManagementProductsCommand}" CommandParameter="{x:Null}"
                                Padding="16,8" Margin="0,0,8,0" FontWeight="Bold" FontSize="12" Cursor="Hand" BorderThickness="0">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background" Value="#E8ECEF"/>
                                    <Setter Property="Foreground" Value="#2C3E50"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedManagementCategory}" Value="{x:Null}">
                                            <Setter Property="Background" Value="#2C3E50"/>
                                            <Setter Property="Foreground" Value="White"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="6"/>
                                </Style>
                            </Button.Resources>
                        </Button>

                        <!-- Danh sách các nhóm món -->
                        <ItemsControl ItemsSource="{Binding ManagementCategories}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Content="{Binding CategoryName}" 
                                            Command="{Binding DataContext.FilterManagementProductsCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}"
                                            Padding="16,8" Margin="0,0,8,0" FontWeight="Bold" FontSize="12" Cursor="Hand" BorderThickness="0" Background="#E8ECEF" Foreground="#2C3E50">
                                        <Button.Resources>
                                            <Style TargetType="Border">
                                                <Setter Property="CornerRadius" Value="6"/>
                                            </Style>
                                        </Button.Resources>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- 2. Danh sách món nước & Quản trị BOM -->
            <Border Grid.Row="1" Background="White" CornerRadius="12" Padding="20" BorderBrush="#E8ECEF" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" /> <!-- Tiêu đề cột -->
                        <RowDefinition Height="*" />    <!-- Danh sách -->
                    </Grid.RowDefinitions>

                    <!-- Tiêu đề cột -->
                    <Border Grid.Row="0" Background="#F8F9FA" Padding="15,12" CornerRadius="8" Margin="0,0,0,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2.5*" /> <!-- Mã & Tên món -->
                                <ColumnDefinition Width="1.2*" /> <!-- Nhóm món -->
                                <ColumnDefinition Width="1.8*" /> <!-- Giá & Biến thể -->
                                <ColumnDefinition Width="1.2*" /> <!-- Trạng thái -->
                                <ColumnDefinition Width="2.2*" /> <!-- Thao tác -->
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="MÃ &amp; TÊN MÓN NƯỚC" FontWeight="Bold" FontSize="11" Foreground="#7F8C8D"/>
                            <TextBlock Grid.Column="1" Text="NHÓM DANH MỤC" FontWeight="Bold" FontSize="11" Foreground="#7F8C8D"/>
                            <TextBlock Grid.Column="2" Text="GIÁ BÁN (SIZE M &amp; L)" FontWeight="Bold" FontSize="11" Foreground="#7F8C8D"/>
                            <TextBlock Grid.Column="3" Text="TRẠNG THÁI" FontWeight="Bold" FontSize="11" Foreground="#7F8C8D"/>
                            <TextBlock Grid.Column="4" Text="THAO TÁC QUẢN TRỊ" FontWeight="Bold" FontSize="11" Foreground="#7F8C8D" HorizontalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <!-- Danh sách món nước -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding ManagedProducts}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,0,0,8" Padding="15,12" Background="#FAFAFA" CornerRadius="8" BorderBrush="#EEEEEE" BorderThickness="1">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="2.5*" /> <!-- Mã & Tên món -->
                                                <ColumnDefinition Width="1.2*" /> <!-- Nhóm món -->
                                                <ColumnDefinition Width="1.8*" /> <!-- Giá & Biến thể -->
                                                <ColumnDefinition Width="1.2*" /> <!-- Trạng thái -->
                                                <ColumnDefinition Width="2.2*" /> <!-- Thao tác -->
                                            </Grid.ColumnDefinitions>

                                            <!-- 1. Tên món & Mã -->
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,10,0">
                                                <TextBlock Text="{Binding ProductName}" FontWeight="Bold" FontSize="14" Foreground="#2C3E50"/>
                                                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                    <Border Background="#EAEDED" CornerRadius="4" Padding="4,2" Margin="0,0,6,0">
                                                        <TextBlock Text="{Binding ProductCode}" FontSize="11" FontWeight="Bold" Foreground="#7F8C8D"/>
                                                    </Border>
                                                    <TextBlock Text="{Binding Description}" FontSize="11" Foreground="#95A5A6" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>
                                            </StackPanel>

                                            <!-- 2. Nhóm danh mục -->
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <Border Background="#EBF5FB" CornerRadius="6" Padding="8,4" HorizontalAlignment="Left">
                                                    <TextBlock Text="{Binding CategoryName}" FontWeight="Bold" FontSize="12" Foreground="#2980B9"/>
                                                </Border>
                                            </StackPanel>

                                            <!-- 3. Giá bán & Biến thể -->
                                            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding BasePrice, StringFormat='{}{0:N0} đ'}" FontWeight="Bold" FontSize="15" Foreground="#D35400"/>
                                                <TextBlock Text="{Binding VariantsDisplay}" FontSize="11" Foreground="#7F8C8D" Margin="0,2,0,0"/>
                                            </StackPanel>

                                            <!-- 4. Trạng thái -->
                                            <StackPanel Grid.Column="3" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding StatusBadge}" FontWeight="Bold" FontSize="12" Foreground="{Binding StatusColor}"/>
                                            </StackPanel>

                                            <!-- 5. Các nút thao tác -->
                                            <StackPanel Grid.Column="4" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <!-- Nút Sửa -->
                                                <Button Content="✏️ Sửa" 
                                                        Command="{Binding DataContext.OpenEditProductDialogCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}"
                                                        Background="#3498DB" Foreground="White" FontWeight="Bold" FontSize="11"
                                                        Padding="10,6" Margin="0,0,6,0" Cursor="Hand" BorderThickness="0">
                                                    <Button.Resources>
                                                        <Style TargetType="Border">
                                                            <Setter Property="CornerRadius" Value="6"/>
                                                        </Style>
                                                    </Button.Resources>
                                                </Button>

                                                <!-- Nút Công thức (BOM) -->
                                                <Button Content="⚙️ Công Thức" 
                                                        Command="{Binding DataContext.OpenRecipeConfigDialogCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}"
                                                        Background="#8E44AD" Foreground="White" FontWeight="Bold" FontSize="11"
                                                        Padding="10,6" Margin="0,0,6,0" Cursor="Hand" BorderThickness="0">
                                                    <Button.Resources>
                                                        <Style TargetType="Border">
                                                            <Setter Property="CornerRadius" Value="6"/>
                                                        </Style>
                                                    </Button.Resources>
                                                </Button>

                                                <!-- Nút Bật/Tắt -->
                                                <Button Content="Bật/Tắt" 
                                                        Command="{Binding DataContext.ToggleProductActiveCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}"
                                                        Background="#7F8C8D" Foreground="White" FontWeight="Bold" FontSize="11"
                                                        Padding="8,6" Cursor="Hand" BorderThickness="0">
                                                    <Button.Resources>
                                                        <Style TargetType="Border">
                                                            <Setter Property="CornerRadius" Value="6"/>
                                                        </Style>
                                                    </Button.Resources>
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
