<Window x:Class="CafeManagement.Wpf.Views.ShiftCloseWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Kết Toán Ca &amp; Đóng Ca (Shift Out)" Height="620" Width="520"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="#F8F9FA" FontFamily="Segoe UI">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Tiêu đề -->
        <Border Grid.Row="0" Background="#2B2B40" CornerRadius="8" Padding="15,12" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="🔒 KẾT TOÁN CA BÁN HÀNG &amp; ĐÓNG CA (SHIFT OUT)" FontWeight="Bold" FontSize="15" Foreground="White"/>
                <TextBlock Text="Kiểm đếm quỹ tiền mặt thực tế và đối soát doanh thu ca làm việc" FontSize="11" Foreground="#A0AEC0" Margin="0,2,0,0"/>
            </StackPanel>
        </Border>

        <!-- Nội dung chính -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- Thẻ thông tin ca -->
                <Border Background="White" CornerRadius="8" Padding="15" BorderBrush="#E2E8F0" BorderThickness="1" Margin="0,0,0,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Mã ca làm việc:" FontSize="11" Foreground="#718096"/>
                            <TextBlock x:Name="TxtShiftCode" Text="CA261117-001" FontWeight="Bold" FontSize="13" Foreground="#2B6CB0"/>
                            <TextBlock Text="Thu ngân:" FontSize="11" Foreground="#718096" Margin="0,6,0,0"/>
                            <TextBlock x:Name="TxtCashier" Text="Trần Thị Thu Ngân" FontWeight="SemiBold" FontSize="12" Foreground="#2D3748"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Ca làm việc:" FontSize="11" Foreground="#718096"/>
                            <TextBlock x:Name="TxtShiftName" Text="Ca Sáng" FontWeight="Bold" FontSize="13" Foreground="#D69E2E"/>
                            <TextBlock Text="Thời gian trực:" FontSize="11" Foreground="#718096" Margin="0,6,0,0"/>
                            <TextBlock x:Name="TxtShiftDuration" Text="06:00 -> 14:00" FontWeight="SemiBold" FontSize="12" Foreground="#2D3748"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Bảng đối soát doanh thu -->
                <Border Background="White" CornerRadius="8" Padding="15" BorderBrush="#E2E8F0" BorderThickness="1" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="BẢNG ĐỐI SOÁT DOANH THU &amp; TIỀN MẶT LÝ THUYẾT" FontWeight="Bold" FontSize="12" Foreground="#2D3748" Margin="0,0,0,10"/>

                        <DockPanel Margin="0,0,0,6">
                            <TextBlock Text="1. Tiền lẻ bàn giao đầu ca:" FontSize="12" Foreground="#4A5568"/>
                            <TextBlock x:Name="TxtOpeningCash" Text="1,000,000 đ" FontWeight="SemiBold" FontSize="12" HorizontalAlignment="Right"/>
                        </DockPanel>

                        <DockPanel Margin="0,0,0,6">
                            <TextBlock Text="2. Doanh thu Tiền mặt trong ca (+):" FontSize="12" Foreground="#4A5568"/>
                            <TextBlock x:Name="TxtCashSales" Text="2,450,000 đ" FontWeight="Bold" FontSize="12" Foreground="#27AE60" HorizontalAlignment="Right"/>
                        </DockPanel>

                        <DockPanel Margin="0,0,0,6">
                            <TextBlock Text="3. Doanh thu Chuyển khoản VietQR:" FontSize="12" Foreground="#718096"/>
                            <TextBlock x:Name="TxtVietQrSales" Text="1,850,000 đ" FontWeight="SemiBold" FontSize="12" Foreground="#3182CE" HorizontalAlignment="Right"/>
                        </DockPanel>

                        <DockPanel Margin="0,0,0,8">
                            <TextBlock Text="4. Tổng số đơn hàng hoàn thành:" FontSize="12" Foreground="#718096"/>
                            <TextBlock x:Name="TxtTotalOrders" Text="42 đơn" FontWeight="SemiBold" FontSize="12" HorizontalAlignment="Right"/>
                        </DockPanel>

                        <Separator Background="#E2E8F0" Margin="0,0,0,8"/>

                        <!-- Tiền lý thuyết trong két -->
                        <Border Background="#EBF8FF" CornerRadius="6" Padding="10" BorderBrush="#BEE3F8" BorderThickness="1">
                            <DockPanel>
                                <TextBlock Text="TIỀN MẶT LÝ THUYẾT TRONG KÉT (1 + 2):" FontWeight="Bold" FontSize="12" Foreground="#2B6CB0" VerticalAlignment="Center"/>
                                <TextBlock x:Name="TxtExpectedCash" Text="3,450,000 đ" FontWeight="Bold" FontSize="14" Foreground="#2B6CB0" HorizontalAlignment="Right"/>
                            </DockPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Nhập tiền mặt thực tế & tính chênh lệch -->
                <Border Background="White" CornerRadius="8" Padding="15" BorderBrush="#E2E8F0" BorderThickness="1" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="KIỂM ĐẾM TIỀN MẶT THỰC TẾ CUỐI CA (*):" FontWeight="Bold" FontSize="12" Foreground="#2D3748" Margin="0,0,0,4"/>
                        <TextBlock Text="Thu ngân đếm toàn bộ tiền mặt có trong két (bao gồm tiền lẻ) và nhập vào đây:" FontSize="11" Foreground="#718096" Margin="0,0,0,8"/>

                        <TextBox x:Name="TxtActualCash" Height="40" Padding="10,0" VerticalContentAlignment="Center"
                                 FontSize="16" FontWeight="Bold" Foreground="#2D3748" BorderBrush="#3182CE" BorderThickness="2"
                                 TextChanged="TxtActualCash_TextChanged" Margin="0,0,0,8"/>

                        <!-- Thông báo chênh lệch -->
                        <Border x:Name="BorderDifference" Background="#F0FFF4" CornerRadius="6" Padding="10" BorderBrush="#C6F6D5" BorderThickness="1">
                            <DockPanel>
                                <TextBlock Text="Kết quả kiểm quỹ:" FontSize="12" FontWeight="SemiBold" Foreground="#2D3748" VerticalAlignment="Center"/>
                                <TextBlock x:Name="TxtDifference" Text="✅ Khớp tiền (Chênh lệch: 0 đ)" FontWeight="Bold" FontSize="13" Foreground="#27AE60" HorizontalAlignment="Right"/>
                            </DockPanel>
                        </Border>

                        <!-- Ghi chú giải trình -->
                        <TextBlock Text="Ghi chú bàn giao / Giải trình chênh lệch:" FontWeight="SemiBold" FontSize="12" Foreground="#2D3748" Margin="0,10,0,4"/>
                        <TextBox x:Name="TxtNotes" Height="38" Padding="8,0" VerticalContentAlignment="Center"
                                 FontSize="12" BorderBrush="#CBD5E0" Text="Bàn giao quỹ tiền mặt đầy đủ cho ca sau"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Nút thao tác -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Quay lại" Click="Cancel_Click" Width="100" Height="40" Background="#A0AEC0" Foreground="White"
                    FontWeight="SemiBold" FontSize="13" BorderThickness="0" Margin="0,0,10,0" Cursor="Hand">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="6"/>
                    </Style>
                </Button.Resources>
            </Button>

            <Button Content="🔒 Xác Nhận Kết Ca &amp; Xuất Z-Report" Click="CloseShift_Click" Width="250" Height="40" Background="#DD6B20" Foreground="White"
                    FontWeight="Bold" FontSize="13" BorderThickness="0" Cursor="Hand">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="6"/>
                    </Style>
                </Button.Resources>
            </Button>
        </StackPanel>
    </Grid>
</Window>
