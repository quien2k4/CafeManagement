<Window x:Class="CafeManagement.Wpf.Views.ConfirmImportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Xác Nhận Thông Tin Nhập Kho" 
        Height="420" Width="480"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F8F9FA"
        FontFamily="Segoe UI">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#2C3E50" CornerRadius="10" Padding="15" Margin="0,0,0,15">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="⚠️" FontSize="22" VerticalAlignment="Center" Margin="0,0,12,0"/>
                <StackPanel>
                    <TextBlock Text="XÁC NHẬN NHẬP KHO NGUYÊN LIỆU" FontWeight="Bold" FontSize="15" Foreground="White"/>
                    <TextBlock Text="Vui lòng kiểm tra kỹ tên nguyên liệu và số lượng trước khi lưu" FontSize="11" Foreground="#BDC3C7" Margin="0,2,0,0"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Khung chi tiết xác nhận (In đậm Tên món và Số lượng) -->
        <Border Grid.Row="1" Background="White" CornerRadius="10" Padding="20" BorderBrush="#E9ECEF" BorderThickness="1">
            <StackPanel VerticalAlignment="Center">
                <!-- Tên nguyên liệu -->
                <TextBlock Text="TÊN NGUYÊN VẬT LIỆU:" FontSize="12" Foreground="#7F8C8D" FontWeight="SemiBold"/>
                <TextBlock Name="TxtIngredientName" Text="Cà Phê Hạt Robusta" FontSize="20" FontWeight="Bold" Foreground="#2C3E50" Margin="0,4,0,16"/>

                <!-- Số lượng thực nhập -->
                <TextBlock Text="TỔNG SỐ LƯỢNG THỰC NHẬP:" FontSize="12" Foreground="#7F8C8D" FontWeight="SemiBold"/>
                <DockPanel Margin="0,4,0,16">
                    <TextBlock Name="TxtQuantity" Text="+7,920.0" FontSize="28" FontWeight="Bold" Foreground="#27AE60" VerticalAlignment="Center"/>
                    <TextBlock Name="TxtUom" Text="ml" FontSize="18" FontWeight="Bold" Foreground="#27AE60" VerticalAlignment="Bottom" Margin="8,0,0,4"/>
                </DockPanel>

                <!-- Quy cách tính toán (nếu có phép nhân) -->
                <Border Name="PnlFormula" Background="#F8F9FA" CornerRadius="6" Padding="10,8" Margin="0,0,0,14" BorderBrush="#EEEEEE" BorderThickness="1">
                    <DockPanel>
                        <TextBlock Text="📐 Quy cách đóng gói:" FontSize="12" Foreground="#7F8C8D" FontWeight="SemiBold"/>
                        <TextBlock Name="TxtFormula" Text="330 * 24" FontSize="13" FontWeight="Bold" Foreground="#E65100" HorizontalAlignment="Right"/>
                    </DockPanel>
                </Border>

                <!-- Ghi chú nhập hàng -->
                <TextBlock Text="Ghi chú:" FontSize="12" Foreground="#7F8C8D" FontWeight="SemiBold"/>
                <TextBlock Name="TxtNote" Text="Nhập hàng từ Nhà Cung Cấp" FontSize="13" Foreground="#495057" FontStyle="Italic" Margin="0,3,0,0" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <!-- Footer: Nút bấm xác nhận hoặc quay lại -->
        <Grid Grid.Row="2" Margin="0,15,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="130" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0" Content="Quay lại sửa" Click="Cancel_Click" IsCancel="True" Height="44" Margin="0,0,10,0" Background="#EDF2F7" Foreground="#4A5568" FontWeight="Bold" BorderThickness="0" Cursor="Hand">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="6"/>
                    </Style>
                </Button.Resources>
            </Button>
            <Button Grid.Column="1" Content="✓ CHẮC CHẮN NHẬP KHO" Click="Confirm_Click" IsDefault="True" Height="44" Background="#27AE60" Foreground="White" FontWeight="Bold" FontSize="14" BorderThickness="0" Cursor="Hand">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="6"/>
                    </Style>
                </Button.Resources>
            </Button>
        </Grid>
    </Grid>
</Window>
