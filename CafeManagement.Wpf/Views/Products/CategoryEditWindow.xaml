<Window x:Class="CafeManagement.Wpf.Views.Products.CategoryEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Thêm / Chỉnh Sửa Danh Mục Món" 
        Height="420" Width="460"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F8F9FA"
        FontFamily="Segoe UI">

    <Grid Margin="25,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="White" CornerRadius="10" Padding="15" Margin="0,0,0,15" BorderBrush="#E9ECEF" BorderThickness="1">
            <StackPanel>
                <TextBlock Name="TxtTitle" Text="📁 DANH MỤC MÓN ĐỒ UỐNG" FontWeight="Bold" FontSize="16" Foreground="#2C3E50"/>
                <TextBlock Text="Cấu hình nhóm phân loại đồ uống cho toàn chuỗi quán" FontSize="12" Foreground="#7F8C8D" Margin="0,3,0,0"/>
            </StackPanel>
        </Border>

        <!-- Body Form -->
        <Border Grid.Row="1" Background="White" CornerRadius="10" Padding="20" BorderBrush="#E9ECEF" BorderThickness="1">
            <StackPanel>
                <!-- Mã danh mục -->
                <TextBlock Text="1. Mã danh mục (In hoa, không dấu):" FontWeight="Bold" FontSize="13" Foreground="#495057" Margin="0,0,0,6"/>
                <TextBox Name="TxtCategoryCode" Text="CAT_MOI" Height="38" FontSize="14" FontWeight="Bold" Padding="8,0" VerticalContentAlignment="Center" Margin="0,0,0,14"/>

                <!-- Tên danh mục -->
                <TextBlock Text="2. Tên nhóm danh mục:" FontWeight="Bold" FontSize="13" Foreground="#495057" Margin="0,0,0,6"/>
                <TextBox Name="TxtCategoryName" Text="" Height="38" FontSize="14" FontWeight="Bold" Padding="8,0" VerticalContentAlignment="Center" Margin="0,0,0,14"/>

                <!-- Thứ tự hiển thị -->
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,10,0">
                        <TextBlock Text="3. Thứ tự hiển thị:" FontWeight="Bold" FontSize="13" Foreground="#495057" Margin="0,0,0,6"/>
                        <TextBox Name="TxtDisplayOrder" Text="1" Height="38" FontSize="14" Padding="8,0" VerticalContentAlignment="Center"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,18,0,0">
                        <CheckBox Name="ChkIsActive" Content="Đang kích hoạt" IsChecked="True" FontSize="13" FontWeight="SemiBold" Foreground="#2C3E50"/>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

        <!-- Footer Buttons -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button Content="Hủy" Click="Cancel_Click" Width="100" Height="40" Background="#95A5A6" Foreground="White" FontWeight="Bold" FontSize="13" Cursor="Hand" Margin="0,0,10,0" BorderThickness="0">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="8"/>
                    </Style>
                </Button.Resources>
            </Button>

            <Button Name="BtnSave" Content="💾 Lưu Danh Mục" Click="Save_Click" Width="160" Height="40" Background="#27AE60" Foreground="White" FontWeight="Bold" FontSize="13" Cursor="Hand" BorderThickness="0">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="8"/>
                    </Style>
                </Button.Resources>
            </Button>
        </StackPanel>
    </Grid>
</Window>
