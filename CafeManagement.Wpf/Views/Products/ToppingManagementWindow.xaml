<Window x:Class="CafeManagement.Wpf.Views.Products.ToppingManagementWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Quản Lý Topping &amp; Định Mức Công Thức (BOM)" 
        Height="650" Width="920"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F8F9FA"
        FontFamily="Segoe UI">

    <Grid Margin="20,15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="White" CornerRadius="10" Padding="15" Margin="0,0,0,12" BorderBrush="#E9ECEF" BorderThickness="1">
            <DockPanel>
                <StackPanel DockPanel.Dock="Left">
                    <TextBlock Text="🧋 QUẢN LÝ TOPPING &amp; ĐỊNH MỨC NGUYÊN LIỆU (BOM)" FontWeight="Bold" FontSize="16" Foreground="#2C3E50"/>
                    <TextBlock Text="Cấu hình danh sách Topping, giá phụ thu và công thức tiêu hao nguyên liệu kho khi khách gọi thêm" FontSize="12" Foreground="#7F8C8D" Margin="0,3,0,0"/>
                </StackPanel>
                <Button DockPanel.Dock="Right" Content="➕ Tạo Topping Mới" Click="CreateNewTopping_Click"
                        Background="#E67E22" Foreground="White" FontWeight="Bold" FontSize="13"
                        Padding="14,8" Cursor="Hand" BorderThickness="0" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="8"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </DockPanel>
        </Border>

        <!-- Body: 2 Cột (Trái: Danh sách Topping; Phải: Chi tiết & Cài đặt BOM) -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="340" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- CỘT TRÁI: DANH SÁCH TOPPING -->
            <Border Grid.Column="0" Background="White" CornerRadius="10" Padding="12" Margin="0,0,12,0" BorderBrush="#E9ECEF" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" Margin="4,0,4,10">
                        <TextBlock Text="📋 Danh mục Topping:" FontWeight="Bold" FontSize="13" Foreground="#2C3E50"/>
                        <TextBlock Name="TxtToppingCount" Text="(0 topping)" FontSize="12" Foreground="#7F8C8D" HorizontalAlignment="Right"/>
                    </DockPanel>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ListBox Name="LstToppings" SelectionChanged="LstToppings_SelectionChanged" BorderThickness="0" Background="Transparent"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="Margin" Value="0,0,0,8"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border Name="ItemBorder" Background="#F8F9FA" CornerRadius="8" Padding="12,10" BorderBrush="#EEEEEE" BorderThickness="1" Cursor="Hand">
                                                    <ContentPresenter />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="ItemBorder" Property="Background" Value="#FFF3E0"/>
                                                        <Setter TargetName="ItemBorder" Property="BorderBrush" Value="#FFA726"/>
                                                        <Setter TargetName="ItemBorder" Property="BorderThickness" Value="2"/>
                                                    </Trigger>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="ItemBorder" Property="Background" Value="#F1F3F5"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="{Binding ToppingName}" FontWeight="Bold" FontSize="13" Foreground="#2C3E50"/>
                                            <TextBlock Text="{Binding ToppingCode, StringFormat='Mã: {0}'}" FontSize="11" Foreground="#7F8C8D" Margin="0,2,0,0"/>
                                            <TextBlock Text="{Binding RecipeDetails.Count, StringFormat='{}🧪 Định mức: {0} nguyên liệu'}" FontSize="11" Foreground="#16A085" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right">
                                            <TextBlock Text="{Binding Price, StringFormat='+{0:N0} đ'}" FontWeight="Bold" FontSize="13" Foreground="#E67E22" HorizontalAlignment="Right"/>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- CỘT PHẢI: FORM CHỈNH SỬA TOPPING & BẢNG BOM -->
            <Border Grid.Column="1" Background="White" CornerRadius="10" Padding="16" BorderBrush="#E9ECEF" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" /> <!-- Tiêu đề form -->
                        <RowDefinition Height="Auto" /> <!-- Thông tin cơ bản: Mã, Tên, Giá, Trạng thái -->
                        <RowDefinition Height="*" />    <!-- Danh sách nguyên liệu tiêu hao -->
                        <RowDefinition Height="Auto" /> <!-- Form thêm nguyên liệu vào BOM -->
                        <RowDefinition Height="Auto" /> <!-- Nút Lưu -->
                    </Grid.RowDefinitions>

                    <!-- Tiêu đề form -->
                    <Border Grid.Row="0" Background="#F8F9FA" CornerRadius="6" Padding="10,8" Margin="0,0,0,12">
                        <TextBlock Name="TxtFormTitle" Text="⚙️ THIẾT LẬP TOPPING MỚI" FontWeight="Bold" FontSize="14" Foreground="#2C3E50"/>
                    </Border>

                    <!-- Thông tin cơ bản -->
                    <Grid Grid.Row="1" Margin="0,0,0,12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="140" />
                            <ColumnDefinition Width="100" />
                        </Grid.ColumnDefinitions>

                        <!-- Mã Topping -->
                        <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,8,0">
                            <TextBlock Text="Mã Topping:" FontWeight="Bold" FontSize="12" Foreground="#495057" Margin="0,0,0,4"/>
                            <TextBox Name="TxtToppingCode" Text="TOP_MOI" Height="34" FontSize="13" FontWeight="Bold" Padding="6,0" VerticalContentAlignment="Center"/>
                        </StackPanel>

                        <!-- Tên Topping -->
                        <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,8,0">
                            <TextBlock Text="Tên Topping:" FontWeight="Bold" FontSize="12" Foreground="#495057" Margin="0,0,0,4"/>
                            <TextBox Name="TxtToppingName" Text="" Height="34" FontSize="13" FontWeight="Bold" Padding="6,0" VerticalContentAlignment="Center"/>
                        </StackPanel>

                        <!-- Giá phụ thu -->
                        <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,8,0">
                            <TextBlock Text="Giá phụ thu (đ):" FontWeight="Bold" FontSize="12" Foreground="#495057" Margin="0,0,0,4"/>
                            <TextBox Name="TxtPrice" Text="5000" Height="34" FontSize="13" FontWeight="Bold" Foreground="#E65100" Padding="6,0" VerticalContentAlignment="Center"/>
                        </StackPanel>

                        <!-- Trạng thái -->
                        <StackPanel Grid.Row="0" Grid.Column="3" VerticalAlignment="Center" Margin="0,16,0,0">
                            <CheckBox Name="ChkToppingActive" Content="Kích hoạt" IsChecked="True" FontSize="12" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Grid>

                    <!-- Danh sách nguyên liệu trong công thức BOM -->
                    <Border Grid.Row="2" Background="#FCFDFD" CornerRadius="8" Padding="12" Margin="0,0,0,10" BorderBrush="#E9ECEF" BorderThickness="1">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <DockPanel Grid.Row="0" Margin="0,0,0,8">
                                <TextBlock Text="🧪 Định mức nguyên liệu tiêu hao cho 1 phần Topping:" FontWeight="Bold" FontSize="12" Foreground="#2C3E50"/>
                                <TextBlock Name="TxtBOMCount" Text="(0 nguyên liệu)" FontSize="11" Foreground="#7F8C8D" HorizontalAlignment="Right"/>
                            </DockPanel>

                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                <ItemsControl Name="LstBOMItems">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Margin="0,0,0,6" Padding="10,6" Background="White" CornerRadius="6" BorderBrush="#E2E8F0" BorderThickness="1">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="35" />
                                                    </Grid.ColumnDefinitions>

                                                    <TextBlock Grid.Column="0" Text="{Binding IngredientName}" FontWeight="Bold" FontSize="13" Foreground="#2C3E50" VerticalAlignment="Center"/>

                                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0">
                                                        <TextBlock Text="{Binding Quantity, StringFormat='{}{0:N1}'}" FontWeight="Bold" FontSize="13" Foreground="#E65100"/>
                                                        <TextBlock Text="{Binding Uom}" FontSize="12" Foreground="#7F8C8D" Margin="3,0,0,0" VerticalAlignment="Bottom"/>
                                                    </StackPanel>

                                                    <Button Grid.Column="2" Content="✕" Click="DeleteBOMItem_Click" Tag="{Binding}"
                                                            Background="#FFEBEE" Foreground="#D32F2F" FontWeight="Bold" FontSize="12"
                                                            Width="24" Height="24" Cursor="Hand" BorderThickness="0">
                                                        <Button.Resources>
                                                            <Style TargetType="Border">
                                                                <Setter Property="CornerRadius" Value="4"/>
                                                            </Style>
                                                        </Button.Resources>
                                                    </Button>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </Border>

                    <!-- Form thêm nguyên liệu vào công thức -->
                    <Border Grid.Row="3" Background="#F1F5F9" CornerRadius="8" Padding="10" Margin="0,0,0,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="90" />
                                <ColumnDefinition Width="60" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <ComboBox Name="CboIngredient" Grid.Column="0" Height="34" FontSize="13" VerticalContentAlignment="Center" Margin="0,0,6,0" DisplayMemberPath="IngredientName"/>
                            <TextBox Name="TxtIngredientQuantity" Grid.Column="1" Height="34" FontSize="13" FontWeight="Bold" VerticalContentAlignment="Center" Margin="0,0,6,0" Padding="6,0" Text="30"/>
                            <TextBox Name="TxtIngredientUom" Grid.Column="2" Height="34" FontSize="13" VerticalContentAlignment="Center" Margin="0,0,8,0" Padding="6,0" Text="g" IsReadOnly="True" Background="#E2E8F0"/>

                            <Button Grid.Column="3" Content="➕ Thêm vào BOM" Click="AddBOMItem_Click"
                                    Background="#0284C7" Foreground="White" FontWeight="Bold" FontSize="12"
                                    Padding="12,0" Height="34" Cursor="Hand" BorderThickness="0">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="6"/>
                                    </Style>
                                </Button.Resources>
                            </Button>
                        </Grid>
                    </Border>

                    <!-- Footer: Nút lưu -->
                    <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Đóng" Click="Close_Click" Width="90" Height="38" Background="#94A3B8" Foreground="White" FontWeight="Bold" FontSize="13" Cursor="Hand" Margin="0,0,10,0" BorderThickness="0">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="8"/>
                                </Style>
                            </Button.Resources>
                        </Button>

                        <Button Name="BtnSaveTopping" Content="💾 Lưu Topping &amp; Công Thức" Click="SaveTopping_Click" Width="220" Height="38" Background="#16A34A" Foreground="White" FontWeight="Bold" FontSize="13" Cursor="Hand" BorderThickness="0">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="8"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
