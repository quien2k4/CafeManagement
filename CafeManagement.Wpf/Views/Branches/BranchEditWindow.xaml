<Window x:Class="CafeManagement.Wpf.Views.Branches.BranchEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Thêm Mới Chi Nhánh Chuỗi" 
        Height="580" Width="540"
        MinHeight="520" MinWidth="480"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        Background="#F8F9FA"
        FontFamily="Segoe UI">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /> <!-- Header -->
            <RowDefinition Height="*" />    <!-- Form content with ScrollViewer -->
            <RowDefinition Height="Auto" /> <!-- Footer buttons -->
        </Grid.RowDefinitions>

        <!-- 1. Header -->
        <Border Grid.Row="0" Background="White" CornerRadius="10" Padding="15,12" Margin="0,0,0,12" BorderBrush="#E9ECEF" BorderThickness="1">
            <StackPanel>
                <TextBlock Name="TxtHeaderTitle" Text="🏢 THÊM MỚI CHI NHÁNH CHUỖI" FontWeight="Bold" FontSize="16" Foreground="#2C3E50"/>
                <TextBlock Text="Điền thông tin định danh và địa chỉ điểm kinh doanh mới." FontSize="12" Foreground="#7F8C8D" Margin="0,3,0,0"/>
            </StackPanel>
        </Border>

        <!-- 2. Form nhập liệu có ScrollViewer chống tràn màn hình -->
        <Border Grid.Row="1" Background="White" CornerRadius="10" Padding="16,14" BorderBrush="#E9ECEF" BorderThickness="1">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="0,0,6,0">
                    <!-- 1. Mã chi nhánh -->
                    <TextBlock Text="1. Mã chi nhánh (VD: BR03, BR_Q7):" FontWeight="SemiBold" FontSize="13" Foreground="#374151" Margin="0,0,0,5"/>
                    <TextBox Name="TxtBranchCode" Height="38" FontSize="14" FontWeight="Bold" Padding="10,0" VerticalContentAlignment="Center" 
                             BorderBrush="#CBD5E1" Margin="0,0,0,14" CharacterCasing="Upper"/>

                    <!-- 2. Tên chi nhánh -->
                    <TextBlock Text="2. Tên chi nhánh (VD: Chi nhánh Quận 7 - Phú Mỹ Hưng):" FontWeight="SemiBold" FontSize="13" Foreground="#374151" Margin="0,0,0,5"/>
                    <TextBox Name="TxtBranchName" Height="38" FontSize="14" Padding="10,0" VerticalContentAlignment="Center" 
                             BorderBrush="#CBD5E1" Margin="0,0,0,14"/>

                    <!-- 3. Địa chỉ cơ sở -->
                    <TextBlock Text="3. Địa chỉ cơ sở:" FontWeight="SemiBold" FontSize="13" Foreground="#374151" Margin="0,0,0,5"/>
                    <TextBox Name="TxtAddress" Height="55" FontSize="13" Padding="10,8" TextWrapping="Wrap" AcceptsReturn="True"
                             BorderBrush="#CBD5E1" Margin="0,0,0,14"/>

                    <!-- 4. Số điện thoại / Hotline -->
                    <TextBlock Text="4. Số điện thoại / Hotline:" FontWeight="SemiBold" FontSize="13" Foreground="#374151" Margin="0,0,0,5"/>
                    <TextBox Name="TxtPhone" Height="38" FontSize="14" Padding="10,0" VerticalContentAlignment="Center" 
                             BorderBrush="#CBD5E1" Margin="0,0,0,8"/>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- 3. Footer Buttons -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="Hủy bỏ" Click="BtnCancel_Click" 
                    Background="#E2E8F0" Foreground="#475569" FontWeight="SemiBold" FontSize="13" Padding="18,10" Margin="0,0,10,0" BorderThickness="0" Cursor="Hand">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="8"/>
                    </Style>
                </Button.Resources>
            </Button>

            <Button Name="BtnSave" Content="💾 Lưu Chi Nhánh" Click="BtnSave_Click" 
                    Background="#16A34A" Foreground="White" FontWeight="Bold" FontSize="13" Padding="24,10" BorderThickness="0" Cursor="Hand">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="8"/>
                    </Style>
                </Button.Resources>
            </Button>
        </StackPanel>
    </Grid>
</Window>
