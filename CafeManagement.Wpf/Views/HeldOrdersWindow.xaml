<Window x:Class="CafeManagement.Wpf.Views.HeldOrdersWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Danh Sách Đơn Hàng Tạm Giữ" 
        Height="500" Width="680"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F8F9FA"
        FontFamily="Segoe UI">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,15">
            <TextBlock Text="📋 CÁC ĐƠN HÀNG ĐANG TẠM GIỮ" FontWeight="Bold" FontSize="16" Foreground="#2C3E50"/>
            <TextBlock Text="Bấm 'Mở lại' để tiếp tục bán hàng" HorizontalAlignment="Right" FontSize="12" Foreground="#7F8C8D"/>
        </DockPanel>

        <!-- Danh sách đơn tạm giữ -->
        <ListView Grid.Row="1" ItemsSource="{Binding HeldOrders}" SelectedItem="{Binding SelectedHeldOrder}" Background="White" BorderBrush="#E9ECEF">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Border Padding="12" Margin="0,4" Background="#F8F9FA" CornerRadius="8" BorderBrush="#EEEEEE" BorderThickness="1">
                        <Grid Width="600">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="130" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="120" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{Binding OrderNumber}" FontWeight="Bold" FontSize="13" Foreground="#2980B9"/>
                                <TextBlock Text="{Binding HeldAt, StringFormat='{}{0:HH:mm:ss}'}" FontSize="11" Foreground="#7F8C8D"/>
                            </StackPanel>

                            <TextBlock Grid.Column="1" Text="{Binding Summary}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="5,0"/>

                            <TextBlock Grid.Column="2" Text="{Binding TotalAmount, StringFormat='{}{0:N0} đ'}" 
                                       FontWeight="Bold" FontSize="14" Foreground="#E65100" VerticalAlignment="Center" HorizontalAlignment="Right"/>

                            <StackPanel Grid.Column="3" Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Content="Mở lại" Click="Restore_Click" Tag="{Binding}" Background="#27AE60" Foreground="White" FontWeight="Bold" Padding="8,4" Margin="0,0,5,0" BorderThickness="0" Cursor="Hand"/>
                                <Button Content="Xóa" Click="Delete_Click" Tag="{Binding}" Background="#E74C3C" Foreground="White" FontWeight="Bold" Padding="8,4" BorderThickness="0" Cursor="Hand"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <Button Grid.Row="2" Content="Đóng" Click="Close_Click" Width="100" Height="40" HorizontalAlignment="Right" Margin="0,15,0,0" Background="#EDF2F7" FontWeight="Bold" BorderThickness="0" Cursor="Hand"/>
    </Grid>
</Window>
