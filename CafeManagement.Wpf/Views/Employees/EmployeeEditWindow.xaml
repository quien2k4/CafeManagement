<Window x:Class="CafeManagement.Wpf.Views.Employees.EmployeeEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Hồ Sơ Nhân Viên &amp; Phân Quyền" Height="640" Width="520"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="#F8F9FA" FontFamily="Segoe UI">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Tiêu đề -->
        <Border Grid.Row="0" Background="#2B2B40" CornerRadius="8" Padding="15,12" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock x:Name="TxtTitle" Text="👔 THÔNG TIN NHÂN SỰ &amp; PHÂN QUYỀN" FontWeight="Bold" FontSize="15" Foreground="White"/>
                <TextBlock Text="Quản lý hồ sơ nhân viên, phân quyền chức vụ và gán chi nhánh công tác" FontSize="11" Foreground="#A0AEC0" Margin="0,2,0,0"/>
            </StackPanel>
        </Border>

        <!-- Form nhập thông tin -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- Nhóm 1: Thông tin cá nhân -->
                <Border Background="White" CornerRadius="8" Padding="15" BorderBrush="#E2E8F0" BorderThickness="1" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="1. THÔNG TIN CÁ NHÂN" FontWeight="Bold" FontSize="12" Foreground="#2D3748" Margin="0,0,0,10"/>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="2*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                <TextBlock Text="Mã nhân viên (*):" FontSize="11" FontWeight="SemiBold" Foreground="#4A5568" Margin="0,0,0,4"/>
                                <TextBox x:Name="TxtEmployeeCode" Height="34" Padding="8,0" VerticalContentAlignment="Center" FontSize="12" FontWeight="Bold" BorderBrush="#CBD5E0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Họ và tên (*):" FontSize="11" FontWeight="SemiBold" Foreground="#4A5568" Margin="0,0,0,4"/>
                                <TextBox x:Name="TxtFullName" Height="34" Padding="8,0" VerticalContentAlignment="Center" FontSize="12" BorderBrush="#CBD5E0"/>
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                <TextBlock Text="Số điện thoại (*):" FontSize="11" FontWeight="SemiBold" Foreground="#4A5568" Margin="0,0,0,4"/>
                                <TextBox x:Name="TxtPhone" Height="34" Padding="8,0" VerticalContentAlignment="Center" FontSize="12" BorderBrush="#CBD5E0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Số CCCD / CMND:" FontSize="11" FontWeight="SemiBold" Foreground="#4A5568" Margin="0,0,0,4"/>
                                <TextBox x:Name="TxtCitizenId" Height="34" Padding="8,0" VerticalContentAlignment="Center" FontSize="12" BorderBrush="#CBD5E0"/>
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="Email liên hệ:" FontSize="11" FontWeight="SemiBold" Foreground="#4A5568" Margin="0,0,0,4"/>
                        <TextBox x:Name="TxtEmail" Height="34" Padding="8,0" VerticalContentAlignment="Center" FontSize="12" BorderBrush="#CBD5E0"/>
                    </StackPanel>
                </Border>

                <!-- Nhóm 2: Chức vụ & Chi nhánh -->
                <Border Background="White" CornerRadius="8" Padding="15" BorderBrush="#E2E8F0" BorderThickness="1" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="2. VAI TRÒ &amp; CHI NHÁNH LÀM VIỆC" FontWeight="Bold" FontSize="12" Foreground="#2D3748" Margin="0,0,0,10"/>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                <TextBlock Text="Chức danh / Vai trò (*):" FontSize="11" FontWeight="SemiBold" Foreground="#4A5568" Margin="0,0,0,4"/>
                                <ComboBox x:Name="CboRole" Height="34" FontSize="12" VerticalContentAlignment="Center" DisplayMemberPath="RoleName" SelectedValuePath="RoleId"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Chi nhánh gán làm việc (*):" FontSize="11" FontWeight="SemiBold" Foreground="#4A5568" Margin="0,0,0,4"/>
                                <ComboBox x:Name="CboBranch" Height="34" FontSize="12" VerticalContentAlignment="Center" DisplayMemberPath="BranchName" SelectedValuePath="BranchId"/>
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="Trạng thái làm việc:" FontSize="11" FontWeight="SemiBold" Foreground="#4A5568" Margin="0,0,0,4"/>
                        <ComboBox x:Name="CboStatus" Height="34" FontSize="12" VerticalContentAlignment="Center">
                            <ComboBoxItem Content="✅ Đang làm việc (Active)" Tag="ACTIVE" IsSelected="True"/>
                            <ComboBoxItem Content="⏸ Tạm ngưng / Nghỉ phép (Inactive)" Tag="INACTIVE"/>
                        </ComboBox>
                    </StackPanel>
                </Border>

                <!-- Nhóm 3: Tài khoản đăng nhập hệ thống -->
                <Border Background="White" CornerRadius="8" Padding="15" BorderBrush="#E2E8F0" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="3. TÀI KHOẢN ĐĂNG NHẬP HỆ THỐNG" FontWeight="Bold" FontSize="12" Foreground="#2D3748" Margin="0,0,0,10"/>

                        <TextBlock Text="Tên đăng nhập (Username) (*):" FontSize="11" FontWeight="SemiBold" Foreground="#4A5568" Margin="0,0,0,4"/>
                        <TextBox x:Name="TxtUsername" Height="34" Padding="8,0" VerticalContentAlignment="Center" FontSize="12" FontWeight="Bold" Foreground="#2B6CB0" BorderBrush="#CBD5E0" Margin="0,0,0,8"/>

                        <!-- Mật khẩu -->
                        <CheckBox x:Name="ChkResetPassword" Content="Đặt lại mật khẩu về mặc định (123456)" FontWeight="SemiBold" FontSize="11" Foreground="#D69E2E" Margin="0,4,0,4"/>
                        <TextBlock Text="Mật khẩu khởi tạo ban đầu là '123456'. Nhân viên có thể đổi sau khi đăng nhập." FontSize="10" FontStyle="Italic" Foreground="#718096"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Nút thao tác -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Hủy bỏ" Click="Cancel_Click" Width="100" Height="40" Background="#A0AEC0" Foreground="White"
                    FontWeight="SemiBold" FontSize="13" BorderThickness="0" Margin="0,0,10,0" Cursor="Hand">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="6"/>
                    </Style>
                </Button.Resources>
            </Button>

            <Button Content="💾 Lưu Nhân Viên" Click="Save_Click" Width="160" Height="40" Background="#27AE60" Foreground="White"
                    FontWeight="Bold" FontSize="13" BorderThickness="0" Cursor="Hand">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="6"/>
                    </Style>
                </Button.Resources>
            </Button>
        </StackPanel>
    </Grid>
</Window>
