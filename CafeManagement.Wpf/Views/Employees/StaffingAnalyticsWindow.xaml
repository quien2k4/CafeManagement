<Window x:Class="CafeManagement.Wpf.Views.Employees.StaffingAnalyticsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Phân Tích Lưu Lượng &amp; Hỗ Trợ Quản Lý Nhân Sự" 
        Height="850" Width="1380"
        WindowStartupLocation="CenterScreen"
        Background="#F4F6F9"
        FontFamily="Segoe UI">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- 0: Header -->
            <RowDefinition Height="Auto"/> <!-- 1: Filter & Holiday Bar -->
            <RowDefinition Height="Auto"/> <!-- 2: KPI Cards -->
            <RowDefinition Height="*"/>    <!-- 3: Main Content (Heatmap + Recommendations) -->
            <RowDefinition Height="Auto"/> <!-- 4: Bottom Bar -->
        </Grid.RowDefinitions>

        <!-- ==================== 0. HEADER ==================== -->
        <Border Grid.Row="0" Background="White" CornerRadius="12" Padding="20,16" Margin="0,0,0,15" BorderBrush="#E2E8F0" BorderThickness="1">
            <DockPanel>
                <StackPanel DockPanel.Dock="Left">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="📈" FontSize="22" Margin="0,0,10,0"/>
                        <TextBlock Text="PHÂN TÍCH LƯU LƯỢNG ĐƠN HÀNG &amp; ĐỀ XUẤT NHÂN SỰ THEO CHI NHÁNH" 
                                   FontWeight="Bold" FontSize="18" Foreground="#1A202C"/>
                        <Border Background="#FAF5FF" BorderBrush="#9F7AEA" BorderThickness="1" CornerRadius="6" Padding="8,3" Margin="15,0,0,0">
                            <TextBlock Text="Hỗ Trợ Ra Quyết Định (DSS)" FontWeight="Bold" FontSize="11" Foreground="#6B46C1"/>
                        </Border>
                    </StackPanel>
                    <TextBlock Text="Phân tích lưu lượng khách hàng theo khung giờ thực tế để tối ưu hóa nguồn lực nhân sự, giảm lãng phí chi phí và chuẩn bị cho các dịp Lễ trong năm" 
                               FontSize="12" Foreground="#718096" Margin="32,4,0,0"/>
                </StackPanel>

                <Button DockPanel.Dock="Right" Content="✕ Đóng" Click="CloseButton_Click"
                        Background="#EDF2F7" Foreground="#4A5568" FontWeight="Bold" FontSize="12"
                        Padding="16,8" BorderThickness="0" Cursor="Hand" VerticalAlignment="Center">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="6"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </DockPanel>
        </Border>

        <!-- ==================== 1. FILTER & HOLIDAY BAR ==================== -->
        <Border Grid.Row="1" Background="White" CornerRadius="10" Padding="18,14" Margin="0,0,0,15" BorderBrush="#E2E8F0" BorderThickness="1">
            <StackPanel>
                <DockPanel LastChildFill="True">
                    <!-- Chọn Chi Nhánh -->
                    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,20,0">
                        <TextBlock Text="🏢 Chi nhánh:" FontWeight="SemiBold" FontSize="12" Foreground="#4A5568" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <ComboBox ItemsSource="{Binding Branches}" 
                                  SelectedItem="{Binding SelectedBranch}"
                                  DisplayMemberPath="BranchName"
                                  SelectedValuePath="BranchId"
                                  Width="220" Height="34" FontSize="12" VerticalContentAlignment="Center"
                                  SelectionChanged="BranchComboBox_SelectionChanged"/>
                    </StackPanel>

                    <!-- Khoảng thời gian phân tích -->
                    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,20,0">
                        <TextBlock Text="📅 Khoảng thời gian:" FontWeight="SemiBold" FontSize="12" Foreground="#4A5568" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <Border Background="#F7FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="3">
                            <StackPanel Orientation="Horizontal">
                                <Button Content="7 Ngày" Command="{Binding FilterDaysCommand}" CommandParameter="7"
                                        Padding="10,4" Margin="2,0" FontSize="11" BorderThickness="0" Cursor="Hand">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Background" Value="#EDF2F7"/>
                                            <Setter Property="Foreground" Value="#2D3748"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsDays7}" Value="True">
                                                    <Setter Property="Background" Value="#3182CE"/>
                                                    <Setter Property="Foreground" Value="White"/>
                                                    <Setter Property="FontWeight" Value="Bold"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                                <Button Content="14 Ngày" Command="{Binding FilterDaysCommand}" CommandParameter="14"
                                        Padding="10,4" Margin="2,0" FontSize="11" BorderThickness="0" Cursor="Hand">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Background" Value="#EDF2F7"/>
                                            <Setter Property="Foreground" Value="#2D3748"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsDays14}" Value="True">
                                                    <Setter Property="Background" Value="#3182CE"/>
                                                    <Setter Property="Foreground" Value="White"/>
                                                    <Setter Property="FontWeight" Value="Bold"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                                <Button Content="30 Ngày" Command="{Binding FilterDaysCommand}" CommandParameter="30"
                                        Padding="10,4" Margin="2,0" FontSize="11" BorderThickness="0" Cursor="Hand">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Background" Value="#EDF2F7"/>
                                            <Setter Property="Foreground" Value="#2D3748"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsDays30}" Value="True">
                                                    <Setter Property="Background" Value="#3182CE"/>
                                                    <Setter Property="Foreground" Value="White"/>
                                                    <Setter Property="FontWeight" Value="Bold"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Phân loại Ngày thường vs Cuối tuần -->
                    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,20,0">
                        <TextBlock Text="🗓️ Loại ngày:" FontWeight="SemiBold" FontSize="12" Foreground="#4A5568" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <Border Background="#F7FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="3">
                            <StackPanel Orientation="Horizontal">
                                <Button Content="Tất cả ngày" Command="{Binding FilterDayTypeCommand}" CommandParameter="ALL"
                                        Padding="10,4" Margin="2,0" FontSize="11" BorderThickness="0" Cursor="Hand">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Background" Value="#EDF2F7"/>
                                            <Setter Property="Foreground" Value="#2D3748"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsDayTypeAll}" Value="True">
                                                    <Setter Property="Background" Value="#3182CE"/>
                                                    <Setter Property="Foreground" Value="White"/>
                                                    <Setter Property="FontWeight" Value="Bold"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                                <Button Content="Ngày thường (T2-T6)" Command="{Binding FilterDayTypeCommand}" CommandParameter="WEEKDAY"
                                        Padding="10,4" Margin="2,0" FontSize="11" BorderThickness="0" Cursor="Hand">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Background" Value="#EDF2F7"/>
                                            <Setter Property="Foreground" Value="#2D3748"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsDayTypeWeekday}" Value="True">
                                                    <Setter Property="Background" Value="#3182CE"/>
                                                    <Setter Property="Foreground" Value="White"/>
                                                    <Setter Property="FontWeight" Value="Bold"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                                <Button Content="Cuối tuần (T7-CN)" Command="{Binding FilterDayTypeCommand}" CommandParameter="WEEKEND"
                                        Padding="10,4" Margin="2,0" FontSize="11" BorderThickness="0" Cursor="Hand">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Background" Value="#EDF2F7"/>
                                            <Setter Property="Foreground" Value="#2D3748"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsDayTypeWeekend}" Value="True">
                                                    <Setter Property="Background" Value="#3182CE"/>
                                                    <Setter Property="Foreground" Value="White"/>
                                                    <Setter Property="FontWeight" Value="Bold"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Xem & Kiểm tra Lễ trên Lịch -->
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
                        <TextBlock Text="🎉 Chọn ngày tra Lễ:" FontWeight="SemiBold" FontSize="12" Foreground="#4A5568" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <DatePicker SelectedDate="{Binding SelectedCalendarDate, UpdateSourceTrigger=PropertyChanged}" 
                                    SelectedDateChanged="DatePicker_SelectedDateChanged"
                                    Width="130" Height="34" VerticalContentAlignment="Center"/>
                    </StackPanel>
                </DockPanel>

                <!-- BANNER CẢNH BÁO DỊP LỄ (ĐỔI MÀU ĐẬM TRÊN LỊCH) -->
                <Border Background="#FFF5F5" BorderBrush="{Binding HolidayBadgeColor}" BorderThickness="2" CornerRadius="8" 
                        Padding="14,10" Margin="0,12,0,0"
                        Visibility="{Binding IsHolidaySurge, Converter={StaticResource BoolToVis}}">
                    <DockPanel>
                        <Border Background="{Binding HolidayBadgeColor}" CornerRadius="6" Padding="8,4" VerticalAlignment="Center" Margin="0,0,12,0">
                            <TextBlock Text="🚨 CẢNH BÁO DỊP LỄ (LƯU LƯỢNG ĐỘT BIẾN)" Foreground="White" FontWeight="Bold" FontSize="11"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding HolidayName, StringFormat='Ngày: {0}'}" FontWeight="Bold" FontSize="13" Foreground="#9B2C2C"/>
                            <TextBlock Text="{Binding HolidayDescription}" FontSize="12" Foreground="#742A2A" Margin="0,2,0,0"/>
                        </StackPanel>
                    </DockPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- ==================== 2. KPI SUMMARY CARDS ==================== -->
        <Grid Grid.Row="2" Margin="0,0,0,15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Card 1: Tổng đơn phân tích -->
            <Border Grid.Column="0" Background="White" CornerRadius="10" Padding="16,12" Margin="0,0,8,0" BorderBrush="#E2E8F0" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="📊 TỔNG ĐƠN PHÂN TÍCH" FontSize="11" FontWeight="Bold" Foreground="#718096"/>
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding AnalyticsData.TotalOrdersAnalyzed, StringFormat='{}{0:N0}'}" FontSize="20" FontWeight="Bold" Foreground="#2B6CB0"/>
                        <TextBlock Text=" đơn" FontSize="13" Foreground="#718096" VerticalAlignment="Bottom" Margin="4,0,0,2"/>
                    </StackPanel>
                    <TextBlock Text="{Binding AnalyticsData.TotalRevenueAnalyzed, StringFormat='Doanh thu: {0:N0} đ'}" FontSize="11" Foreground="#4A5568" Margin="0,2,0,0"/>
                </StackPanel>
            </Border>

            <!-- Card 2: Lưu lượng TB Giờ -->
            <Border Grid.Column="1" Background="White" CornerRadius="10" Padding="16,12" Margin="4,0,4,0" BorderBrush="#E2E8F0" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="⏰ LƯU LƯỢNG TRUNG BÌNH GIỜ" FontSize="11" FontWeight="Bold" Foreground="#718096"/>
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding AnalyticsData.OverallAvgOrdersPerHour, StringFormat='{}{0:0.0}'}" FontSize="20" FontWeight="Bold" Foreground="#2D3748"/>
                        <TextBlock Text=" đơn/giờ" FontSize="13" Foreground="#718096" VerticalAlignment="Bottom" Margin="4,0,0,2"/>
                    </StackPanel>
                    <TextBlock Text="Khung hoạt động: 07:00 – 22:00" FontSize="11" Foreground="#718096" Margin="0,2,0,0"/>
                </StackPanel>
            </Border>

            <!-- Card 3: Đỉnh Cao Điểm Nhất -->
            <Border Grid.Column="2" Background="#FFF5F5" CornerRadius="10" Padding="16,12" Margin="4,0,4,0" BorderBrush="#FEB2B2" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="🔥 ĐỈNH CAO ĐIỂM NHẤT" FontSize="11" FontWeight="Bold" Foreground="#C53030"/>
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding AnalyticsData.PeakTimeRange}" FontSize="16" FontWeight="Bold" Foreground="#9B2C2C"/>
                    </StackPanel>
                    <TextBlock Text="{Binding AnalyticsData.PeakAvgOrders, StringFormat='Trung bình: {0:0.0} đơn/giờ'}" FontSize="11" FontWeight="SemiBold" Foreground="#C53030" Margin="0,2,0,0"/>
                </StackPanel>
            </Border>

            <!-- Card 4: Khung Thấp Điểm -->
            <Border Grid.Column="3" Background="#F7FAFC" CornerRadius="10" Padding="16,12" Margin="8,0,0,0" BorderBrush="#E2E8F0" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="💡 KHUNG THẤP ĐIỂM NHẤT" FontSize="11" FontWeight="Bold" Foreground="#4A5568"/>
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding AnalyticsData.OffPeakTimeRange}" FontSize="16" FontWeight="Bold" Foreground="#2D3748"/>
                    </StackPanel>
                    <TextBlock Text="{Binding AnalyticsData.OffPeakAvgOrders, StringFormat='Trung bình: {0:0.0} đơn/giờ'}" FontSize="11" Foreground="#718096" Margin="0,2,0,0"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ==================== 3. MAIN CONTENT ==================== -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.25*"/> <!-- Biểu đồ nhiệt 24 Giờ -->
                <ColumnDefinition Width="0.95*"/> <!-- Danh sách Đề xuất Cố vấn -->
            </Grid.ColumnDefinitions>

            <!-- CỘT TRÁI: BIỂU ĐỒ LƯU LƯỢNG 24 KHUNG GIỜ -->
            <Border Grid.Column="0" Background="White" CornerRadius="10" Padding="18" Margin="0,0,10,0" BorderBrush="#E2E8F0" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Tiêu đề biểu đồ -->
                    <DockPanel Grid.Row="0" Margin="0,0,0,8">
                        <TextBlock Text="📊 Biểu Đồ Lưu Lượng Đơn Hàng Theo 24 Khung Giờ (Heatmap)" 
                                   FontWeight="Bold" FontSize="14" Foreground="#1A202C"/>
                    </DockPanel>

                    <!-- Chú thích màu sắc -->
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,15">
                        <Border Background="#E53E3E" CornerRadius="3" Width="12" Height="12" Margin="0,0,5,0"/>
                        <TextBlock Text="Cao điểm (≥15 đơn/h)" FontSize="11" Foreground="#4A5568" Margin="0,0,15,0"/>

                        <Border Background="#DD6B20" CornerRadius="3" Width="12" Height="12" Margin="0,0,5,0"/>
                        <TextBlock Text="Đông khách (12-15)" FontSize="11" Foreground="#4A5568" Margin="0,0,15,0"/>

                        <Border Background="#3182CE" CornerRadius="3" Width="12" Height="12" Margin="0,0,5,0"/>
                        <TextBlock Text="Bình thường (4-12)" FontSize="11" Foreground="#4A5568" Margin="0,0,15,0"/>

                        <Border Background="#718096" CornerRadius="3" Width="12" Height="12" Margin="0,0,5,0"/>
                        <TextBlock Text="Thấp điểm (&lt;4)" FontSize="11" Foreground="#4A5568"/>
                    </StackPanel>

                    <!-- Các thanh cột 24 Giờ -->
                    <ScrollViewer Grid.Row="2" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding HourlyTraffics}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Width="45" Margin="2,0" Background="Transparent">
                                        <Border.ToolTip>
                                            <ToolTip Background="#1A202C" Foreground="White" BorderThickness="0" Padding="10">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding HourRangeLabel}" FontWeight="Bold" FontSize="12"/>
                                                    <TextBlock Text="{Binding AvgOrdersPerHour, StringFormat='Lưu lượng TB: {0:0.0} đơn/giờ'}" Margin="0,3,0,0"/>
                                                    <TextBlock Text="{Binding AvgCupsPerHour, StringFormat='Sản lượng TB: {0:0.0} ly/giờ'}"/>
                                                    <TextBlock Text="{Binding AvgRevenuePerHour, StringFormat='Doanh thu TB: {0:N0} đ'}"/>
                                                    <Separator Margin="0,6" Background="#4A5568"/>
                                                    <TextBlock Text="{Binding StaffBreakdown, StringFormat='Đề xuất: {0}'}" FontWeight="Bold" Foreground="#68D391"/>
                                                </StackPanel>
                                            </ToolTip>
                                        </Border.ToolTip>
                                        <Grid VerticalAlignment="Bottom">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/> <!-- Số đơn TB -->
                                                <RowDefinition Height="180"/>  <!-- Cột Bar -->
                                                <RowDefinition Height="Auto"/> <!-- Giờ -->
                                                <RowDefinition Height="Auto"/> <!-- Badge Đề xuất nhân sự -->
                                            </Grid.RowDefinitions>

                                            <!-- Số đơn trung bình phía trên cột -->
                                            <TextBlock Grid.Row="0" Text="{Binding AvgOrdersPerHour, StringFormat='{}{0:0}'}" 
                                                       FontSize="10" FontWeight="SemiBold" Foreground="#4A5568" 
                                                       HorizontalAlignment="Center" Margin="0,0,0,4"/>

                                            <!-- Thanh cột biểu đồ -->
                                            <Border Grid.Row="1" VerticalAlignment="Bottom"
                                                    Height="{Binding BarHeight}"
                                                    Background="{Binding HeatColorHex}"
                                                    CornerRadius="4,4,0,0" Width="26"/>

                                            <!-- Nhãn giờ -->
                                            <TextBlock Grid.Row="2" Text="{Binding ShortHourLabel}" 
                                                       FontSize="11" FontWeight="Bold" Foreground="#2D3748" 
                                                       HorizontalAlignment="Center" Margin="0,6,0,4"/>

                                            <!-- Badge số lượng nhân sự đề xuất -->
                                            <Border Grid.Row="3" Background="#EDF2F7" CornerRadius="4" Padding="3,2" HorizontalAlignment="Center">
                                                <TextBlock Text="{Binding RecommendedStaffCount, StringFormat='👤{0}'}" 
                                                           FontSize="10" FontWeight="Bold" Foreground="#2B6CB0"/>
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- CỘT PHẢI: DANH SÁCH KHUYẾN NGHỊ CỐ VẤN THÔNG MINH -->
            <Border Grid.Column="1" Background="White" CornerRadius="10" Padding="18" BorderBrush="#E2E8F0" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0">
                        <TextBlock Text="🎯 Đề Xuất Cố Vấn Bố Trí Nhân Sự" FontWeight="Bold" FontSize="14" Foreground="#1A202C"/>
                    </DockPanel>

                    <TextBlock Grid.Row="1" Text="Đề xuất dừng ở mức khuyến nghị hỗ trợ người quản lý ra quyết định xếp ca tối ưu" 
                               FontSize="11" Foreground="#718096" Margin="0,2,0,12"/>

                    <!-- Danh sách các thẻ đề xuất -->
                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Recommendations}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#F8FAFC" CornerRadius="8" Padding="14" Margin="0,0,0,10" 
                                            BorderBrush="{Binding BadgeColor}" BorderThickness="1.5">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <!-- Dòng 1: Badge loại đề xuất & Khung giờ -->
                                            <DockPanel Grid.Row="0">
                                                <Border DockPanel.Dock="Left" Background="{Binding BadgeColor}" CornerRadius="4" Padding="6,2">
                                                    <TextBlock Text="{Binding RecommendationType}" Foreground="White" FontWeight="Bold" FontSize="10"/>
                                                </Border>
                                                <TextBlock DockPanel.Dock="Right" Text="{Binding TimeRange}" FontWeight="Bold" FontSize="12" Foreground="#2D3748"/>
                                            </DockPanel>

                                            <!-- Dòng 2: Tiêu đề -->
                                            <TextBlock Grid.Row="1" Text="{Binding Title}" FontWeight="Bold" FontSize="13" Foreground="#1A202C" Margin="0,8,0,4"/>

                                            <!-- Dòng 3: Chi tiết đề xuất -->
                                            <TextBlock Grid.Row="2" Text="{Binding ActionDescription}" FontSize="12" Foreground="#4A5568" TextWrapping="Wrap" LineHeight="18"/>

                                            <!-- Dòng 4: Ghi chú ngày lễ (nếu có) -->
                                            <Border Grid.Row="3" Background="#FFF5F5" CornerRadius="4" Padding="6,4" Margin="0,8,0,0"
                                                    Visibility="{Binding HolidayNote, Converter={StaticResource BoolToVis}}">
                                                <TextBlock Text="{Binding HolidayNote}" FontSize="11" Foreground="#C53030" FontWeight="SemiBold"/>
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <!-- ==================== 4. BOTTOM BAR ==================== -->
        <Border Grid.Row="4" Background="White" CornerRadius="10" Padding="16,10" Margin="0,15,0,0" BorderBrush="#E2E8F0" BorderThickness="1">
            <DockPanel>
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="ℹ️ " FontSize="12"/>
                    <TextBlock Text="{Binding StatusMessage}" FontSize="12" Foreground="#4A5568" FontWeight="SemiBold"/>
                </StackPanel>

                <Button DockPanel.Dock="Right" Content="Đóng cửa sổ" Click="CloseButton_Click"
                        Background="#3182CE" Foreground="White" FontWeight="Bold" FontSize="12"
                        Padding="18,8" BorderThickness="0" Cursor="Hand">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="6"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </DockPanel>
        </Border>
    </Grid>
</Window>
