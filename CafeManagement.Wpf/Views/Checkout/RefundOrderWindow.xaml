<Window x:Class="CafeManagement.Wpf.Views.Checkout.RefundOrderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Xử Lý Hoàn Tiền Đơn Hàng" 
        Height="780" Width="620"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F7FAFC"
        FontFamily="Segoe UI">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- 0. Header -->
            <RowDefinition Height="Auto"/> <!-- 1. Thẻ thông tin đơn & tài chính -->
            <RowDefinition Height="*"/>    <!-- 2. Danh sách món đã gọi -->
            <RowDefinition Height="Auto"/> <!-- 3. Form thông tin hoàn tiền & lý do -->
            <RowDefinition Height="Auto"/> <!-- 4. Buttons -->
        </Grid.RowDefinitions>

        <!-- 0. Header -->
        <Border Grid.Row="0" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="↩️ YÊU CẦU HOÀN TIỀN ĐƠN HÀNG" FontWeight="Bold" FontSize="18" Foreground="#2D3748"/>
                <TextBlock Text="Chọn món cần hoàn trả để tự động tính tiền và hoàn nhập kho định lượng chính xác." FontSize="12" Foreground="#718096" Margin="0,3,0,0"/>
            </StackPanel>
        </Border>

        <!-- 1. Thẻ Thông tin Đơn Hàng & Số Tiền -->
        <Border Grid.Row="1" Background="#1A202C" CornerRadius="10" Padding="14" Margin="0,0,0,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Dòng 1: Mã đơn & Thời gian -->
                <DockPanel Grid.Row="0" Margin="0,0,0,10">
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                        <TextBlock Text="Hóa đơn: " Foreground="#A0AEC0" FontSize="12"/>
                        <TextBlock x:Name="TxtOrderNumber" Text="#HD12345" Foreground="#63B3ED" FontWeight="Bold" FontSize="13"/>
                    </StackPanel>
                    <TextBlock x:Name="TxtOrderDate" Text="19/11/2026 14:30" Foreground="#A0AEC0" FontSize="11" HorizontalAlignment="Right" DockPanel.Dock="Right"/>
                </DockPanel>

                <!-- Dòng 2: Tổng tiền, Đã hoàn, Tối đa có thể hoàn -->
                <Border Grid.Row="1" Background="#2D3748" CornerRadius="6" Padding="12,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Tổng hóa đơn" FontSize="10" Foreground="#A0AEC0"/>
                            <TextBlock x:Name="TxtFinalAmount" Text="85.000 đ" FontWeight="Bold" FontSize="13" Foreground="White" Margin="0,2,0,0"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Đã hoàn trước" FontSize="10" Foreground="#A0AEC0"/>
                            <TextBlock x:Name="TxtRefundedAmount" Text="0 đ" FontWeight="Bold" FontSize="13" Foreground="#FC8181" Margin="0,2,0,0"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Tối đa được hoàn" FontSize="10" Foreground="#F6E05E"/>
                            <TextBlock x:Name="TxtMaxRefundable" Text="85.000 đ" FontWeight="Bold" FontSize="14" Foreground="#48BB78" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- 2. Danh Sách Món Đã Gọi Với CheckBox Chọn Từng Món -->
        <Border Grid.Row="2" Background="White" CornerRadius="10" Padding="14" BorderBrush="#E2E8F0" BorderThickness="1" Margin="0,0,0,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0" Margin="0,0,0,8">
                    <TextBlock Text="DANH SÁCH MÓN ĐÃ GỌI (TÍCH CHỌN MÓN CẦN HOÀN):" FontWeight="Bold" FontSize="12" Foreground="#2D3748" DockPanel.Dock="Left" VerticalAlignment="Center"/>
                    <CheckBox x:Name="ChkSelectAll" Content="Chọn tất cả" HorizontalAlignment="Right" DockPanel.Dock="Right"
                              FontSize="11" FontWeight="SemiBold" Foreground="#4A5568" VerticalContentAlignment="Center"
                              Checked="ChkSelectAll_Checked" Unchecked="ChkSelectAll_Unchecked"/>
                </DockPanel>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="ItemsListControl">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,0,6">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected}" VerticalAlignment="Center" Margin="0,0,10,0"
                                                  Click="OnItemSelectionChanged"/>

                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding DisplayTitle}" FontWeight="Bold" FontSize="13" Foreground="#2D3748"/>
                                            <TextBlock Text="{Binding DisplayDetail}" FontSize="11" Foreground="#718096" Margin="0,2,0,0"/>
                                        </StackPanel>

                                        <TextBlock Grid.Column="2" Text="{Binding DisplayLineTotal}" FontWeight="Bold" FontSize="13" Foreground="#E53E3E" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- 3. Form Nhập Dữ Liệu Hoàn Tiền -->
        <Border Grid.Row="3" Background="White" CornerRadius="10" Padding="14" BorderBrush="#E2E8F0" BorderThickness="1" Margin="0,0,0,12">
            <StackPanel>
                <!-- Số tiền hoàn trả -->
                <DockPanel Margin="0,0,0,8">
                    <StackPanel DockPanel.Dock="Left">
                        <TextBlock Text="Số tiền hoàn trả (VNĐ) (*):" FontWeight="Bold" FontSize="12" Foreground="#2D3748"/>
                        <TextBlock Text="Tự động tính theo món được chọn hoặc tự nhập" FontSize="11" Foreground="#718096" Margin="0,1,0,0"/>
                    </StackPanel>
                    <Button DockPanel.Dock="Right" Content="Hoàn tối đa" Click="BtnMaxAmount_Click"
                            Padding="8,3" FontSize="11" FontWeight="SemiBold" Background="#EDF2F7" Foreground="#4A5568" BorderThickness="0" Cursor="Hand" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="4"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                </DockPanel>

                <TextBox x:Name="TxtRefundAmount" Height="36" Padding="10,0" VerticalContentAlignment="Center"
                         FontSize="15" FontWeight="Bold" Foreground="#E53E3E" BorderBrush="#CBD5E0" Margin="0,0,0,10">
                    <TextBox.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="6"/>
                        </Style>
                    </TextBox.Resources>
                </TextBox>

                <!-- Hình thức hoàn tiền & Lý do -->
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,6,0">
                        <TextBlock Text="Hình thức hoàn trả (*):" FontWeight="Bold" FontSize="12" Foreground="#2D3748" Margin="0,0,0,4"/>
                        <ComboBox x:Name="CboRefundMethod" Height="32" FontSize="11" VerticalContentAlignment="Center">
                            <ComboBoxItem Content="💵 Tiền mặt (từ két ca)" Tag="CASH" IsSelected="True"/>
                            <ComboBoxItem Content="📲 Chuyển khoản VietQR" Tag="VIETQR"/>
                            <ComboBoxItem Content="🔄 Phương thức ban đầu" Tag="ORIGINAL"/>
                        </ComboBox>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Margin="6,0,0,0">
                        <TextBlock Text="Lý do mẫu nhanh:" FontWeight="Bold" FontSize="12" Foreground="#2D3748" Margin="0,0,0,4"/>
                        <ComboBox x:Name="CboReasonPreset" Height="32" FontSize="11" VerticalContentAlignment="Center"
                                  SelectionChanged="CboReasonPreset_SelectionChanged">
                            <ComboBoxItem Content="-- Chọn lý do mẫu --" IsSelected="True"/>
                            <ComboBoxItem Content="Khách hủy món / đổi ý"/>
                            <ComboBoxItem Content="Pha chế sai định lượng / món"/>
                            <ComboBoxItem Content="Chất lượng không đạt chuẩn"/>
                            <ComboBoxItem Content="Khách phàn nàn dịch vụ"/>
                            <ComboBoxItem Content="Thu ngân tính nhầm tiền"/>
                            <ComboBoxItem Content="Khác (tự nhập lý do)"/>
                        </ComboBox>
                    </StackPanel>
                </Grid>

                <TextBox x:Name="TxtRefundReason" Height="38" Padding="8,4" TextWrapping="Wrap"
                         FontSize="12" BorderBrush="#CBD5E0" Margin="0,0,0,10" Text="Khách hủy món / đổi ý">
                    <TextBox.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="6"/>
                        </Style>
                    </TextBox.Resources>
                </TextBox>

                <!-- Tùy chọn kho nguyên liệu -->
                <Border Background="#F7FAFC" CornerRadius="6" Padding="10,6" BorderBrush="#E2E8F0" BorderThickness="1">
                    <CheckBox x:Name="ChkRestockInventory" IsChecked="False" VerticalContentAlignment="Center">
                        <StackPanel Margin="6,0,0,0">
                            <TextBlock Text="Hoàn nhập nguyên liệu vào kho" FontWeight="SemiBold" FontSize="12" Foreground="#2D3748"/>
                            <TextBlock Text="Chỉ hoàn lại đúng định lượng của CÁC MÓN ĐÃ TÍCH CHỌN ở trên (chưa qua pha chế)." FontSize="11" Foreground="#718096" Margin="0,2,0,0"/>
                        </StackPanel>
                    </CheckBox>
                </Border>
            </StackPanel>
        </Border>

        <!-- 4. Nút bấm thao tác -->
        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="1.5*"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0" Content="Hủy Bỏ" Click="BtnCancel_Click"
                    Height="40" FontSize="13" FontWeight="SemiBold" Background="#EDF2F7" Foreground="#4A5568" BorderThickness="0" Margin="0,0,8,0" Cursor="Hand">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="8"/>
                    </Style>
                </Button.Resources>
            </Button>

            <Button Grid.Column="1" Content="✓ XÁC NHẬN HOÀN TIỀN" Click="BtnConfirm_Click"
                    Height="40" FontSize="13" FontWeight="Bold" Background="#E53E3E" Foreground="White" BorderThickness="0" Margin="8,0,0,0" Cursor="Hand">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="8"/>
                    </Style>
                </Button.Resources>
            </Button>
        </Grid>
    </Grid>
</Window>