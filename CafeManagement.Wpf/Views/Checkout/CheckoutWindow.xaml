<Window x:Class="CafeManagement.Wpf.Views.Checkout.CheckoutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Thanh Toán Đơn Hàng" 
        Height="630" Width="600"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F4F6F9"
        FontFamily="Segoe UI">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Window.Resources>

    <Grid Margin="25">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /> <!-- Header số tiền -->
            <RowDefinition Height="Auto" /> <!-- Tab chọn Tiền mặt / VietQR -->
            <RowDefinition Height="*" />    <!-- Nội dung tương ứng (Tiền mặt / QR) -->
            <RowDefinition Height="Auto" /> <!-- Nút bấm xác nhận thanh toán -->
        </Grid.RowDefinitions>

        <!-- Header: Số tiền cần thanh toán -->
        <Border Grid.Row="0" Background="#1E1E2D" CornerRadius="12" Padding="20" Margin="0,0,0,15">
            <DockPanel>
                <StackPanel DockPanel.Dock="Left">
                    <TextBlock Text="{Binding OrderNumber, StringFormat='ĐƠN HÀNG: #{0}'}" Foreground="#8A8A9E" FontSize="13" FontWeight="Bold"/>
                    <TextBlock Text="Cần thanh toán:" Foreground="White" FontSize="14" Margin="0,4,0,0"/>
                </StackPanel>
                <TextBlock DockPanel.Dock="Right" Text="{Binding FinalAmount, StringFormat='{}{0:N0} đ'}" 
                           Foreground="#FFA726" FontSize="28" FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Center"/>
            </DockPanel>
        </Border>

        <!-- Tabs: Chọn Tiền mặt hoặc VietQR -->
        <Grid Grid.Row="1" Margin="0,0,0,15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0" Content="💵 TIỀN MẶT" 
                    Command="{Binding SelectCashCommand}" Margin="0,0,6,0"
                    Height="45" FontSize="14" FontWeight="Bold" BorderThickness="0" Cursor="Hand">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Background" Value="#E9ECEF"/>
                        <Setter Property="Foreground" Value="#495057"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsCashMode}" Value="True">
                                <Setter Property="Background" Value="#27AE60"/>
                                <Setter Property="Foreground" Value="White"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>

            <Button Grid.Column="1" Content="📱 CHUYỂN KHOẢN QR" 
                    Command="{Binding SelectQrCommand}" Margin="6,0,0,0"
                    Height="45" FontSize="14" FontWeight="Bold" BorderThickness="0" Cursor="Hand">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Background" Value="#E9ECEF"/>
                        <Setter Property="Foreground" Value="#495057"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsQrMode}" Value="True">
                                <Setter Property="Background" Value="#2980B9"/>
                                <Setter Property="Foreground" Value="White"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
        </Grid>

        <!-- Khung 1: TIỀN MẶT -->
        <Border Grid.Row="2" Background="White" CornerRadius="12" Padding="20" BorderBrush="#E9ECEF" BorderThickness="1"
                Visibility="{Binding IsCashMode, Converter={StaticResource BoolToVis}}">
            <StackPanel>
                <TextBlock Text="Số tiền khách đưa:" FontWeight="Bold" FontSize="14" Foreground="#495057" Margin="0,0,0,8"/>
                <TextBox Text="{Binding CustomerGivenAmount, UpdateSourceTrigger=PropertyChanged}" 
                         Height="48" FontSize="22" FontWeight="Bold" Foreground="#2C3E50" TextAlignment="Right" Padding="10" Background="#F8F9FA" BorderBrush="#CED4DA"/>

                <!-- Gợi ý tiền nhanh -->
                <TextBlock Text="Bấm chọn nhanh số tiền:" FontSize="12" Foreground="#8A8A9E" Margin="0,12,0,8"/>
                <UniformGrid Columns="3" Margin="0,0,0,15">
                    <Button Content="Đúng số tiền" Command="{Binding SetQuickCashCommand}" CommandParameter="0" Height="36" Margin="0,0,6,6" Background="#EDF2F7" FontWeight="SemiBold" BorderThickness="0" Cursor="Hand"/>
                    <Button Content="50.000 đ" Command="{Binding SetQuickCashCommand}" CommandParameter="50000" Height="36" Margin="0,0,6,6" Background="#EDF2F7" FontWeight="SemiBold" BorderThickness="0" Cursor="Hand"/>
                    <Button Content="100.000 đ" Command="{Binding SetQuickCashCommand}" CommandParameter="100000" Height="36" Margin="0,0,0,6" Background="#EDF2F7" FontWeight="SemiBold" BorderThickness="0" Cursor="Hand"/>
                    <Button Content="200.000 đ" Command="{Binding SetQuickCashCommand}" CommandParameter="200000" Height="36" Margin="0,0,6,0" Background="#EDF2F7" FontWeight="SemiBold" BorderThickness="0" Cursor="Hand"/>
                    <Button Content="500.000 đ" Command="{Binding SetQuickCashCommand}" CommandParameter="500000" Height="36" Margin="0,0,6,0" Background="#EDF2F7" FontWeight="SemiBold" BorderThickness="0" Cursor="Hand"/>
                    <Button Content="+10.000 đ" Command="{Binding AddQuickCashCommand}" CommandParameter="10000" Height="36" Margin="0,0,0,0" Background="#EDF2F7" FontWeight="SemiBold" BorderThickness="0" Cursor="Hand"/>
                </UniformGrid>

                <!-- Tiền thối lại cho khách -->
                <Border Background="#E8F8F5" CornerRadius="10" Padding="15">
                    <DockPanel>
                        <TextBlock Text="TIỀN THỐI LẠI:" FontWeight="Bold" FontSize="14" Foreground="#16A085" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding ChangeAmount, StringFormat='{}{0:N0} đ'}" 
                                   FontWeight="Bold" FontSize="22" Foreground="#27AE60" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </DockPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- Khung 2: CHUYỂN KHOẢN VIETQR -->
        <Border Grid.Row="2" Background="White" CornerRadius="12" Padding="20" BorderBrush="#E9ECEF" BorderThickness="1"
                Visibility="{Binding IsQrMode, Converter={StaticResource BoolToVis}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="190" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Mô phỏng QR -->
                <Border Grid.Column="0" Background="#F1F3F5" CornerRadius="10" Padding="10" VerticalAlignment="Center" Height="190">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="📷" FontSize="60" HorizontalAlignment="Center"/>
                        <TextBlock Text="VIETQR ĐỘNG" FontWeight="Bold" FontSize="12" Foreground="#2980B9" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                        <TextBlock Text="Quét qua App Ngân Hàng" FontSize="11" Foreground="#7F8C8D" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- Thông tin tài khoản -->
                <StackPanel Grid.Column="1" Margin="20,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="Ngân hàng:" FontSize="11" Foreground="#7F8C8D"/>
                    <TextBlock Text="{Binding BankName}" FontWeight="Bold" FontSize="14" Foreground="#2C3E50" Margin="0,0,0,8"/>

                    <TextBlock Text="Số tài khoản:" FontSize="11" Foreground="#7F8C8D"/>
                    <TextBlock Text="{Binding AccountNumber}" FontWeight="Bold" FontSize="16" Foreground="#2980B9" Margin="0,0,0,8"/>

                    <TextBlock Text="Chủ tài khoản:" FontSize="11" Foreground="#7F8C8D"/>
                    <TextBlock Text="{Binding AccountHolder}" FontWeight="Bold" FontSize="14" Foreground="#2C3E50" Margin="0,0,0,8"/>

                    <TextBlock Text="Nội dung chuyển khoản:" FontSize="11" Foreground="#7F8C8D"/>
                    <TextBlock Text="{Binding OrderNumber}" FontWeight="Bold" FontSize="15" Foreground="#E65100"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Footer: Các nút bấm -->
        <Grid Grid.Row="3" Margin="0,18,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="120" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0" Content="Quay lại" Click="Cancel_Click" Height="48" Margin="0,0,10,0" Background="#EDF2F7" FontWeight="Bold" BorderThickness="0" Cursor="Hand"/>
            <Button Grid.Column="1" Content="XÁC NHẬN THANH TOÁN &amp; IN BIÊN NHẬN" Click="Confirm_Click" 
                    Height="48" Background="#27AE60" Foreground="White" FontWeight="Bold" FontSize="14" BorderThickness="0" Cursor="Hand"/>
        </Grid>
    </Grid>
</Window>
