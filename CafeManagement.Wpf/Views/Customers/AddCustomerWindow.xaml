<Window x:Class="CafeManagement.Wpf.Views.Customers.AddCustomerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Đăng Ký Thành Viên Mới" Height="420" Width="450"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="#F8F9FA" FontFamily="Segoe UI">
    <Grid Margin="25">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Tiêu đề -->
        <Border Grid.Row="0" Background="White" CornerRadius="8" Padding="15,12" Margin="0,0,0,15" BorderBrush="#E8ECEF" BorderThickness="1">
            <StackPanel>
                <TextBlock Text="👤 ĐĂNG KÝ THÀNH VIÊN KHÁCH HÀNG" FontWeight="Bold" FontSize="16" Foreground="#2C3E50"/>
                <TextBlock Text="Đăng ký thành viên để tích điểm và hưởng ưu đãi chiết khấu" FontSize="11" Foreground="#7F8C8D" Margin="0,3,0,0"/>
            </StackPanel>
        </Border>

        <!-- Form nhập thông tin -->
        <Border Grid.Row="1" Background="White" CornerRadius="8" Padding="20" BorderBrush="#E8ECEF" BorderThickness="1">
            <StackPanel>
                <!-- Số điện thoại -->
                <TextBlock Text="Số điện thoại (*):" FontWeight="SemiBold" FontSize="12" Foreground="#2C3E50" Margin="0,0,0,5"/>
                <TextBox x:Name="TxtPhoneNumber" Height="38" Padding="10,0" VerticalContentAlignment="Center"
                         FontSize="14" FontWeight="Bold" BorderBrush="#BDC3C7" Margin="0,0,0,12"/>

                <!-- Họ và tên -->
                <TextBlock Text="Họ và tên khách hàng (*):" FontWeight="SemiBold" FontSize="12" Foreground="#2C3E50" Margin="0,0,0,5"/>
                <TextBox x:Name="TxtFullName" Height="38" Padding="10,0" VerticalContentAlignment="Center"
                         FontSize="13" BorderBrush="#BDC3C7" Margin="0,0,0,12"/>

                <!-- Hạng thẻ ban đầu -->
                <TextBlock Text="Hạng thành viên ban đầu:" FontWeight="SemiBold" FontSize="12" Foreground="#2C3E50" Margin="0,0,0,5"/>
                <ComboBox x:Name="CboTier" Height="38" FontSize="13" VerticalContentAlignment="Center">
                    <ComboBoxItem Content="🥉 Hạng Đồng (Chuẩn - Mới tạo)" Tag="BRONZE" IsSelected="True"/>
                    <ComboBoxItem Content="🥈 Hạng Bạc (Giảm 5%)" Tag="SILVER"/>
                    <ComboBoxItem Content="🥇 Hạng Vàng (Giảm 10%)" Tag="GOLD"/>
                    <ComboBoxItem Content="💎 Hạng Kim Cương (Giảm 15%)" Tag="DIAMOND"/>
                </ComboBox>
            </StackPanel>
        </Border>

        <!-- Nút thao tác -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button Content="Hủy bỏ" Click="Cancel_Click" Width="100" Height="40" Background="#95A5A6" Foreground="White"
                    FontWeight="SemiBold" FontSize="13" BorderThickness="0" Margin="0,0,10,0" Cursor="Hand">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="6"/>
                    </Style>
                </Button.Resources>
            </Button>

            <Button Content="💾 Lưu &amp; Chọn Khách" Click="Save_Click" Width="170" Height="40" Background="#27AE60" Foreground="White"
                    FontWeight="Bold" FontSize="13" BorderThickness="0" Cursor="Hand">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="6"/>
                    </Style>
                </Button.Resources>
            </Button>
        </StackPanel>
    </Grid>
</Window>