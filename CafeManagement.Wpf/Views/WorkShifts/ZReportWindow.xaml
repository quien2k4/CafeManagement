<Window x:Class="CafeManagement.Wpf.Views.WorkShifts.ZReportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Phiếu Kết Toán Ca Làm Việc (Z-Report)" Height="680" Width="480"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="#555555" FontFamily="Segoe UI">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Bản in Hóa đơn / Z-Report phong cách Receipt cuộn giấy in nhiệt -->
        <Border Grid.Row="0" Background="White" CornerRadius="4" Padding="25" Margin="0,0,0,12">
            <Border.Effect>
                <DropShadowEffect BlurRadius="10" Direction="-90" RenderingBias="Quality" ShadowDepth="2" Opacity="0.3"/>
            </Border.Effect>
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <!-- Header cửa hàng -->
                    <TextBlock Text="☕ CAFE CHAIN SYSTEM" FontWeight="Bold" FontSize="18" HorizontalAlignment="Center" Foreground="#1A202C"/>
                    <TextBlock x:Name="TxtBranchName" Text="Chi nhánh Quận 1 (BR01) - 123 Lê Lợi, Q1" FontSize="11" Foreground="#4A5568" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                    <TextBlock Text="Hotline: 028 3811 1111" FontSize="10" Foreground="#718096" HorizontalAlignment="Center"/>

                    <TextBlock Text="------------------------------------------------------------------" Foreground="#CBD5E0" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                    <TextBlock Text="PHIẾU KẾT TOÁN CA BÁN HÀNG" FontWeight="Bold" FontSize="15" HorizontalAlignment="Center" Foreground="#2B6CB0"/>
                    <TextBlock Text="(BÁO CÁO Z-REPORT)" FontWeight="Bold" FontSize="11" HorizontalAlignment="Center" Foreground="#718096"/>
                    <TextBlock Text="------------------------------------------------------------------" Foreground="#CBD5E0" HorizontalAlignment="Center" Margin="0,0,0,8"/>

                    <!-- Thông tin ca -->
                    <DockPanel Margin="0,0,0,4">
                        <TextBlock Text="Mã ca (Shift ID):" FontSize="11" Foreground="#718096"/>
                        <TextBlock x:Name="TxtShiftCode" Text="CA261117-001" FontWeight="Bold" FontSize="11" HorizontalAlignment="Right"/>
                    </DockPanel>
                    <DockPanel Margin="0,0,0,4">
                        <TextBlock Text="Tên ca trực:" FontSize="11" Foreground="#718096"/>
                        <TextBlock x:Name="TxtShiftName" Text="Ca Sáng (06:00 - 14:00)" FontWeight="SemiBold" FontSize="11" HorizontalAlignment="Right"/>
                    </DockPanel>
                    <DockPanel Margin="0,0,0,4">
                        <TextBlock Text="Thu ngân phụ trách:" FontSize="11" Foreground="#718096"/>
                        <TextBlock x:Name="TxtCashier" Text="Trần Thị Thu Ngân (cashier1)" FontWeight="SemiBold" FontSize="11" HorizontalAlignment="Right"/>
                    </DockPanel>
                    <DockPanel Margin="0,0,0,4">
                        <TextBlock Text="Thời gian mở ca:" FontSize="11" Foreground="#718096"/>
                        <TextBlock x:Name="TxtStartTime" Text="17/11/2026 06:00" FontSize="11" HorizontalAlignment="Right"/>
                    </DockPanel>
                    <DockPanel Margin="0,0,0,4">
                        <TextBlock Text="Thời gian đóng ca:" FontSize="11" Foreground="#718096"/>
                        <TextBlock x:Name="TxtEndTime" Text="17/11/2026 14:05" FontSize="11" HorizontalAlignment="Right"/>
                    </DockPanel>

                    <TextBlock Text="==========================================" Foreground="#CBD5E0" HorizontalAlignment="Center" Margin="0,6,0,6"/>

                    <!-- I. TỔNG KẾT DOANH THU -->
                    <TextBlock Text="I. TỔNG HỢP DOANH THU &amp; ĐƠN HÀNG" FontWeight="Bold" FontSize="12" Foreground="#2D3748" Margin="0,0,0,6"/>

                    <DockPanel Margin="0,0,0,4">
                        <TextBlock Text="• Tổng số đơn hoàn thành:" FontSize="11" Foreground="#4A5568"/>
                        <TextBlock x:Name="TxtTotalOrders" Text="36 đơn" FontWeight="Bold" FontSize="11" HorizontalAlignment="Right"/>
                    </DockPanel>
                    <DockPanel Margin="0,0,0,4">
                        <TextBlock Text="• Doanh thu Tiền mặt (Cash):" FontSize="11" Foreground="#4A5568"/>
                        <TextBlock x:Name="TxtCashSales" Text="2,450,000 đ" FontWeight="SemiBold" FontSize="11" HorizontalAlignment="Right"/>
                    </DockPanel>
                    <DockPanel Margin="0,0,0,4">
                        <TextBlock Text="• Doanh thu VietQR / Chuyển khoản:" FontSize="11" Foreground="#4A5568"/>
                        <TextBlock x:Name="TxtQrSales" Text="1,200,000 đ" FontWeight="SemiBold" FontSize="11" HorizontalAlignment="Right"/>
                    </DockPanel>

                    <Border Background="#F7FAFC" CornerRadius="4" Padding="8,6" Margin="0,6,0,0">
                        <DockPanel>
                            <TextBlock Text="TỔNG DOANH THU CA:" FontWeight="Bold" FontSize="12" Foreground="#1A202C"/>
                            <TextBlock x:Name="TxtTotalSales" Text="3,650,000 đ" FontWeight="Bold" FontSize="13" Foreground="#27AE60" HorizontalAlignment="Right"/>
                        </DockPanel>
                    </Border>

                    <TextBlock Text="==========================================" Foreground="#CBD5E0" HorizontalAlignment="Center" Margin="0,8,0,6"/>

                    <!-- II. ĐỐI SOÁT QUỸ TIỀN MẶT -->
                    <TextBlock Text="II. ĐỐI SOÁT QUỸ TIỀN MẶT (CASH DRAWER)" FontWeight="Bold" FontSize="12" Foreground="#2D3748" Margin="0,0,0,6"/>

                    <DockPanel Margin="0,0,0,4">
                        <TextBlock Text="1. Tiền lẻ bàn giao đầu ca:" FontSize="11" Foreground="#4A5568"/>
                        <TextBlock x:Name="TxtOpeningCash" Text="1,000,000 đ" FontSize="11" HorizontalAlignment="Right"/>
                    </DockPanel>
                    <DockPanel Margin="0,0,0,4">
                        <TextBlock Text="2. Doanh thu tiền mặt trong ca (+):" FontSize="11" Foreground="#4A5568"/>
                        <TextBlock x:Name="TxtCashAdded" Text="2,450,000 đ" FontSize="11" HorizontalAlignment="Right"/>
                    </DockPanel>
                    <DockPanel Margin="0,0,0,4">
                        <TextBlock Text="3. Tiền mặt lý thuyết trong két (=):" FontWeight="SemiBold" FontSize="11" Foreground="#2B6CB0"/>
                        <TextBlock x:Name="TxtExpectedCash" Text="3,450,000 đ" FontWeight="Bold" FontSize="11" Foreground="#2B6CB0" HorizontalAlignment="Right"/>
                    </DockPanel>
                    <DockPanel Margin="0,0,0,6">
                        <TextBlock Text="4. Tiền mặt thực tế kiểm đếm (=):" FontWeight="SemiBold" FontSize="11" Foreground="#2D3748"/>
                        <TextBlock x:Name="TxtActualCash" Text="3,450,000 đ" FontWeight="Bold" FontSize="12" Foreground="#2D3748" HorizontalAlignment="Right"/>
                    </DockPanel>

                    <!-- Kết quả chênh lệch -->
                    <Border x:Name="BorderDifference" Background="#F0FFF4" CornerRadius="4" Padding="8,6" Margin="0,2,0,0">
                        <DockPanel>
                            <TextBlock Text="CHÊNH LỆCH QUỸ (4 - 3):" FontWeight="Bold" FontSize="11" Foreground="#2D3748"/>
                            <TextBlock x:Name="TxtDifference" Text="0 đ (KHỚP HOÀN TOÀN)" FontWeight="Bold" FontSize="12" Foreground="#27AE60" HorizontalAlignment="Right"/>
                        </DockPanel>
                    </Border>

                    <!-- Ghi chú giải trình -->
                    <TextBlock Text="Ghi chú bàn giao / Giải trình:" FontSize="10" Foreground="#718096" Margin="0,10,0,2"/>
                    <Border Background="#F7FAFC" CornerRadius="4" Padding="6" BorderBrush="#E2E8F0" BorderThickness="1">
                        <TextBlock x:Name="TxtNotes" Text="Bàn giao quỹ tiền mặt đầy đủ" FontSize="11" FontStyle="Italic" Foreground="#4A5568" TextWrapping="Wrap"/>
                    </Border>

                    <!-- Chữ ký xác nhận -->
                    <Grid Margin="0,20,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                            <TextBlock Text="Thu ngân bàn giao" FontSize="10" FontWeight="Bold" Foreground="#4A5568" HorizontalAlignment="Center"/>
                            <TextBlock Text="(Ký &amp; ghi rõ họ tên)" FontSize="9" FontStyle="Italic" Foreground="#A0AEC0" HorizontalAlignment="Center"/>
                            <TextBlock x:Name="TxtSignCashier" Text="Trần Thị Thu Ngân" FontSize="11" FontWeight="SemiBold" Margin="0,35,0,0" HorizontalAlignment="Center"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                            <TextBlock Text="Quản lý / Người nhận" FontSize="10" FontWeight="Bold" Foreground="#4A5568" HorizontalAlignment="Center"/>
                            <TextBlock Text="(Ký &amp; ghi rõ họ tên)" FontSize="9" FontStyle="Italic" Foreground="#A0AEC0" HorizontalAlignment="Center"/>
                            <TextBlock Text="......................................" FontSize="11" Foreground="#CBD5E0" Margin="0,35,0,0" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="Phiếu in lúc: " x:Name="TxtPrintTime" FontSize="9" FontStyle="Italic" Foreground="#A0AEC0" HorizontalAlignment="Center" Margin="0,10,0,0"/>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- Nút thao tác dưới cùng -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center">
            <Button Content="🖨️ In Phiếu Z-Report" Click="Print_Click" Width="170" Height="40" Background="#2B6CB0" Foreground="White"
                    FontWeight="Bold" FontSize="12" BorderThickness="0" Margin="0,0,10,0" Cursor="Hand">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="6"/>
                    </Style>
                </Button.Resources>
            </Button>

            <Button Content="Đóng cửa sổ" Click="Close_Click" Width="120" Height="40" Background="#4A5568" Foreground="White"
                    FontWeight="SemiBold" FontSize="12" BorderThickness="0" Cursor="Hand">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="6"/>
                    </Style>
                </Button.Resources>
            </Button>
        </StackPanel>
    </Grid>
</Window>
