<Window x:Class="CafeManagement.Wpf.Views.Promotions.SelectPromotionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Chọn Chương Trình Khuyến Mãi / Voucher" Height="520" Width="550"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="#F8F9FA" FontFamily="Segoe UI">
    <Grid Margin="25">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Tiêu đề -->
        <Border Grid.Row="0" Background="White" CornerRadius="8" Padding="15,12" Margin="0,0,0,15" BorderBrush="#E8ECEF" BorderThickness="1">
            <StackPanel>
                <TextBlock Text="🎟️ DANH SÁCH VOUCHER &amp; KHUYẾN MÃI ĐANG CHẠY" FontWeight="Bold" FontSize="16" Foreground="#2C3E50"/>
                <TextBlock Text="Chọn một mã ưu đãi phù hợp với đơn hàng hiện tại để áp dụng chiết khấu" FontSize="11" Foreground="#7F8C8D" Margin="0,3,0,0"/>
            </StackPanel>
        </Border>

        <!-- Danh sách voucher -->
        <Border Grid.Row="1" Background="White" CornerRadius="8" Padding="15" BorderBrush="#E8ECEF" BorderThickness="1">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="LstPromotions">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,0,0,10" Padding="15,12" Background="#FAFAFA" CornerRadius="8" BorderBrush="#E8ECEF" BorderThickness="1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Thông tin voucher -->
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <Border Background="#FADBD8" CornerRadius="4" Padding="6,2" Margin="0,0,8,0">
                                                <TextBlock Text="{Binding PromotionCode}" FontWeight="Bold" FontSize="12" Foreground="#C0392B"/>
                                            </Border>
                                            <TextBlock Text="{Binding PromotionName}" FontWeight="Bold" FontSize="13" Foreground="#2C3E50" VerticalAlignment="Center"/>
                                        </StackPanel>

                                        <TextBlock Text="{Binding DiscountDisplay}" FontSize="12" Foreground="#27AE60" FontWeight="SemiBold" Margin="0,4,0,2"/>
                                        <TextBlock Text="{Binding MinOrderAmount, StringFormat='Đơn tối thiểu: {0:N0} đ'}" FontSize="11" Foreground="#7F8C8D"/>
                                    </StackPanel>

                                    <!-- Nút Áp dụng -->
                                    <Button Grid.Column="1" Content="Áp Dụng" Click="ApplyPromo_Click" Tag="{Binding}"
                                            Background="#E67E22" Foreground="White" FontWeight="Bold" FontSize="12"
                                            Padding="15,8" VerticalAlignment="Center" Cursor="Hand" BorderThickness="0">
                                        <Button.Resources>
                                            <Style TargetType="Border">
                                                <Setter Property="CornerRadius" Value="6"/>
                                            </Style>
                                        </Button.Resources>
                                    </Button>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <!-- Nút đóng -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button Content="Đóng" Click="Close_Click" Width="100" Height="38" Background="#95A5A6" Foreground="White"
                    FontWeight="SemiBold" FontSize="13" BorderThickness="0" Cursor="Hand">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="6"/>
                    </Style>
                </Button.Resources>
            </Button>
        </StackPanel>
    </Grid>
</Window>