<Window x:Class="CafeManagement.Wpf.Views.Promotions.PromotionEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Chương Trình Khuyến Mãi / Voucher" Height="580" Width="480"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="#F8F9FA" FontFamily="Segoe UI">
    <Grid Margin="25">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Tiêu đề -->
        <Border Grid.Row="0" Background="White" CornerRadius="8" Padding="15,12" Margin="0,0,0,15" BorderBrush="#E8ECEF" BorderThickness="1">
            <StackPanel>
                <TextBlock x:Name="TxtTitle" Text="➕ TẠO VOUCHER / KHUYẾN MÃI MỚI" FontWeight="Bold" FontSize="16" Foreground="#2C3E50"/>
                <TextBlock Text="Cấu hình thể lệ giảm giá, thời hạn và đơn hàng tối thiểu" FontSize="11" Foreground="#7F8C8D" Margin="0,3,0,0"/>
            </StackPanel>
        </Border>

        <!-- Form nhập -->
        <Border Grid.Row="1" Background="White" CornerRadius="8" Padding="20" BorderBrush="#E8ECEF" BorderThickness="1">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <!-- Mã Voucher -->
                    <TextBlock Text="Mã khuyến mãi / Voucher (*):" FontWeight="SemiBold" FontSize="12" Foreground="#2C3E50" Margin="0,0,0,5"/>
                    <TextBox x:Name="TxtCode" Height="36" Padding="10,0" VerticalContentAlignment="Center"
                             FontSize="13" FontWeight="Bold" BorderBrush="#BDC3C7" Margin="0,0,0,12"/>

                    <!-- Tên chương trình -->
                    <TextBlock Text="Tên chương trình ưu đãi (*):" FontWeight="SemiBold" FontSize="12" Foreground="#2C3E50" Margin="0,0,0,5"/>
                    <TextBox x:Name="TxtName" Height="36" Padding="10,0" VerticalContentAlignment="Center"
                             FontSize="13" BorderBrush="#BDC3C7" Margin="0,0,0,12"/>

                    <!-- Loại giảm giá -->
                    <TextBlock Text="Loại hình giảm giá (*):" FontWeight="SemiBold" FontSize="12" Foreground="#2C3E50" Margin="0,0,0,5"/>
                    <ComboBox x:Name="CboDiscountType" Height="36" FontSize="12" VerticalContentAlignment="Center" Margin="0,0,0,12">
                        <ComboBoxItem Content="Giảm theo phần trăm (%)" Tag="PERCENT" IsSelected="True"/>
                        <ComboBoxItem Content="Giảm số tiền cố định (VNĐ)" Tag="FIXED_AMOUNT"/>
                        <ComboBoxItem Content="Mua 1 tặng 1 (Tặng món rẻ nhất)" Tag="BUY1_GET1"/>
                    </ComboBox>

                    <!-- Giá trị giảm & Giảm tối đa -->
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="0,0,6,0">
                            <TextBlock Text="Mức giảm (% hoặc đ):" FontWeight="SemiBold" FontSize="12" Foreground="#2C3E50" Margin="0,0,0,5"/>
                            <TextBox x:Name="TxtDiscountValue" Height="36" Padding="10,0" VerticalContentAlignment="Center"
                                     FontSize="13" BorderBrush="#BDC3C7" Text="20"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Margin="6,0,0,0">
                            <TextBlock Text="Giảm tối đa (nếu %):" FontWeight="SemiBold" FontSize="12" Foreground="#2C3E50" Margin="0,0,0,5"/>
                            <TextBox x:Name="TxtMaxDiscount" Height="36" Padding="10,0" VerticalContentAlignment="Center"
                                     FontSize="13" BorderBrush="#BDC3C7" Text="30000"/>
                        </StackPanel>
                    </Grid>

                    <!-- Đơn tối thiểu & Lượt dùng -->
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="0,0,6,0">
                            <TextBlock Text="Đơn tối thiểu (VNĐ):" FontWeight="SemiBold" FontSize="12" Foreground="#2C3E50" Margin="0,0,0,5"/>
                            <TextBox x:Name="TxtMinOrder" Height="36" Padding="10,0" VerticalContentAlignment="Center"
                                     FontSize="13" BorderBrush="#BDC3C7" Text="0"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Margin="6,0,0,0">
                            <TextBlock Text="Giới hạn số lượt dùng:" FontWeight="SemiBold" FontSize="12" Foreground="#2C3E50" Margin="0,0,0,5"/>
                            <TextBox x:Name="TxtUsageLimit" Height="36" Padding="10,0" VerticalContentAlignment="Center"
                                     FontSize="13" BorderBrush="#BDC3C7" Text="500"/>
                        </StackPanel>
                    </Grid>

                    <!-- Trạng thái kích hoạt -->
                    <CheckBox x:Name="ChkIsActive" Content="Đang kích hoạt áp dụng ngay" IsChecked="True" FontWeight="SemiBold" FontSize="12" Foreground="#2C3E50" Margin="0,5,0,0"/>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- Nút thao tác -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button Content="Hủy bỏ" Click="Cancel_Click" Width="100" Height="40" Background="#95A5A6" Foreground="White"
                    FontWeight="SemiBold" FontSize="13" BorderThickness="0" Margin="0,0,10,0" Cursor="Hand">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="6"/>
                    </Style>
                </Button.Resources>
            </Button>

            <Button Content="💾 Lưu Voucher" Click="Save_Click" Width="150" Height="40" Background="#27AE60" Foreground="White"
                    FontWeight="Bold" FontSize="13" BorderThickness="0" Cursor="Hand">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="6"/>
                    </Style>
                </Button.Resources>
            </Button>
        </StackPanel>
    </Grid>
</Window>