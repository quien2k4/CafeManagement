<Window x:Class="CafeManagement.Wpf.Views.Orders.KitchenTicketWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Phiếu Pha Chế (Barista Ticket)" 
        Height="740" Width="520"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#2C3E50"
        FontFamily="Segoe UI">

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Header quán & Phiếu -->
            <RowDefinition Height="*"/>    <!-- Thẻ nội dung Phiếu in K80 -->
            <RowDefinition Height="Auto"/> <!-- Nút thao tác Xuất Word / In / Đóng -->
        </Grid.RowDefinitions>

        <!-- 1. Header Quán & Tên Phiếu -->
        <Border Grid.Row="0" Margin="0,0,0,12">
            <StackPanel HorizontalAlignment="Center">
                <TextBlock Text="CAFE CHAIN MANAGEMENT" FontWeight="Bold" FontSize="18" Foreground="#FFA726" HorizontalAlignment="Center"/>
                <TextBlock Text="☕ PHIẾU PHA CHẾ (BARISTA TICKET)" FontWeight="Bold" FontSize="14" Foreground="#ECF0F1" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                <TextBlock x:Name="TxtBranchName" Text="Chi nhánh Quận 1 (BR01)" FontSize="12" Foreground="#BDC3C7" HorizontalAlignment="Center" Margin="0,2,0,0"/>
            </StackPanel>
        </Border>

        <!-- 2. Thẻ nội dung mô phỏng Phiếu Pha Chế Giấy -->
        <Border Grid.Row="1" Background="White" CornerRadius="10" Padding="16" BorderBrush="#E2E8F0" BorderThickness="1">
            <Grid x:Name="TicketPrintArea">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- Thông tin Hóa đơn & Thu ngân & Loại đơn -->
                    <RowDefinition Height="*"/>    <!-- Danh sách từng ly đồ uống -->
                    <RowDefinition Height="Auto"/> <!-- Footer tổng số ly -->
                </Grid.RowDefinitions>

                <!-- 2.1 Thông tin Đơn hàng & Loại đơn -->
                <Border Grid.Row="0" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="0,0,0,10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Dòng 1: Mã đơn & Loại đơn Badge -->
                        <DockPanel Grid.Row="0" Margin="0,0,0,6">
                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                                <TextBlock Text="Hóa đơn: " FontSize="12" Foreground="#718096"/>
                                <TextBlock x:Name="TxtOrderNumber" Text="#HD12345" FontWeight="Bold" FontSize="14" Foreground="#2B6CB0"/>
                            </StackPanel>
                            <Border x:Name="BadgeOrderType" Background="#FFF5F5" BorderBrush="#FEB2B2" BorderThickness="1" CornerRadius="4" Padding="6,2" HorizontalAlignment="Right" DockPanel.Dock="Right">
                                <TextBlock x:Name="TxtOrderType" Text="MANG VỀ (TAKE-AWAY)" FontWeight="Bold" FontSize="11" Foreground="#E53E3E"/>
                            </Border>
                        </DockPanel>

                        <!-- Dòng 2: Giờ đặt món -->
                        <DockPanel Grid.Row="1" Margin="0,0,0,4">
                            <TextBlock Text="Giờ đặt món: " FontSize="11" Foreground="#718096"/>
                            <TextBlock x:Name="TxtOrderTime" Text="20/11/2026 17:15:30" FontWeight="SemiBold" FontSize="11" Foreground="#2D3748"/>
                        </DockPanel>

                        <!-- Dòng 3: Thu ngân thực hiện -->
                        <DockPanel Grid.Row="2">
                            <TextBlock Text="Thu ngân thực hiện: " FontSize="11" Foreground="#718096"/>
                            <TextBlock x:Name="TxtCashierName" Text="Trần Thị Thu Ngân" FontWeight="SemiBold" FontSize="11" Foreground="#2D3748"/>
                        </DockPanel>
                    </Grid>
                </Border>

                <!-- 2.2 Danh sách từng ly đồ uống (STT ly / tổng ly) -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="CupsItemsControl">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#F7FAFC" BorderBrush="#CBD5E0" BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="0,0,0,8">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <!-- Dòng 1: [Ly 1/3] TÊN MÓN (SIZE L) -->
                                        <DockPanel Grid.Row="0" Margin="0,0,0,4">
                                            <Border Background="#2C3E50" CornerRadius="4" Padding="5,2" Margin="0,0,8,0" DockPanel.Dock="Left">
                                                <TextBlock Text="{Binding CupNumberDisplay}" FontWeight="Bold" FontSize="11" Foreground="White"/>
                                            </Border>
                                            <TextBlock Text="{Binding TitleDisplay}" FontWeight="Bold" FontSize="13" Foreground="#1A202C" VerticalAlignment="Center"/>
                                        </DockPanel>

                                        <!-- Dòng 2: Tùy chỉnh (Đường, Đá) -->
                                        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,3">
                                            <TextBlock Text="• Tùy chỉnh: " FontWeight="SemiBold" FontSize="11" Foreground="#4A5568"/>
                                            <TextBlock Text="{Binding CustomizationDisplay}" FontWeight="Bold" FontSize="11" Foreground="#3182CE"/>
                                        </StackPanel>

                                        <!-- Dòng 3: Topping -->
                                        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,3">
                                            <TextBlock Text="• Topping: " FontWeight="SemiBold" FontSize="11" Foreground="#4A5568"/>
                                            <TextBlock Text="{Binding ToppingsDisplay}" FontWeight="SemiBold" FontSize="11" Foreground="#805AD5"/>
                                        </StackPanel>

                                        <!-- Dòng 4: Ghi chú -->
                                        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,0,0,6">
                                            <TextBlock Text="• Ghi chú: " FontWeight="SemiBold" FontSize="11" Foreground="#4A5568"/>
                                            <TextBlock Text="{Binding NoteDisplay}" FontStyle="Italic" FontSize="11" Foreground="#D69E2E"/>
                                        </StackPanel>

                                        <!-- Dòng 5: Ô kiểm soát: [ ] Đã pha chế -->
                                        <Border Grid.Row="4" Background="#EDF2F7" CornerRadius="4" Padding="8,4">
                                            <CheckBox IsChecked="{Binding IsCompleted, Mode=TwoWay}" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding CheckDisplay}" FontWeight="Bold" FontSize="11" Foreground="#2E8540"/>
                                            </CheckBox>
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- 2.3 Footer Tổng số ly -->
                <Border Grid.Row="2" Background="#FFF5F5" BorderBrush="#FED7D7" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,10,0,0">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock x:Name="TxtTotalCupsFooter" Text="TỔNG SỐ LY CẦN PHA CHẾ: 3 LY (Ly 1..3 / 3 ly)" FontWeight="Bold" FontSize="13" Foreground="#E53E3E" HorizontalAlignment="Center"/>
                        <TextBlock Text="Barista vui lòng tích kiểm soát từng ly sau khi hoàn thành!" FontSize="11" Foreground="#718096" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- 3. Nút Thao tác -->
        <Grid Grid.Row="2" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="0.7*"/>
            </Grid.ColumnDefinitions>

            <!-- Xuất Word .docx -->
            <Button Grid.Column="0" Content="📄 Xuất File Word (.docx)" Click="BtnExportDocx_Click"
                    Height="40" FontSize="12" FontWeight="Bold" Background="#2B6CB0" Foreground="White" BorderThickness="0" Margin="0,0,6,0" Cursor="Hand">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="8"/>
                    </Style>
                </Button.Resources>
            </Button>

            <!-- In / Xuất PDF -->
            <Button Grid.Column="1" Content="🖨️ In Phiếu / Xuất PDF" Click="BtnPrintPdf_Click"
                    Height="40" FontSize="12" FontWeight="Bold" Background="#38A169" Foreground="White" BorderThickness="0" Margin="3,0,6,0" Cursor="Hand">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="8"/>
                    </Style>
                </Button.Resources>
            </Button>

            <!-- Đóng -->
            <Button Grid.Column="2" Content="Đóng" Click="BtnClose_Click"
                    Height="40" FontSize="12" FontWeight="SemiBold" Background="#4A5568" Foreground="White" BorderThickness="0" Margin="3,0,0,0" Cursor="Hand">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="8"/>
                    </Style>
                </Button.Resources>
            </Button>
        </Grid>
    </Grid>
</Window>