<Window x:Class="CafeManagement.Wpf.Views.POS.CustomizeProductWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Tùy Chọn Món Đồ Uống" 
        Height="650" Width="540"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F8F9FA"
        FontFamily="Segoe UI">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /> <!-- Header thông tin món -->
            <RowDefinition Height="*" />    <!-- Danh sách các nhóm tùy chọn (Size, Đường, Đá, Topping) -->
            <RowDefinition Height="Auto" /> <!-- Footer: Số lượng, Tổng tiền, Nút thêm -->
        </Grid.RowDefinitions>

        <!-- Header: Tên món & Giá cơ bản -->
        <Border Grid.Row="0" Background="White" CornerRadius="10" Padding="15" Margin="0,0,0,15" BorderBrush="#E9ECEF" BorderThickness="1">
            <DockPanel>
                <!-- Khung ảnh đại diện món thực tế -->
                <Border Width="64" Height="64" Background="#F8FAFC" CornerRadius="10" Margin="0,0,15,0" ClipToBounds="True" BorderBrush="#E2E8F0" BorderThickness="1">
                    <Grid>
                        <TextBlock Text="☕" FontSize="30" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <Image Source="{Binding Product.ImageUrl}" Stretch="UniformToFill" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding Product.ProductName}" FontWeight="Bold" FontSize="18" Foreground="#2C3E50"/>
                    <TextBlock Text="{Binding Product.BasePrice, StringFormat='Giá gốc: {0:N0} đ'}" FontSize="13" Foreground="#E65100" FontWeight="SemiBold"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Thân: Cuộn các tùy chọn -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- 1. CHỌN SIZE (Chỉ chọn duy nhất 1 size, mặc định là Size M) -->
                <Border Background="White" CornerRadius="10" Padding="15" Margin="0,0,0,12" BorderBrush="#E9ECEF" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="1. CHỌN KÍCH CỠ (SIZE)" FontWeight="Bold" FontSize="13" Foreground="#7F8C8D" Margin="0,0,0,10"/>
                        <ItemsControl ItemsSource="{Binding VariantItems}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <RadioButton GroupName="SizeRadioGroup" Margin="0,0,12,0"
                                                 IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                 Command="{Binding DataContext.SelectVariantCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                 CommandParameter="{Binding}">
                                        <RadioButton.Template>
                                            <ControlTemplate TargetType="RadioButton">
                                                <Border Name="Border" Background="#F1F3F5" CornerRadius="8" Padding="16,10" BorderBrush="#CED4DA" BorderThickness="1" Cursor="Hand">
                                                    <StackPanel HorizontalAlignment="Center">
                                                        <TextBlock Text="{Binding Variant.Size, StringFormat='Size {0}'}" FontWeight="Bold" FontSize="13" HorizontalAlignment="Center"/>
                                                        <TextBlock Text="{Binding Variant.ExtraPrice, StringFormat='+{0:N0} đ'}" FontSize="11" Foreground="#E65100" HorizontalAlignment="Center"/>
                                                    </StackPanel>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsChecked" Value="True">
                                                        <Setter TargetName="Border" Property="Background" Value="#FFF3E0"/>
                                                        <Setter TargetName="Border" Property="BorderBrush" Value="#FFA726"/>
                                                        <Setter TargetName="Border" Property="BorderThickness" Value="2"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </RadioButton.Template>
                                    </RadioButton>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- 2. MỨC ĐƯỜNG -->
                <Border Background="White" CornerRadius="10" Padding="15" Margin="0,0,0,12" BorderBrush="#E9ECEF" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="2. MỨC ĐƯỜNG" FontWeight="Bold" FontSize="13" Foreground="#7F8C8D" Margin="0,0,0,10"/>
                        <WrapPanel Orientation="Horizontal">
                            <RadioButton Content="100% (Chuẩn)" GroupName="Sugar" 
                                         IsChecked="{Binding SelectedSugar, ConverterParameter='100%', Mode=OneWay}"
                                         Command="{Binding SelectSugarCommand}" CommandParameter="100%" Margin="0,0,15,8"/>
                            <RadioButton Content="70%" GroupName="Sugar" 
                                         Command="{Binding SelectSugarCommand}" CommandParameter="70%" Margin="0,0,15,8"/>
                            <RadioButton Content="50%" GroupName="Sugar" 
                                         Command="{Binding SelectSugarCommand}" CommandParameter="50%" Margin="0,0,15,8"/>
                            <RadioButton Content="30%" GroupName="Sugar" 
                                         Command="{Binding SelectSugarCommand}" CommandParameter="30%" Margin="0,0,15,8"/>
                            <RadioButton Content="0% (Không đường)" GroupName="Sugar" 
                                         Command="{Binding SelectSugarCommand}" CommandParameter="0%" Margin="0,0,15,8"/>
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <!-- 3. MỨC ĐÁ -->
                <Border Background="White" CornerRadius="10" Padding="15" Margin="0,0,0,12" BorderBrush="#E9ECEF" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="3. MỨC ĐÁ" FontWeight="Bold" FontSize="13" Foreground="#7F8C8D" Margin="0,0,0,10"/>
                        <WrapPanel Orientation="Horizontal">
                            <RadioButton Content="100% Đá (Chuẩn)" GroupName="Ice" 
                                         IsChecked="{Binding SelectedIce, ConverterParameter='100%', Mode=OneWay}"
                                         Command="{Binding SelectIceCommand}" CommandParameter="100%" Margin="0,0,15,8"/>
                            <RadioButton Content="50% Đá" GroupName="Ice" 
                                         Command="{Binding SelectIceCommand}" CommandParameter="50%" Margin="0,0,15,8"/>
                            <RadioButton Content="Không Đá" GroupName="Ice" 
                                         Command="{Binding SelectIceCommand}" CommandParameter="Không đá" Margin="0,0,15,8"/>
                            <RadioButton Content="Uống Nóng" GroupName="Ice" 
                                         Command="{Binding SelectIceCommand}" CommandParameter="Nóng" Margin="0,0,15,8"/>
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <!-- 4. THÊM TOPPING (CÓ GỢI Ý AI NỔI BẬT) -->
                <Border Background="White" CornerRadius="10" Padding="15" Margin="0,0,0,12" BorderBrush="#E9ECEF" BorderThickness="1">
                    <StackPanel>
                        <!-- Khung AI Gợi Ý (Chỉ hiện khi có đề xuất) -->
                        <Border Background="#F0FDF4" CornerRadius="8" Padding="12,10" Margin="0,0,0,12" BorderBrush="#BBF7D0" BorderThickness="1"
                                Visibility="{Binding HasAiRecommendations, Converter={StaticResource BoolToVis}}">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,8">
                                    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="🤖" FontSize="15" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="AI ĐỀ XUẤT TOPPING PHÙ HỢP NHẤT" FontWeight="Bold" FontSize="12" Foreground="#15803D" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <TextBlock Text="Dựa trên hành vi khách hàng" FontSize="11" Foreground="#16A34A" FontStyle="Italic" DockPanel.Dock="Right" VerticalAlignment="Center"/>
                                </DockPanel>

                                <!-- Danh sách các nút chọn nhanh 1-click -->
                                <ItemsControl ItemsSource="{Binding AiRecommendations}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel Orientation="Horizontal"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Command="{Binding DataContext.QuickAddToppingCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"
                                                    Background="White" BorderBrush="#86EFAC" BorderThickness="1"
                                                    Padding="10,6" Margin="0,0,8,6" Cursor="Hand" ToolTip="Nhấp vào để chọn nhanh Topping này">
                                                <Button.Resources>
                                                    <Style TargetType="Border">
                                                        <Setter Property="CornerRadius" Value="6"/>
                                                    </Style>
                                                </Button.Resources>
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="✨" Margin="0,0,4,0" FontSize="11"/>
                                                    <TextBlock Text="{Binding ToppingName}" FontWeight="SemiBold" FontSize="12" Foreground="#166534"/>
                                                    <Border Background="#DCFCE7" CornerRadius="4" Padding="4,1" Margin="6,0,0,0">
                                                        <TextBlock Text="{Binding BadgeText}" FontSize="10" FontWeight="Bold" Foreground="#15803D"/>
                                                    </Border>
                                                    <TextBlock Text="{Binding Price, StringFormat=' (+{0:N0} đ)'}" FontSize="11" Foreground="#15803D" Margin="2,0,0,0"/>
                                                </StackPanel>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="4. DANH SÁCH TOPPING" FontWeight="Bold" FontSize="13" Foreground="#7F8C8D" Margin="0,0,0,10"/>
                        <ItemsControl ItemsSource="{Binding Toppings}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#FDFEFE" CornerRadius="8" Padding="10,8" Margin="0,0,0,6" BorderBrush="#EEEEEE" BorderThickness="1">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="90" />
                                            </Grid.ColumnDefinitions>

                                            <!-- Checkbox chọn Topping -->
                                            <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected}" VerticalAlignment="Center" Margin="0,0,8,0" Cursor="Hand"/>

                                            <!-- Tên Topping kèm Huy hiệu AI đề xuất -->
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Topping.ToppingName}" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center"/>
                                                <Border Background="{Binding BadgeBackground}" CornerRadius="4" Padding="6,2" Margin="8,0,0,0" VerticalAlignment="Center"
                                                        Visibility="{Binding HasRecommendation, Converter={StaticResource BoolToVis}}">
                                                    <TextBlock Text="{Binding BadgeText}" Foreground="{Binding BadgeColor}" FontWeight="Bold" FontSize="10"/>
                                                </Border>
                                            </StackPanel>

                                            <!-- Nút Cộng/Trừ số lượng Topping (chỉ hiện khi tích chọn) -->
                                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0"
                                                        Visibility="{Binding IsSelected, Converter={StaticResource BoolToVis}}">
                                                <Button Content="-" 
                                                        Command="{Binding DataContext.DecreaseToppingCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}"
                                                        Width="26" Height="26" Background="#E0E0E0" FontWeight="Bold" BorderThickness="0" Cursor="Hand"/>
                                                <TextBlock Text="{Binding Quantity}" Width="28" TextAlignment="Center" FontWeight="Bold" FontSize="13" VerticalAlignment="Center"/>
                                                <Button Content="+" 
                                                        Command="{Binding DataContext.IncreaseToppingCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}"
                                                        Width="26" Height="26" Background="#27AE60" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand"/>
                                            </StackPanel>

                                            <!-- Tổng tiền Topping -->
                                            <TextBlock Grid.Column="3" Text="{Binding TotalPrice, StringFormat='+{0:N0} đ'}" 
                                                       FontWeight="Bold" FontSize="13" Foreground="#E65100" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- 5. GHI CHÚ ĐẶC BIỆT -->
                <Border Background="White" CornerRadius="10" Padding="15" Margin="0,0,0,12" BorderBrush="#E9ECEF" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="5. GHI CHÚ ĐẶC BIỆT" FontWeight="Bold" FontSize="13" Foreground="#7F8C8D" Margin="0,0,0,8"/>
                        <TextBox Text="{Binding Note, UpdateSourceTrigger=PropertyChanged}" 
                                 Height="40" Padding="8" BorderBrush="#CED4DA" FontSize="13"
                                 VerticalContentAlignment="Center" Background="#FAFAFA"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Footer: Số lượng + Tổng tiền + Nút Xác nhận -->
        <Border Grid.Row="2" Background="White" CornerRadius="10" Padding="15" Margin="0,15,0,0" BorderBrush="#E9ECEF" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Nút Tăng Giảm Số Lượng Món -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="-" Command="{Binding DecreaseQuantityCommand}" Width="36" Height="36" Background="#E0E0E0" FontWeight="Bold" FontSize="16" BorderThickness="0" Cursor="Hand"/>
                    <TextBlock Text="{Binding Quantity}" Width="40" TextAlignment="Center" FontWeight="Bold" FontSize="16" VerticalAlignment="Center"/>
                    <Button Content="+" Command="{Binding IncreaseQuantityCommand}" Width="36" Height="36" Background="#27AE60" Foreground="White" FontWeight="Bold" FontSize="16" BorderThickness="0" Cursor="Hand"/>
                </StackPanel>

                <!-- Tổng tiền -->
                <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,15,0">
                    <TextBlock Text="TỔNG TIỀN MÓN" FontSize="11" Foreground="#7F8C8D" HorizontalAlignment="Right"/>
                    <TextBlock Text="{Binding TotalPrice, StringFormat='{}{0:N0} đ'}" FontSize="18" FontWeight="Bold" Foreground="#E65100" HorizontalAlignment="Right"/>
                </StackPanel>

                <!-- Nút Hành Động -->
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button Content="Hủy" Click="Cancel_Click" Width="80" Height="42" Margin="0,0,8,0" Background="#F1F3F5" FontWeight="Bold" BorderThickness="0" Cursor="Hand"/>
                    
                    <!-- Nút Thêm Vào Đơn / Cập Nhật -->
                    <Button Click="Confirm_Click" Width="135" Height="42" Background="#27AE60" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Content" Value="Thêm Vào Đơn"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsEditMode}" Value="True">
                                        <Setter Property="Content" Value="Cập Nhật Món"/>
                                        <Setter Property="Background" Value="#2980B9"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
