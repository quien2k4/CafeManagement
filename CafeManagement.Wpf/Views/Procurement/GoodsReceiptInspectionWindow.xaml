<Window x:Class="CafeManagement.Wpf.Views.Procurement.GoodsReceiptInspectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Tiếp Nhận Hàng Hóa &amp; Kiểm Soát Chất Lượng QC (2 Bước)"
        Height="720" Width="1020"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F8FAFC"
        FontFamily="Segoe UI">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /> <!-- Thông tin đối soát đơn PO -->
            <RowDefinition Height="Auto" /> <!-- Thông tin tài xế & hóa đơn -->
            <RowDefinition Height="*" />    <!-- Bảng kiểm đếm phân loại QC 2 bước -->
            <RowDefinition Height="Auto" /> <!-- Tổng kết nghiệm thu -->
            <RowDefinition Height="Auto" /> <!-- Nút hành động -->
        </Grid.RowDefinitions>

        <!-- 1. Header Đơn PO -->
        <Border Grid.Row="0" Background="#EFF6FF" CornerRadius="10" Padding="16,12" Margin="0,0,0,12" BorderBrush="#BFDBFE" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="MÃ ĐƠN HÀNG (PO)" FontSize="11" FontWeight="Bold" Foreground="#1E40AF"/>
                    <TextBlock x:Name="TxtPoCode" Text="PO-20261121-001" FontSize="15" FontWeight="Bold" Foreground="#1E3A8A" Margin="0,2,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="1">
                    <TextBlock Text="NHÀ CUNG CẤP" FontSize="11" FontWeight="Bold" Foreground="#1E40AF"/>
                    <TextBlock x:Name="TxtSupplierName" Text="Công Ty Cà Phê Cao Nguyên" FontSize="13" FontWeight="SemiBold" Foreground="#1E293B" Margin="0,2,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <TextBlock Text="CHI NHÁNH NHẬN" FontSize="11" FontWeight="Bold" Foreground="#1E40AF"/>
                    <TextBlock x:Name="TxtBranchName" Text="Chi Nhánh Quận 1" FontSize="13" FontWeight="SemiBold" Foreground="#1E293B" Margin="0,2,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="3">
                    <TextBlock Text="NGƯỜI TIẾP NHẬN" FontSize="11" FontWeight="Bold" Foreground="#1E40AF"/>
                    <TextBlock x:Name="TxtReceiverName" Text="Quản lý kho" FontSize="13" FontWeight="SemiBold" Foreground="#1E293B" Margin="0,2,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 2. Thông tin giao nhận -->
        <Border Grid.Row="1" Background="White" CornerRadius="10" Padding="16,12" Margin="0,0,0,12" BorderBrush="#E2E8F0" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="1.5*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,12,0">
                    <TextBlock Text="👤 TÀI XẾ / NGƯỜI GIAO HÀNG (*)" FontWeight="Bold" FontSize="11" Foreground="#475569" Margin="0,0,0,4"/>
                    <TextBox x:Name="TxtDeliveryPerson" Height="34" VerticalContentAlignment="Center" Padding="8,0" Text="Nguyễn Văn Giao (0909123456)"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Margin="0,0,12,0">
                    <TextBlock Text="📄 SỐ HÓA ĐƠN / PHIẾU XUẤT KHO NCC" FontWeight="Bold" FontSize="11" Foreground="#475569" Margin="0,0,0,4"/>
                    <TextBox x:Name="TxtInvoiceNumber" Height="34" VerticalContentAlignment="Center" Padding="8,0" Text="HD-88992"/>
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <TextBlock Text="📝 GHI CHÚ TIẾP NHẬN / TÌNH TRẠNG XE VẬN CHUYỂN" FontWeight="Bold" FontSize="11" Foreground="#475569" Margin="0,0,0,4"/>
                    <TextBox x:Name="TxtReceiptNote" Height="34" VerticalContentAlignment="Center" Padding="8,0" Text="Xe thùng kín, niêm phong nguyên vẹn."/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 3. Bảng Kiểm Đếm Phân Loại QC (2 Bước) -->
        <Border Grid.Row="2" Background="White" CornerRadius="10" Padding="0" BorderBrush="#E2E8F0" BorderThickness="1" Margin="0,0,0,12">
            <DataGrid x:Name="DgInspectionItems" AutoGenerateColumns="False" CanUserAddRows="False"
                      GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#F1F5F9"
                      HeadersVisibility="Column" Background="White" RowHeight="42" BorderThickness="0">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="NGUYÊN LIỆU" Binding="{Binding IngredientName}" Width="1.5*" IsReadOnly="True">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="Foreground" Value="#1E293B"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <DataGridTextColumn Header="ĐÃ ĐẶT" Binding="{Binding OrderedQuantity, StringFormat='{}{0:N1}'}" Width="75" IsReadOnly="True">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="#64748B"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <DataGridTextColumn Header="ĐVT" Binding="{Binding Uom}" Width="55" IsReadOnly="True">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="#64748B"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <!-- Giao thực tế -->
                    <DataGridTemplateColumn Header="GIAO THỰC TẾ" Width="95">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBox Text="{Binding DeliveredQuantity, UpdateSourceTrigger=PropertyChanged, StringFormat='{}{0:G}'}"
                                         Height="28" VerticalContentAlignment="Center" TextAlignment="Center" FontWeight="Bold"
                                         TextChanged="ItemQty_TextChanged"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Đạt chuẩn (Accepted) -->
                    <DataGridTemplateColumn Header="✅ ĐẠT CHUẨN" Width="100">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBox Text="{Binding AcceptedQuantity, UpdateSourceTrigger=PropertyChanged, StringFormat='{}{0:G}'}"
                                         Height="28" VerticalContentAlignment="Center" TextAlignment="Center" FontWeight="Bold"
                                         Background="#F0FDF4" Foreground="#166534" BorderBrush="#BBF7D0"
                                         TextChanged="ItemQty_TextChanged"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Tạm giữ (Quarantine) -->
                    <DataGridTemplateColumn Header="⚠️ TẠM GIỮ" Width="90">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBox Text="{Binding QuarantinedQuantity, UpdateSourceTrigger=PropertyChanged, StringFormat='{}{0:G}'}"
                                         Height="28" VerticalContentAlignment="Center" TextAlignment="Center"
                                         Background="#FFFBEB" Foreground="#B45309" BorderBrush="#FDE68A"
                                         TextChanged="ItemQty_TextChanged"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Trả lại (Rejected) -->
                    <DataGridTemplateColumn Header="❌ TRẢ LẠI" Width="90">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBox Text="{Binding RejectedQuantity, UpdateSourceTrigger=PropertyChanged, StringFormat='{}{0:G}'}"
                                         Height="28" VerticalContentAlignment="Center" TextAlignment="Center" FontWeight="Bold"
                                         Background="#FEF2F2" Foreground="#991B1B" BorderBrush="#FECACA"
                                         TextChanged="ItemQty_TextChanged"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Lý do trả lại / Lỗi QC -->
                    <DataGridTemplateColumn Header="LÝ DO TRẢ / LỖI QC" Width="1.5*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBox Text="{Binding RejectionReason, UpdateSourceTrigger=PropertyChanged}"
                                         Height="28" VerticalContentAlignment="Center" Padding="4,0"
                                         ToolTip="Ghi rõ lý do nếu có hàng tạm giữ hoặc từ chối trả lại"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Thành tiền đạt chuẩn -->
                    <DataGridTextColumn Header="TIỀN ĐẠT CHUẨN" Binding="{Binding TotalAcceptedPrice, StringFormat='{}{0:N0} đ'}" Width="120" IsReadOnly="True">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter Property="Foreground" Value="#16A34A"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- 4. Tổng kết nghiệm thu -->
        <Border Grid.Row="3" Background="#F1F5F9" CornerRadius="10" Padding="16,12" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="💡 LƯU Ý QUY TRÌNH GHI SỔ KHO:" FontWeight="Bold" FontSize="11" Foreground="#475569"/>
                    <TextBlock Text="• Chỉ số lượng [✅ ĐẠT CHUẨN] mới được cộng vào tồn kho bán hàng và tính tiền hóa đơn." FontSize="11" Foreground="#64748B" Margin="0,2,0,0"/>
                    <TextBlock Text="• Số lượng [❌ TRẢ LẠI] được ghi nhận vào Biên bản bàn giao (GRN) để trừ tiền công nợ hoặc yêu cầu giao bù." FontSize="11" Foreground="#DC2626"/>
                </StackPanel>

                <!-- Thống kê SL -->
                <Border Grid.Column="1" Background="White" CornerRadius="8" Padding="12,6" Margin="10,0" BorderBrush="#E2E8F0" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="TỔNG ĐẠT CHUẨN" FontSize="10" FontWeight="Bold" Foreground="#166534"/>
                        <TextBlock x:Name="TxtTotalAcceptedCount" Text="0 món" FontSize="14" FontWeight="Bold" Foreground="#16A34A"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Background="White" CornerRadius="8" Padding="12,6" Margin="0,0,10,0" BorderBrush="#E2E8F0" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="TỔNG TRẢ LẠI" FontSize="10" FontWeight="Bold" Foreground="#991B1B"/>
                        <TextBlock x:Name="TxtTotalRejectedCount" Text="0 món" FontSize="14" FontWeight="Bold" Foreground="#DC2626"/>
                    </StackPanel>
                </Border>

                <!-- Tổng tiền -->
                <Border Grid.Column="3" Background="White" CornerRadius="8" Padding="16,6" BorderBrush="#E2E8F0" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="TỔNG TIỀN GHI SỔ NHẬP KHO" FontSize="10" FontWeight="Bold" Foreground="#1E40AF"/>
                        <TextBlock x:Name="TxtTotalAcceptedAmountDisplay" Text="0 đ" FontSize="16" FontWeight="Bold" Foreground="#2563EB"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- 5. Actions -->
        <Border Grid.Row="4">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Hủy Bỏ" Width="110" Height="38" Background="#E2E8F0" Foreground="#475569" FontWeight="Bold"
                        BorderThickness="0" Margin="0,0,10,0" Cursor="Hand" Click="CancelButton_Click"/>
                <Button Content="✅ Ghi Sổ Nhập Kho &amp; Hoàn Tất Tiếp Nhận" Width="300" Height="38" Background="#16A34A" Foreground="White" FontWeight="Bold"
                        BorderThickness="0" Cursor="Hand" Click="ConfirmReceiptButton_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
