<Window x:Class="CafeManagement.Wpf.Views.Procurement.ProcurementManagementWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Quản Lý Mua Hàng, Nhà Cung Cấp &amp; Tiếp Nhận Hàng Hóa (QC)"
        Height="780" Width="1240"
        MinWidth="1100" MinHeight="700"
        WindowStartupLocation="CenterScreen"
        Background="#F8FAFC"
        FontFamily="Segoe UI">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /> <!-- Header Bar -->
            <RowDefinition Height="*" />    <!-- Content 3 Tabs -->
        </Grid.RowDefinitions>

        <!-- 1. Header Bar -->
        <Border Grid.Row="0" Background="White" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="24,14">
            <DockPanel LastChildFill="False">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#E0F2FE" CornerRadius="10" Width="44" Height="44" Margin="0,0,14,0">
                        <TextBlock Text="🏢" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel>
                        <TextBlock Text="PHÂN HỆ MUA HÀNG, NHÀ CUNG CẤP &amp; TIẾP NHẬN QC" FontWeight="Bold" FontSize="17" Foreground="#0F172A"/>
                        <TextBlock Text="Bảng giá nhà cung cấp • Lập đơn mua PO • Quy trình tiếp nhận 2 bước &amp; Ghi sổ kho" FontSize="12" Foreground="#64748B" Margin="0,2,0,0"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Nút Làm Mới -->
                    <Button Content="🔄 Làm mới" Padding="14,8" Background="#F1F5F9" Foreground="#334155" FontWeight="Bold"
                            BorderThickness="0" Margin="0,0,10,0" Cursor="Hand" Click="RefreshButton_Click"/>

                    <Button Content="Đóng" Padding="16,8" Background="#E2E8F0" Foreground="#475569" FontWeight="Bold"
                            BorderThickness="0" Cursor="Hand" Click="CloseButton_Click"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- 2. TabControl Chính -->
        <TabControl Grid.Row="1" Background="Transparent" BorderThickness="0" Margin="20,15,20,20"
                    SelectedIndex="{Binding SelectedTabIndex, Mode=TwoWay}">
            <TabControl.Resources>
                <Style TargetType="TabItem">
                    <Setter Property="FontSize" Value="14"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                    <Setter Property="Padding" Value="18,10"/>
                    <Setter Property="Cursor" Value="Hand"/>
                </Style>
            </TabControl.Resources>

            <!-- ========================================== -->
            <!-- TAB 1: NHÀ CUNG CẤP & BẢNG GIÁ             -->
            <!-- ========================================== -->
            <TabItem Header="🏢 Nhà Cung Cấp &amp; Bảng Giá">
                <Grid Margin="0,15,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="4.2*" />
                        <ColumnDefinition Width="5.8*" />
                    </Grid.ColumnDefinitions>

                    <!-- Khung Trái: Danh Sách Nhà Cung Cấp -->
                    <Border Grid.Column="0" Background="White" CornerRadius="12" Padding="18" Margin="0,0,12,0" BorderBrush="#E2E8F0" BorderThickness="1">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <DockPanel Grid.Row="0" Margin="0,0,0,12">
                                <TextBlock Text="DANH SÁCH NHÀ CUNG CẤP" FontWeight="Bold" FontSize="13" Foreground="#1E293B" VerticalAlignment="Center"/>
                                <Button Content="+ Thêm NCC" DockPanel.Dock="Right" Padding="12,6" Background="#2563EB" Foreground="White"
                                        FontWeight="Bold" FontSize="12" BorderThickness="0" Cursor="Hand" Click="AddSupplierButton_Click"/>
                            </DockPanel>

                            <!-- Tìm kiếm NCC -->
                            <TextBox Grid.Row="1" Height="34" VerticalContentAlignment="Center" Padding="8,0" Margin="0,0,0,12"
                                     Text="{Binding SupplierSearchKeyword, UpdateSourceTrigger=PropertyChanged}"
                                     Tag="🔍 Tìm kiếm mã, tên, SĐT nhà cung cấp..."/>

                            <!-- Bảng NCC -->
                            <DataGrid Grid.Row="2" ItemsSource="{Binding Suppliers}" SelectedItem="{Binding SelectedSupplier, Mode=TwoWay}"
                                      AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                                      GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#F1F5F9"
                                      HeadersVisibility="Column" Background="White" RowHeight="42" BorderThickness="1" BorderBrush="#E2E8F0">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="MÃ NCC" Binding="{Binding SupplierCode}" Width="85"/>
                                    <DataGridTextColumn Header="TÊN NHÀ CUNG CẤP" Binding="{Binding SupplierName}" Width="*">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                                <Setter Property="Foreground" Value="#1E293B"/>
                                                <Setter Property="VerticalAlignment" Value="Center"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="SĐT" Binding="{Binding Phone}" Width="95"/>
                                    <DataGridTextColumn Header="MẶT HÀNG" Binding="{Binding ItemCount, StringFormat='{}{0} món'}" Width="75"/>
                                    <DataGridTemplateColumn Width="90">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                    <Button Content="✏️" Padding="5,2" Margin="0,0,4,0" ToolTip="Chỉnh sửa NCC"
                                                            Background="#F1F5F9" BorderThickness="0" Cursor="Hand" Click="EditSupplierButton_Click"/>
                                                    <Button Content="🗑️" Padding="5,2" ToolTip="Xóa NCC"
                                                            Background="#FEE2E2" Foreground="#DC2626" BorderThickness="0" Cursor="Hand"
                                                            Command="{Binding DataContext.DeleteSupplierCommand, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>

                    <!-- Khung Phải: Bảng Giá & Mặt Hàng Do NCC Cung Cấp -->
                    <Border Grid.Column="1" Background="White" CornerRadius="12" Padding="18" BorderBrush="#E2E8F0" BorderThickness="1">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <DockPanel Grid.Row="0" Margin="0,0,0,8">
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="BẢNG GIÁ MẶT HÀNG CUNG ỨNG" FontWeight="Bold" FontSize="13" Foreground="#1E293B"/>
                                    <TextBlock Text="{Binding SelectedSupplier.SupplierName, StringFormat='Nhà cung cấp: {0}'}" FontSize="12" Foreground="#64748B" Margin="0,2,0,0"/>
                                </StackPanel>

                                <Button Content="+ Gán Mặt Hàng &amp; Giá" DockPanel.Dock="Right" Padding="12,6" Background="#16A34A" Foreground="White"
                                        FontWeight="Bold" FontSize="12" BorderThickness="0" Cursor="Hand" Click="AddSupplierIngredientButton_Click"/>
                            </DockPanel>

                            <!-- Thẻ chi tiết NCC đang chọn -->
                            <Border Grid.Row="1" Background="#F8FAFC" CornerRadius="8" Padding="12,8" Margin="0,0,0,12" BorderBrush="#E2E8F0" BorderThickness="1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding SelectedSupplier.ContactPerson, StringFormat='👤 LH: {0}'}" FontSize="11" Foreground="#475569"/>
                                    <TextBlock Grid.Column="1" Text="{Binding SelectedSupplier.TaxCode, StringFormat='🏛️ MST: {0}'}" FontSize="11" Foreground="#475569"/>
                                    <TextBlock Grid.Column="2" Text="{Binding SelectedSupplier.Address, StringFormat='📍 {0}'}" FontSize="11" Foreground="#475569" TextTrimming="CharacterEllipsis"/>
                                </Grid>
                            </Border>

                            <!-- Bảng Danh mục & Giá -->
                            <DataGrid Grid.Row="2" ItemsSource="{Binding SupplierIngredients}" SelectedItem="{Binding SelectedSupplierIngredient, Mode=TwoWay}"
                                      AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                                      GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#F1F5F9"
                                      HeadersVisibility="Column" Background="White" RowHeight="42" BorderThickness="1" BorderBrush="#E2E8F0">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="MÃ NL" Binding="{Binding IngredientCode}" Width="80"/>
                                    <DataGridTextColumn Header="TÊN NGUYÊN LIỆU" Binding="{Binding IngredientName}" Width="*">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                                <Setter Property="Foreground" Value="#1E293B"/>
                                                <Setter Property="VerticalAlignment" Value="Center"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="GIÁ MUA" Binding="{Binding SupplyPrice, StringFormat='{}{0:N0} đ'}" Width="105">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="FontWeight" Value="Bold"/>
                                                <Setter Property="Foreground" Value="#0284C7"/>
                                                <Setter Property="VerticalAlignment" Value="Center"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="QUY CÁCH" Binding="{Binding PackageUom}" Width="90"/>
                                    <DataGridTextColumn Header="QUY ĐỔI KHO" Binding="{Binding ConversionFactor, StringFormat='{}x{0:G}'}" Width="85"/>
                                    <DataGridTextColumn Header="ĐẶT TỐI THIỂU" Binding="{Binding MinOrderQuantity, StringFormat='{}{0:G}'}" Width="90"/>
                                    <DataGridTemplateColumn Width="80">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                    <Button Content="✏️" Padding="5,2" Margin="0,0,4,0" ToolTip="Sửa giá"
                                                            Background="#F1F5F9" BorderThickness="0" Cursor="Hand" Click="EditSupplierIngredientButton_Click"/>
                                                    <Button Content="✕" Padding="5,2" ToolTip="Xóa khỏi NCC"
                                                            Background="#FEE2E2" Foreground="#DC2626" BorderThickness="0" Cursor="Hand"
                                                            Command="{Binding DataContext.DeleteSupplierIngredientCommand, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- ========================================== -->
            <!-- TAB 2: ĐƠN ĐẶT HÀNG MUA (PO)               -->
            <!-- ========================================== -->
            <TabItem Header="📋 Đơn Đặt Hàng Mua (PO)">
                <Grid Margin="0,15,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" /> <!-- Thống kê & Filter -->
                        <RowDefinition Height="*" />    <!-- Danh sách đơn & Chi tiết -->
                    </Grid.RowDefinitions>

                    <!-- Thống kê & Action Buttons -->
                    <Border Grid.Row="0" Background="White" CornerRadius="12" Padding="18,14" Margin="0,0,0,15" BorderBrush="#E2E8F0" BorderThickness="1">
                        <DockPanel LastChildFill="False">
                            <!-- Bộ lọc trạng thái -->
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <RadioButton Content="Tất cả" GroupName="PoStatus" Margin="0,0,14,0" FontWeight="SemiBold"
                                             IsChecked="{Binding FilterPoStatus, Converter={x:Null}, Mode=OneWay}" Click="FilterPoStatus_Click" Tag="ALL"/>
                                <RadioButton Content="📤 Đã đặt hàng" GroupName="PoStatus" Margin="0,0,14,0" FontWeight="SemiBold"
                                             Click="FilterPoStatus_Click" Tag="ORDERED"/>
                                <RadioButton Content="⏳ Mới nhận 1 phần" GroupName="PoStatus" Margin="0,0,14,0" FontWeight="SemiBold"
                                             Click="FilterPoStatus_Click" Tag="PARTIALLY_RECEIVED"/>
                                <RadioButton Content="✅ Hoàn tất nhận đủ" GroupName="PoStatus" Margin="0,0,14,0" FontWeight="SemiBold"
                                             Click="FilterPoStatus_Click" Tag="COMPLETED"/>
                            </StackPanel>

                            <!-- Tìm kiếm & Nút lập PO -->
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBox Width="240" Height="34" VerticalContentAlignment="Center" Padding="8,0" Margin="0,0,12,0"
                                         Text="{Binding PoSearchKeyword, UpdateSourceTrigger=PropertyChanged}"
                                         Tag="🔍 Tìm mã PO, NCC, Chi nhánh..."/>

                                <Button Content="➕ Lập Đơn Đặt Hàng PO Mới" Padding="16,8" Background="#2563EB" Foreground="White"
                                        FontWeight="Bold" FontSize="13" BorderThickness="0" Cursor="Hand" Click="CreatePoButton_Click"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <!-- Bảng Đơn PO (Chia 2 cột: Danh sách & Chi tiết) -->
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="6*" />
                            <ColumnDefinition Width="4*" />
                        </Grid.ColumnDefinitions>

                        <!-- Cột Trái: Danh sách đơn PO -->
                        <Border Grid.Column="0" Background="White" CornerRadius="12" Padding="16" Margin="0,0,12,0" BorderBrush="#E2E8F0" BorderThickness="1">
                            <DataGrid ItemsSource="{Binding PurchaseOrders}" SelectedItem="{Binding SelectedPurchaseOrder, Mode=TwoWay}"
                                      AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                                      GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#F1F5F9"
                                      HeadersVisibility="Column" Background="White" RowHeight="44" BorderThickness="0">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="MÃ PO" Binding="{Binding PoCode}" Width="130">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="FontWeight" Value="Bold"/>
                                                <Setter Property="Foreground" Value="#2563EB"/>
                                                <Setter Property="VerticalAlignment" Value="Center"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>

                                    <DataGridTextColumn Header="NHÀ CUNG CẤP" Binding="{Binding SupplierName}" Width="*">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                                <Setter Property="Foreground" Value="#1E293B"/>
                                                <Setter Property="VerticalAlignment" Value="Center"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>

                                    <DataGridTextColumn Header="TỔNG TIỀN" Binding="{Binding TotalAmount, StringFormat='{}{0:N0} đ'}" Width="110">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="FontWeight" Value="Bold"/>
                                                <Setter Property="Foreground" Value="#0284C7"/>
                                                <Setter Property="VerticalAlignment" Value="Center"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>

                                    <DataGridTextColumn Header="TIẾN ĐỘ" Binding="{Binding ReceivedPercent, StringFormat='{}{0:N0}%'}" Width="75">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                                <Setter Property="VerticalAlignment" Value="Center"/>
                                                <Setter Property="FontWeight" Value="Bold"/>
                                                <Setter Property="Foreground" Value="#D97706"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>

                                    <DataGridTemplateColumn Header="TRẠNG THÁI" Width="135">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border CornerRadius="6" Padding="8,4" HorizontalAlignment="Center" Background="#F1F5F9">
                                                    <TextBlock Text="{Binding StatusBadge}" FontWeight="Bold" FontSize="11" Foreground="{Binding StatusColor}"/>
                                                </Border>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Border>

                        <!-- Cột Phải: Thẻ Chi Tiết PO Đang Chọn -->
                        <Border Grid.Column="1" Background="White" CornerRadius="12" Padding="18" BorderBrush="#E2E8F0" BorderThickness="1">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <!-- Header chi tiết -->
                                <DockPanel Grid.Row="0" Margin="0,0,0,10">
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding SelectedPurchaseOrder.PoCode, StringFormat='CHI TIẾT ĐƠN {0}'}" FontWeight="Bold" FontSize="14" Foreground="#1E293B"/>
                                        <TextBlock Text="{Binding SelectedPurchaseOrder.OrderDate, StringFormat='Ngày đặt: {0:dd/MM/yyyy HH:mm}'}" FontSize="11" Foreground="#64748B"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding SelectedPurchaseOrder.StatusBadge}" DockPanel.Dock="Right" FontWeight="Bold" Foreground="{Binding SelectedPurchaseOrder.StatusColor}" VerticalAlignment="Center"/>
                                </DockPanel>

                                <!-- Thông tin chi nhánh & người lập -->
                                <Border Grid.Row="1" Background="#F8FAFC" CornerRadius="8" Padding="12,8" Margin="0,0,0,10" BorderBrush="#E2E8F0" BorderThickness="1">
                                    <StackPanel>
                                        <TextBlock Text="{Binding SelectedPurchaseOrder.BranchName, StringFormat='🏬 Nơi nhận: {0}'}" FontSize="11" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,3"/>
                                        <TextBlock Text="{Binding SelectedPurchaseOrder.CreatedByName, StringFormat='👤 Người lập: {0}'}" FontSize="11" Foreground="#64748B" Margin="0,0,0,3"/>
                                        <TextBlock Text="{Binding SelectedPurchaseOrder.Note, StringFormat='📝 Ghi chú: {0}'}" FontSize="11" Foreground="#64748B" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>

                                <!-- Danh sách món trong PO -->
                                <DataGrid Grid.Row="2" ItemsSource="{Binding SelectedPurchaseOrder.Details}"
                                          AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                                          GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#F1F5F9"
                                          HeadersVisibility="Column" Background="White" RowHeight="32" BorderThickness="1" BorderBrush="#E2E8F0">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="MẶT HÀNG" Binding="{Binding IngredientName}" Width="*"/>
                                        <DataGridTextColumn Header="ĐẶT" Binding="{Binding OrderedQuantity, StringFormat='{}{0:N1}'}" Width="60"/>
                                        <DataGridTextColumn Header="ĐÃ NHẬN" Binding="{Binding ReceivedQuantity, StringFormat='{}{0:N1}'}" Width="65">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="FontWeight" Value="Bold"/>
                                                    <Setter Property="Foreground" Value="#16A34A"/>
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>
                                        <DataGridTextColumn Header="ĐVT" Binding="{Binding Uom}" Width="45"/>
                                        <DataGridTextColumn Header="THÀNH TIỀN" Binding="{Binding SubTotal, StringFormat='{}{0:N0} đ'}" Width="90"/>
                                    </DataGrid.Columns>
                                </DataGrid>

                                <!-- Actions nút In & Hủy -->
                                <Border Grid.Row="3" Margin="0,12,0,0" Padding="0,10,0,0" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Button Content="❌ Hủy Đơn" Padding="12,6" Background="#FEE2E2" Foreground="#DC2626" FontWeight="Bold"
                                                BorderThickness="0" Margin="0,0,8,0" Cursor="Hand" Click="CancelPoButton_Click"/>
                                        <Button Content="🖨️ In Đơn PO" Padding="14,6" Background="#2563EB" Foreground="White" FontWeight="Bold"
                                                BorderThickness="0" Cursor="Hand" Click="PrintPoButton_Click"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- ========================================== -->
            <!-- TAB 3: TIẾP NHẬN HÀNG HÓA 2 BƯỚC (QC)      -->
            <!-- ========================================== -->
            <TabItem Header="📥 Tiếp Nhận Hàng Hóa &amp; QC">
                <Grid Margin="0,15,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" /> <!-- Banner nghiệp vụ -->
                        <RowDefinition Height="4.5*" /> <!-- Bảng đơn PO chờ nhận hàng -->
                        <RowDefinition Height="5.5*" /> <!-- Bảng biên bản nghiệm thu GRN -->
                    </Grid.RowDefinitions>

                    <!-- Banner nghiệp vụ 2 bước -->
                    <Border Grid.Row="0" Background="#EFF6FF" CornerRadius="10" Padding="16,10" Margin="0,0,0,12" BorderBrush="#BFDBFE" BorderThickness="1">
                        <DockPanel>
                            <TextBlock Text="📦 QUY TRÌNH TIẾP NHẬN 2 BƯỚC:" FontWeight="Bold" FontSize="12" Foreground="#1E40AF" VerticalAlignment="Center"/>
                            <TextBlock Text="[Bước 1] Chọn đơn PO bên dưới ➔ Bấm 'Tiếp Nhận &amp; Kiểm Đếm QC' để phân loại Đạt / Tạm Giữ / Trả lại ➔ [Bước 2] Hệ thống tự động ghi sổ kho theo số lượng đạt chuẩn."
                                       FontSize="12" Foreground="#1E3A8A" Margin="10,0,0,0" VerticalAlignment="Center"/>
                        </DockPanel>
                    </Border>

                    <!-- Phần 1: Đơn PO Đang Chờ Tiếp Nhận -->
                    <Border Grid.Row="1" Background="White" CornerRadius="12" Padding="16" Margin="0,0,0,12" BorderBrush="#E2E8F0" BorderThickness="1">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <DockPanel Grid.Row="0" Margin="0,0,0,10">
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="1. ĐƠN ĐẶT HÀNG MUA ĐANG CHỜ XE GIAO TỚI (CẦN TIẾP NHẬN)" FontWeight="Bold" FontSize="13" Foreground="#1E293B"/>
                                    <TextBlock Text="Chỉ hiển thị các đơn đang ở trạng thái 'Đã đặt hàng' hoặc 'Mới nhận 1 phần'" FontSize="11" Foreground="#64748B"/>
                                </StackPanel>

                                <Button Content="📦 Tiếp Nhận &amp; Kiểm Đếm QC" DockPanel.Dock="Right" Padding="16,8"
                                        Background="#16A34A" Foreground="White" FontWeight="Bold" FontSize="13"
                                        BorderThickness="0" Cursor="Hand" Click="StartInspectionButton_Click"/>
                            </DockPanel>

                            <DataGrid Grid.Row="1" ItemsSource="{Binding PendingOrdersForReceipt}" SelectedItem="{Binding SelectedPendingPo, Mode=TwoWay}"
                                      AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                                      GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#F1F5F9"
                                      HeadersVisibility="Column" Background="White" RowHeight="38" BorderThickness="1" BorderBrush="#E2E8F0">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="MÃ PO" Binding="{Binding PoCode}" Width="130">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="FontWeight" Value="Bold"/>
                                                <Setter Property="Foreground" Value="#2563EB"/>
                                                <Setter Property="VerticalAlignment" Value="Center"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="NHÀ CUNG CẤP" Binding="{Binding SupplierName}" Width="*"/>
                                    <DataGridTextColumn Header="CHI NHÁNH NHẬN" Binding="{Binding BranchName}" Width="150"/>
                                    <DataGridTextColumn Header="NGÀY ĐẶT" Binding="{Binding OrderDate, StringFormat='{}{0:dd/MM/yyyy}'}" Width="110"/>
                                    <DataGridTextColumn Header="TIẾN ĐỘ" Binding="{Binding ReceivedPercent, StringFormat='{}{0:N0}%'}" Width="80"/>
                                    <DataGridTextColumn Header="TRẠNG THÁI" Binding="{Binding StatusBadge}" Width="140"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>

                    <!-- Phần 2: Lịch Sử Biên Bản Tiếp Nhận (GRN) -->
                    <Border Grid.Row="2" Background="White" CornerRadius="12" Padding="16" BorderBrush="#E2E8F0" BorderThickness="1">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <DockPanel Grid.Row="0" Margin="0,0,0,10">
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="2. LỊCH SỬ BIÊN BẢN TIẾP NHẬN &amp; NGHIỆM THU HÀNG HÓA (GRN)" FontWeight="Bold" FontSize="13" Foreground="#1E293B"/>
                                    <TextBlock Text="Các đợt giao nhận đã hoàn tất ghi sổ kho thành công" FontSize="11" Foreground="#64748B"/>
                                </StackPanel>

                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Content="🖨️ In Biên Bản Nghiệm Thu (GRN)" Padding="14,8"
                                            Background="#2563EB" Foreground="White" FontWeight="Bold" FontSize="12"
                                            BorderThickness="0" Cursor="Hand" Click="PrintReceiptSlipButton_Click"/>
                                </StackPanel>
                            </DockPanel>

                            <DataGrid Grid.Row="1" ItemsSource="{Binding GoodsReceipts}" SelectedItem="{Binding SelectedReceipt, Mode=TwoWay}"
                                      AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                                      GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#F1F5F9"
                                      HeadersVisibility="Column" Background="White" RowHeight="38" BorderThickness="1" BorderBrush="#E2E8F0">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="MÃ BIÊN BẢN (GRN)" Binding="{Binding ReceiptCode}" Width="140">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="FontWeight" Value="Bold"/>
                                                <Setter Property="Foreground" Value="#16A34A"/>
                                                <Setter Property="VerticalAlignment" Value="Center"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="MÃ ĐƠN PO" Binding="{Binding PoCode}" Width="130"/>
                                    <DataGridTextColumn Header="NHÀ CUNG CẤP" Binding="{Binding SupplierName}" Width="*"/>
                                    <DataGridTextColumn Header="NGƯỜI TIẾP NHẬN" Binding="{Binding ReceivedByName}" Width="140"/>
                                    <DataGridTextColumn Header="NGÀY NHẬN" Binding="{Binding ReceivedDate, StringFormat='{}{0:dd/MM/yyyy HH:mm}'}" Width="140"/>
                                    <DataGridTextColumn Header="TIỀN GHI SỔ" Binding="{Binding TotalAcceptedAmount, StringFormat='{}{0:N0} đ'}" Width="120">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="FontWeight" Value="Bold"/>
                                                <Setter Property="Foreground" Value="#2563EB"/>
                                                <Setter Property="VerticalAlignment" Value="Center"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
