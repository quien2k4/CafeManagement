<Window x:Class="CafeManagement.Wpf.Views.Procurement.SupplierEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Thông Tin Nhà Cung Cấp"
        Height="540" Width="520"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F8FAFC"
        FontFamily="Segoe UI">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock x:Name="TxtTitle" Text="🏢 THÔNG TIN NHÀ CUNG CẤP" FontWeight="Bold" FontSize="16" Foreground="#1E293B" Margin="0,0,0,16"/>

        <!-- Form fields -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- Mã & Tên NCC -->
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="130" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,10,0">
                        <TextBlock Text="MÃ NCC (*)" FontWeight="Bold" FontSize="11" Foreground="#475569" Margin="0,0,0,4"/>
                        <TextBox x:Name="TxtCode" Height="34" VerticalContentAlignment="Center" Padding="8,0" Text="NCC-01"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1">
                        <TextBlock Text="TÊN NHÀ CUNG CẤP (*)" FontWeight="Bold" FontSize="11" Foreground="#475569" Margin="0,0,0,4"/>
                        <TextBox x:Name="TxtName" Height="34" VerticalContentAlignment="Center" Padding="8,0"/>
                    </StackPanel>
                </Grid>

                <!-- Người liên hệ & SĐT -->
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,10,0">
                        <TextBlock Text="NGƯỜI LIÊN HỆ" FontWeight="Bold" FontSize="11" Foreground="#475569" Margin="0,0,0,4"/>
                        <TextBox x:Name="TxtContact" Height="34" VerticalContentAlignment="Center" Padding="8,0"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1">
                        <TextBlock Text="SỐ ĐIỆN THOẠI" FontWeight="Bold" FontSize="11" Foreground="#475569" Margin="0,0,0,4"/>
                        <TextBox x:Name="TxtPhone" Height="34" VerticalContentAlignment="Center" Padding="8,0"/>
                    </StackPanel>
                </Grid>

                <!-- Email & MST -->
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,10,0">
                        <TextBlock Text="EMAIL" FontWeight="Bold" FontSize="11" Foreground="#475569" Margin="0,0,0,4"/>
                        <TextBox x:Name="TxtEmail" Height="34" VerticalContentAlignment="Center" Padding="8,0"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1">
                        <TextBlock Text="MÃ SỐ THUẾ" FontWeight="Bold" FontSize="11" Foreground="#475569" Margin="0,0,0,4"/>
                        <TextBox x:Name="TxtTaxCode" Height="34" VerticalContentAlignment="Center" Padding="8,0"/>
                    </StackPanel>
                </Grid>

                <!-- Địa chỉ -->
                <StackPanel Margin="0,0,0,12">
                    <TextBlock Text="ĐỊA CHỈ TRỤ SỞ / KHO" FontWeight="Bold" FontSize="11" Foreground="#475569" Margin="0,0,0,4"/>
                    <TextBox x:Name="TxtAddress" Height="34" VerticalContentAlignment="Center" Padding="8,0"/>
                </StackPanel>

                <!-- Ghi chú -->
                <StackPanel Margin="0,0,0,12">
                    <TextBlock Text="GHI CHÚ / ĐẶC ĐIỂM CUNG ỨNG" FontWeight="Bold" FontSize="11" Foreground="#475569" Margin="0,0,0,4"/>
                    <TextBox x:Name="TxtNote" Height="50" TextWrapping="Wrap" AcceptsReturn="True" Padding="8,4"/>
                </StackPanel>

                <!-- Trạng thái -->
                <CheckBox x:Name="ChkIsActive" Content="Đang duy trì hợp tác cung ứng" IsChecked="True" FontWeight="SemiBold" Margin="0,4,0,0"/>
            </StackPanel>
        </ScrollViewer>

        <!-- Actions -->
        <Border Grid.Row="2" Margin="0,16,0,0" Padding="0,12,0,0" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Hủy Bỏ" Width="100" Height="36" Background="#E2E8F0" Foreground="#475569" FontWeight="Bold"
                        BorderThickness="0" Margin="0,0,10,0" Cursor="Hand" Click="CancelButton_Click"/>
                <Button Content="💾 Lưu Thông Tin" Width="130" Height="36" Background="#2563EB" Foreground="White" FontWeight="Bold"
                        BorderThickness="0" Cursor="Hand" Click="SaveButton_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
