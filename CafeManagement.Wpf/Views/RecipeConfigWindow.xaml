<Window x:Class="CafeManagement.Wpf.Views.RecipeConfigWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Cài Đặt Công Thức Pha Chế (BOM/Recipe)" 
        Height="620" Width="560"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F8F9FA"
        FontFamily="Segoe UI">

    <Grid Margin="25,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="White" CornerRadius="10" Padding="15" Margin="0,0,0,15" BorderBrush="#E9ECEF" BorderThickness="1">
            <DockPanel>
                <StackPanel DockPanel.Dock="Left">
                    <TextBlock Name="TxtProductTitle" Text="⚙️ ĐỊNH MỨC CÔNG THỨC (BOM)" FontWeight="Bold" FontSize="16" Foreground="#2C3E50"/>
                    <TextBlock Text="Khi bán món này ở POS, kho sẽ tự động trừ các nguyên liệu này" FontSize="12" Foreground="#7F8C8D" Margin="0,3,0,0"/>
                </StackPanel>

                <!-- Chọn kích cỡ Size M / Size L -->
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Kích cỡ:" FontWeight="Bold" FontSize="13" Foreground="#495057" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <ComboBox Name="CboSize" Width="100" Height="36" FontSize="13" FontWeight="Bold" VerticalContentAlignment="Center" SelectionChanged="CboSize_SelectionChanged">
                        <ComboBoxItem Content="Size M" IsSelected="True"/>
                        <ComboBoxItem Content="Size L"/>
                    </ComboBox>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Body: Danh sách nguyên liệu & Form thêm nguyên liệu -->
        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Bảng danh sách nguyên liệu trong công thức -->
            <Border Grid.Row="0" Background="White" CornerRadius="10" Padding="15" Margin="0,0,0,15" BorderBrush="#E9ECEF" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" Margin="0,0,0,10">
                        <TextBlock Text="📋 Các nguyên liệu tiêu hao cho 1 ly:" FontWeight="Bold" FontSize="13" Foreground="#2C3E50"/>
                        <TextBlock Name="TxtCount" Text="(0 nguyên liệu)" FontSize="12" Foreground="#7F8C8D" HorizontalAlignment="Right"/>
                    </DockPanel>

                    <!-- Danh sách items -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ItemsControl Name="LstRecipeItems">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,0,0,8" Padding="12,8" Background="#F8F9FA" CornerRadius="6" BorderBrush="#EEEEEE" BorderThickness="1">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="40" />
                                            </Grid.ColumnDefinitions>

                                            <!-- Tên nguyên liệu -->
                                            <TextBlock Grid.Column="0" Text="{Binding IngredientName}" FontWeight="Bold" FontSize="13" Foreground="#2C3E50" VerticalAlignment="Center"/>

                                            <!-- Định lượng -->
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0">
                                                <TextBlock Text="{Binding Quantity, StringFormat='{}{0:N1}'}" FontWeight="Bold" FontSize="14" Foreground="#E65100"/>
                                                <TextBlock Text="{Binding Uom}" FontSize="12" Foreground="#7F8C8D" Margin="4,0,0,0" VerticalAlignment="Bottom"/>
                                            </StackPanel>

                                            <!-- Nút xóa nguyên liệu -->
                                            <Button Grid.Column="2" Content="❌" Click="RemoveIngredient_Click" Tag="{Binding}" 
                                                    Width="30" Height="30" Background="#FDEDEC" Foreground="#C0392B" FontSize="11" FontWeight="Bold" BorderThickness="0" Cursor="Hand">
                                                <Button.Resources>
                                                    <Style TargetType="Border">
                                                        <Setter Property="CornerRadius" Value="4"/>
                                                    </Style>
                                                </Button.Resources>
                                            </Button>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- Khung thêm nguyên liệu mới vào công thức -->
            <Border Grid.Row="1" Background="White" CornerRadius="10" Padding="15" BorderBrush="#E9ECEF" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="➕ Thêm nguyên liệu vào công thức này:" FontWeight="Bold" FontSize="13" Foreground="#2C3E50" Margin="0,0,0,8"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Chọn nguyên liệu -->
                        <ComboBox Name="CboAvailableIngredients" Grid.Column="0" DisplayMemberPath="IngredientName" Height="38" FontSize="13" VerticalContentAlignment="Center" Margin="0,0,10,0" SelectionChanged="CboAvailableIngredients_SelectionChanged"/>

                        <!-- Nhập số lượng -->
                        <DockPanel Grid.Column="1" Margin="0,0,10,0">
                            <TextBlock Name="TxtIngredientUom" Text="g" DockPanel.Dock="Right" FontWeight="Bold" FontSize="13" Foreground="#E65100" VerticalAlignment="Center" Margin="6,0,0,0"/>
                            <TextBox Name="TxtIngredientQty" Text="20" Height="38" FontSize="14" FontWeight="Bold" Padding="6,0" VerticalContentAlignment="Center" TextAlignment="Right"/>
                        </DockPanel>

                        <!-- Nút thêm -->
                        <Button Grid.Column="2" Content="+ Thêm" Click="AddIngredient_Click" Height="38" Padding="14,0" Background="#FFA726" Foreground="White" FontWeight="Bold" FontSize="13" BorderThickness="0" Cursor="Hand">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="6"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Footer Buttons -->
        <Grid Grid.Row="2" Margin="0,15,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="120" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0" Content="Đóng" Click="Cancel_Click" Height="44" Margin="0,0,10,0" Background="#EDF2F7" FontWeight="Bold" BorderThickness="0" Cursor="Hand">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="6"/>
                    </Style>
                </Button.Resources>
            </Button>
            <Button Grid.Column="1" Content="LƯU CÔNG THỨC PHA CHẾ (BOM)" Click="SaveRecipe_Click" Height="44" Background="#27AE60" Foreground="White" FontWeight="Bold" FontSize="14" BorderThickness="0" Cursor="Hand">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="6"/>
                    </Style>
                </Button.Resources>
            </Button>
        </Grid>
    </Grid>
</Window>
