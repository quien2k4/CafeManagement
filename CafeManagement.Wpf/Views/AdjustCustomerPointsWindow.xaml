<Window x:Class="CafeManagement.Wpf.Views.AdjustCustomerPointsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cộng / Trừ Điểm Thành Viên" Height="460" Width="450"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="#F8F9FA" FontFamily="Segoe UI">
    <Grid Margin="25">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Tiêu đề -->
        <Border Grid.Row="0" Background="White" CornerRadius="8" Padding="15,12" Margin="0,0,0,15" BorderBrush="#E8ECEF" BorderThickness="1">
            <StackPanel>
                <TextBlock Text="⭐ ĐIỀU CHỈNH ĐIỂM &amp; HẠNG THÀNH VIÊN" FontWeight="Bold" FontSize="16" Foreground="#2C3E50"/>
                <TextBlock x:Name="TxtSubtitle" Text="Cộng hoặc trừ điểm thưởng cho khách hàng" FontSize="11" Foreground="#7F8C8D" Margin="0,3,0,0"/>
            </StackPanel>
        </Border>

        <!-- Form nhập -->
        <Border Grid.Row="1" Background="White" CornerRadius="8" Padding="20" BorderBrush="#E8ECEF" BorderThickness="1">
            <StackPanel>
                <!-- Khách hàng -->
                <Border Background="#F1F3F5" CornerRadius="6" Padding="12" Margin="0,0,0,15">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock x:Name="TxtCustomerName" Text="Nguyễn Văn A" FontWeight="Bold" FontSize="14" Foreground="#2C3E50"/>
                            <TextBlock x:Name="TxtCustomerPhone" Text="SĐT: 0901234567" FontSize="11" Foreground="#7F8C8D" Margin="0,2,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <TextBlock Text="Điểm hiện tại:" FontSize="11" Foreground="#7F8C8D" HorizontalAlignment="Right"/>
                            <TextBlock x:Name="TxtCurrentPoints" Text="140 điểm" FontWeight="Bold" FontSize="15" Foreground="#2980B9" HorizontalAlignment="Right"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Số điểm thay đổi -->
                <TextBlock Text="Số điểm cần thay đổi (+ cộng thêm, - trừ bớt):" FontWeight="SemiBold" FontSize="12" Foreground="#2C3E50" Margin="0,0,0,5"/>
                <TextBox x:Name="TxtPointDelta" Height="38" Padding="10,0" VerticalContentAlignment="Center"
                         FontSize="14" FontWeight="Bold" BorderBrush="#BDC3C7" Text="+50" Margin="0,0,0,15"/>

                <!-- Hạng thành viên -->
                <TextBlock Text="Hạng thẻ thành viên:" FontWeight="SemiBold" FontSize="12" Foreground="#2C3E50" Margin="0,0,0,5"/>
                <ComboBox x:Name="CboTier" Height="38" FontSize="13" VerticalContentAlignment="Center">
                    <ComboBoxItem Content="🥉 Hạng Đồng (Chuẩn)" Tag="BRONZE"/>
                    <ComboBoxItem Content="🥈 Hạng Bạc (Giảm 5%)" Tag="SILVER"/>
                    <ComboBoxItem Content="🥇 Hạng Vàng (Giảm 10%)" Tag="GOLD"/>
                    <ComboBoxItem Content="💎 Hạng Kim Cương (Giảm 15%)" Tag="DIAMOND"/>
                </ComboBox>
            </StackPanel>
        </Border>

        <!-- Nút thao tác -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button Content="Hủy bỏ" Click="Cancel_Click" Width="100" Height="40" Background="#95A5A6" Foreground="White"
                    FontWeight="SemiBold" FontSize="13" BorderThickness="0" Margin="0,0,10,0" Cursor="Hand">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="6"/>
                    </Style>
                </Button.Resources>
            </Button>

            <Button Content="⭐ Xác Nhận Lưu" Click="Save_Click" Width="150" Height="40" Background="#E67E22" Foreground="White"
                    FontWeight="Bold" FontSize="13" BorderThickness="0" Cursor="Hand">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="6"/>
                    </Style>
                </Button.Resources>
            </Button>
        </StackPanel>
    </Grid>
</Window>