<Window x:Class="CafeManagement.Wpf.Views.Inventory.ReconcileTransferWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Kiểm Đếm &amp; Đối Soát Sai Lệch Điều Chuyển"
        Height="560" Width="820"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F8FAFC"
        FontFamily="Segoe UI">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /> <!-- Header thông tin phiếu -->
            <RowDefinition Height="*" />    <!-- Bảng kiểm đếm chi tiết -->
            <RowDefinition Height="Auto" /> <!-- Ghi chú đối soát -->
            <RowDefinition Height="Auto" /> <!-- Nút hành động -->
        </Grid.RowDefinitions>

        <!-- 1. Header: Thông tin phiếu điều chuyển -->
        <Border Grid.Row="0" Background="White" CornerRadius="10" Padding="16,14" Margin="0,0,0,15" BorderBrush="#E2E8F0" BorderThickness="1">
            <DockPanel>
                <StackPanel DockPanel.Dock="Left">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="📦 KIỂM ĐẾM &amp; ĐỐI SOÁT PHIẾU: " FontWeight="Bold" FontSize="15" Foreground="#1E293B"/>
                        <TextBlock x:Name="TxtTransferCode" Text="TRF-..." FontWeight="Bold" FontSize="15" Foreground="#2563EB"/>
                    </StackPanel>
                    <TextBlock x:Name="TxtRoute" Text="Từ: Chi nhánh A ➔ Đến: Chi nhánh B" FontSize="12" Foreground="#64748B" Margin="0,3,0,0"/>
                </StackPanel>

                <Border DockPanel.Dock="Right" Background="#FEF3C7" CornerRadius="8" Padding="10,6" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock Text="⚠️ Nhập đúng số lượng thực tế nhận được để hệ thống tự động tính sai lệch" FontSize="11" FontWeight="SemiBold" Foreground="#D97706"/>
                </Border>
            </DockPanel>
        </Border>

        <!-- 2. Bảng kiểm đếm song song: Xuất đi vs Thực nhận vs Chênh lệch -->
        <Border Grid.Row="1" Background="White" CornerRadius="10" Padding="12" Margin="0,0,0,15" BorderBrush="#E2E8F0" BorderThickness="1">
            <DataGrid x:Name="GridItems" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                      HeadersVisibility="Column" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#F1F5F9"
                      RowHeight="44" Background="White" BorderThickness="0" SelectionMode="Single">
                <DataGrid.Columns>
                    <!-- Nguyên liệu -->
                    <DataGridTextColumn Header="Nguyên Liệu" Binding="{Binding IngredientName}" Width="2*" IsReadOnly="True" FontWeight="Bold"/>
                    
                    <!-- ĐVT -->
                    <DataGridTextColumn Header="ĐVT" Binding="{Binding Uom}" Width="60" IsReadOnly="True" Foreground="#64748B"/>

                    <!-- Số lượng xuất đi -->
                    <DataGridTextColumn Header="Xuất Đi" Binding="{Binding DispatchedQuantity, StringFormat='{}{0:N1}'}" Width="80" IsReadOnly="True" FontWeight="SemiBold" Foreground="#475569"/>

                    <!-- Ô nhập: Số lượng thực nhận -->
                    <DataGridTemplateColumn Header="Thực Nhận (*)" Width="120">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBox Text="{Binding ReceivedQuantity, UpdateSourceTrigger=PropertyChanged, StringFormat='{}{0:G29}'}"
                                         FontWeight="Bold" FontSize="13" Foreground="#0F172A" Padding="6,2" VerticalContentAlignment="Center"
                                         BorderBrush="#CBD5E1" BorderThickness="1" TextAlignment="Right"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Chênh lệch -->
                    <DataGridTemplateColumn Header="Chênh Lệch" Width="95">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border CornerRadius="4" Padding="6,2" HorizontalAlignment="Center">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#F1F5F9"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding DiscrepancyQuantity}" Value="0">
                                                    <Setter Property="Background" Value="#DCFCE7"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding DiscrepancyQuantity, StringFormat='{}{0:+#,##0.###;-#,##0.###;0}'}" FontWeight="Bold" FontSize="12">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="#DC2626"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding DiscrepancyQuantity}" Value="0">
                                                        <Setter Property="Foreground" Value="#16A34A"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Lý do nếu có sai lệch -->
                    <DataGridTemplateColumn Header="Lý Do Sai Lệch (Nếu có)" Width="2.2*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBox Text="{Binding DiscrepancyReason, UpdateSourceTrigger=PropertyChanged}"
                                         Padding="6,2" VerticalContentAlignment="Center" FontSize="12"
                                         BorderBrush="#E2E8F0" BorderThickness="1"
                                         ToolTip="Ví dụ: Vỡ 1 chai khi vận chuyển, giao thiếu 200g..."/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- 3. Ghi chú đối soát chung -->
        <StackPanel Grid.Row="2" Margin="0,0,0,15">
            <TextBlock Text="Biên bản / Ghi chú đối soát kiểm đếm:" FontSize="11" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,4"/>
            <TextBox x:Name="TxtReconciliationNote" Height="38" Padding="8,4" FontSize="12" BorderBrush="#CBD5E1"
                     VerticalContentAlignment="Center" Text="Đã nhận hàng và kiểm đếm thực tế."/>
        </StackPanel>

        <!-- 4. Nút bấm xác nhận & hủy -->
        <DockPanel Grid.Row="3">
            <TextBlock Text="💡 Tồn kho chi nhánh nhận sẽ được cộng chính xác theo cột 'Thực Nhận'" FontSize="11" Foreground="#64748B" VerticalAlignment="Center"/>

            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Hủy bỏ" Click="BtnCancel_Click"
                        Width="100" Height="36" Background="#F1F5F9" Foreground="#475569" FontWeight="SemiBold" BorderThickness="0" Cursor="Hand" Margin="0,0,10,0">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="6"/>
                        </Style>
                    </Button.Resources>
                </Button>

                <Button Content="✅ Xác Nhận Nhập Kho &amp; Đối Soát" Click="BtnConfirm_Click"
                        Padding="16,0" Height="36" Background="#16A34A" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="6"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
