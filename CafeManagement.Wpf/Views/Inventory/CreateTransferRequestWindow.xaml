<Window x:Class="CafeManagement.Wpf.Views.Inventory.CreateTransferRequestWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Tạo Yêu Cầu Điều Chuyển Nguyên Liệu Liên Chi Nhánh"
        Height="620" Width="760"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F8FAFC"
        FontFamily="Segoe UI">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /> <!-- Chọn Chi nhánh Nguồn & Đích -->
            <RowDefinition Height="Auto" /> <!-- Chọn nguyên liệu & số lượng -->
            <RowDefinition Height="*" />    <!-- Danh sách nguyên liệu đã thêm -->
            <RowDefinition Height="Auto" /> <!-- Lý do yêu cầu -->
            <RowDefinition Height="Auto" /> <!-- Nút hành động -->
        </Grid.RowDefinitions>

        <!-- 1. Chọn Chi nhánh Nguồn & Đích -->
        <Border Grid.Row="0" Background="White" CornerRadius="10" Padding="16,14" Margin="0,0,0,15" BorderBrush="#E2E8F0" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="40" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Chi nhánh Nguồn (Nơi xuất cấp hàng) -->
                <StackPanel Grid.Column="0">
                    <TextBlock Text="🏢 CHI NHÁNH XUẤT HÀNG (NGUỒN) (*)" FontWeight="Bold" FontSize="11" Foreground="#475569" Margin="0,0,0,4"/>
                    <ComboBox x:Name="CboFromBranch" Height="36" FontSize="12" DisplayMemberPath="BranchName" SelectedValuePath="BranchId"
                              VerticalContentAlignment="Center" BorderBrush="#CBD5E1"/>
                    <TextBlock Text="Chi nhánh cung cấp / cho mượn hàng" FontSize="10" Foreground="#94A3B8" Margin="0,2,0,0"/>
                </StackPanel>

                <!-- Mũi tên chuyển -->
                <TextBlock Grid.Column="1" Text="➔" FontSize="20" FontWeight="Bold" Foreground="#2563EB"
                           HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,5,0,0"/>

                <!-- Chi nhánh Đích (Nơi nhận hàng) -->
                <StackPanel Grid.Column="2">
                    <TextBlock Text="🏬 CHI NHÁNH NHẬN HÀNG (ĐÍCH) (*)" FontWeight="Bold" FontSize="11" Foreground="#475569" Margin="0,0,0,4"/>
                    <ComboBox x:Name="CboToBranch" Height="36" FontSize="12" DisplayMemberPath="BranchName" SelectedValuePath="BranchId"
                              VerticalContentAlignment="Center" BorderBrush="#CBD5E1"/>
                    <TextBlock Text="Chi nhánh thiếu nguyên liệu cần nhận" FontSize="10" Foreground="#94A3B8" Margin="0,2,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 2. Thêm nguyên liệu vào danh sách -->
        <Border Grid.Row="1" Background="White" CornerRadius="10" Padding="16,12" Margin="0,0,0,15" BorderBrush="#E2E8F0" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2.5*" />
                    <ColumnDefinition Width="1.2*" />
                    <ColumnDefinition Width="100" />
                </Grid.ColumnDefinitions>

                <!-- Chọn nguyên liệu -->
                <StackPanel Grid.Column="0" Margin="0,0,12,0">
                    <TextBlock Text="Chọn nguyên liệu cần chuyển (*):" FontSize="11" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,4"/>
                    <ComboBox x:Name="CboIngredient" Height="34" FontSize="12" DisplayMemberPath="IngredientName"
                              VerticalContentAlignment="Center" SelectionChanged="CboIngredient_SelectionChanged" BorderBrush="#CBD5E1"/>
                </StackPanel>

                <!-- Nhập số lượng -->
                <StackPanel Grid.Column="1" Margin="0,0,12,0">
                    <DockPanel Margin="0,0,0,4">
                        <TextBlock Text="Số lượng (*):" FontSize="11" FontWeight="SemiBold" Foreground="#475569"/>
                        <TextBlock x:Name="TxtUom" Text="(ĐVT: g)" FontSize="11" Foreground="#2563EB" FontWeight="Bold" HorizontalAlignment="Right"/>
                    </DockPanel>
                    <TextBox x:Name="TxtQuantity" Height="34" FontSize="13" FontWeight="Bold" Padding="8,4"
                             VerticalContentAlignment="Center" BorderBrush="#CBD5E1"/>
                </StackPanel>

                <!-- Nút thêm -->
                <Button Grid.Column="2" Content="+ Thêm Vào" Click="BtnAddItem_Click"
                        Height="34" Background="#2563EB" Foreground="White" FontWeight="Bold" FontSize="11"
                        BorderThickness="0" Cursor="Hand" VerticalAlignment="Bottom">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="6"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </Grid>
        </Border>

        <!-- 3. Bảng danh sách nguyên liệu đã thêm -->
        <Border Grid.Row="2" Background="White" CornerRadius="10" Padding="12" Margin="0,0,0,15" BorderBrush="#E2E8F0" BorderThickness="1">
            <DataGrid x:Name="GridAddedItems" AutoGenerateColumns="False" CanUserAddRows="False"
                      HeadersVisibility="Column" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#F1F5F9"
                      RowHeight="40" Background="White" BorderThickness="0" SelectionMode="Single">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Mã NL" Binding="{Binding IngredientCode}" Width="90" IsReadOnly="True" Foreground="#64748B"/>
                    <DataGridTextColumn Header="Tên Nguyên Liệu" Binding="{Binding IngredientName}" Width="*" IsReadOnly="True" FontWeight="Bold"/>
                    <DataGridTextColumn Header="Số Lượng Chuyển" Binding="{Binding Quantity, StringFormat='{}{0:N1}'}" Width="140" IsReadOnly="True" FontWeight="Bold" Foreground="#2563EB"/>
                    <DataGridTextColumn Header="Đơn Vị Tính" Binding="{Binding Uom}" Width="100" IsReadOnly="True" Foreground="#475569"/>
                    <DataGridTemplateColumn Header="Thao tác" Width="80">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="✖ Xóa" Click="BtnRemoveItem_Click"
                                        Background="#FEE2E2" Foreground="#DC2626" FontWeight="SemiBold" FontSize="10"
                                        Padding="6,2" BorderThickness="0" Cursor="Hand" HorizontalAlignment="Center"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- 4. Lý do / Ghi chú yêu cầu -->
        <StackPanel Grid.Row="3" Margin="0,0,0,15">
            <TextBlock Text="Lý do điều chuyển / Ghi chú:" FontSize="11" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,4"/>
            <TextBox x:Name="TxtNote" Height="36" Padding="8,4" FontSize="12" BorderBrush="#CBD5E1" VerticalContentAlignment="Center"
                     Text="Thiếu nguyên liệu pha chế, xin điều chuyển hỗ trợ."/>
        </StackPanel>

        <!-- 5. Footer: Nút hành động -->
        <DockPanel Grid.Row="4">
            <TextBlock x:Name="TxtItemCount" Text="Đã chọn: 0 nguyên liệu" FontSize="12" FontWeight="SemiBold" Foreground="#475569" VerticalAlignment="Center"/>

            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Hủy bỏ" Click="BtnCancel_Click"
                        Width="100" Height="36" Background="#F1F5F9" Foreground="#475569" FontWeight="SemiBold" BorderThickness="0" Cursor="Hand" Margin="0,0,10,0">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="6"/>
                        </Style>
                    </Button.Resources>
                </Button>

                <Button Content="🚀 Gửi Yêu Cầu Điều Chuyển" Click="BtnSubmit_Click"
                        Padding="16,0" Height="36" Background="#2563EB" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="6"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
