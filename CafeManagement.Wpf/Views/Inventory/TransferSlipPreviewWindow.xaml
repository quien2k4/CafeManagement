<Window x:Class="CafeManagement.Wpf.Views.Inventory.TransferSlipPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Biên Bản Điều Chuyển &amp; Đối Soát Nguyên Liệu"
        Height="700" Width="800"
        WindowStartupLocation="CenterOwner"
        Background="#F1F5F9"
        FontFamily="Segoe UI">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Khung giấy A4 trắng giả lập in ấn -->
        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <Border x:Name="PrintArea" Background="White" CornerRadius="8" Padding="35" BorderBrush="#CBD5E1" BorderThickness="1">
                <StackPanel>
                    <!-- Tiêu đề công ty & Mã phiếu -->
                    <DockPanel Margin="0,0,0,15">
                        <StackPanel DockPanel.Dock="Left">
                            <TextBlock Text="☕ HỆ THỐNG CAFE MANAGEMENT" FontWeight="Bold" FontSize="16" Foreground="#1E293B"/>
                            <TextBlock Text="CHUỖI CỬA HÀNG &amp; KHO TRUNG TÂM" FontSize="11" Foreground="#64748B"/>
                        </StackPanel>
                        <StackPanel DockPanel.Dock="Right" HorizontalAlignment="Right">
                            <TextBlock x:Name="TxtTransferCode" Text="MÃ PHIẾU: TRF-..." FontWeight="Bold" FontSize="14" Foreground="#2563EB" HorizontalAlignment="Right"/>
                            <TextBlock x:Name="TxtTransferDate" Text="Ngày lập: 21/11/2026 16:30" FontSize="11" Foreground="#64748B" HorizontalAlignment="Right"/>
                        </StackPanel>
                    </DockPanel>

                    <Separator Background="#E2E8F0" Margin="0,0,0,15"/>

                    <!-- Tên biên bản chính -->
                    <TextBlock Text="PHIẾU ĐIỀU CHUYỂN &amp; BIÊN BẢN ĐỐI SOÁT NGUYÊN LIỆU" 
                               FontWeight="Bold" FontSize="16" Foreground="#0F172A" HorizontalAlignment="Center" Margin="0,0,0,15"/>

                    <!-- Thông tin lộ trình điều chuyển -->
                    <Border Background="#F8FAFC" CornerRadius="8" Padding="14,10" Margin="0,0,0,15" BorderBrush="#E2E8F0" BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock x:Name="TxtFromBranch" Text="🏢 Chi nhánh xuất: Chi nhánh A" FontWeight="Bold" FontSize="12" Foreground="#334155"/>
                                <TextBlock x:Name="TxtDispatchedBy" Text="Người xuất kho: Admin" FontSize="11" Foreground="#64748B" Margin="0,2,0,0"/>
                                <TextBlock x:Name="TxtDispatchedDate" Text="Thời gian xuất: ..." FontSize="11" Foreground="#64748B" Margin="0,2,0,0"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1">
                                <TextBlock x:Name="TxtToBranch" Text="🏬 Chi nhánh nhận: Chi nhánh B" FontWeight="Bold" FontSize="12" Foreground="#334155"/>
                                <TextBlock x:Name="TxtReceivedBy" Text="Người kiểm đếm nhận: ..." FontSize="11" Foreground="#64748B" Margin="0,2,0,0"/>
                                <TextBlock x:Name="TxtReceivedDate" Text="Thời gian nhận: ..." FontSize="11" Foreground="#64748B" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Trạng thái & Lý do -->
                    <DockPanel Margin="0,0,0,12">
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                            <TextBlock Text="Trạng thái: " FontWeight="SemiBold" FontSize="12" Foreground="#475569"/>
                            <TextBlock x:Name="TxtStatus" Text="ĐÃ NHẬN ĐỦ" FontWeight="Bold" FontSize="12" Foreground="#16A34A"/>
                        </StackPanel>
                        <TextBlock x:Name="TxtRequestNote" Text="Ghi chú yêu cầu: Hỗ trợ khẩn cấp" FontSize="11" Foreground="#64748B" DockPanel.Dock="Right" HorizontalAlignment="Right"/>
                    </DockPanel>

                    <!-- Bảng chi tiết nguyên liệu và đối soát -->
                    <DataGrid x:Name="GridDetails" AutoGenerateColumns="False" CanUserAddRows="False"
                              HeadersVisibility="Column" GridLinesVisibility="All" HorizontalGridLinesBrush="#E2E8F0" VerticalGridLinesBrush="#E2E8F0"
                              RowHeight="32" Background="White" BorderBrush="#CBD5E1" BorderThickness="1" SelectionMode="Single">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="STT" Binding="{Binding DetailId}" Width="45" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Mã NL" Binding="{Binding IngredientCode}" Width="80" IsReadOnly="True" Foreground="#64748B"/>
                            <DataGridTextColumn Header="Tên Nguyên Liệu" Binding="{Binding IngredientName}" Width="*" IsReadOnly="True" FontWeight="Bold"/>
                            <DataGridTextColumn Header="ĐVT" Binding="{Binding Uom}" Width="50" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Yêu Cầu" Binding="{Binding RequestedQuantity, StringFormat='{}{0:N1}'}" Width="75" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Xuất Đi" Binding="{Binding DispatchedQuantity, StringFormat='{}{0:N1}'}" Width="75" IsReadOnly="True" FontWeight="SemiBold"/>
                            <DataGridTextColumn Header="Thực Nhận" Binding="{Binding ReceivedQuantity, StringFormat='{}{0:N1}'}" Width="85" IsReadOnly="True" FontWeight="Bold" Foreground="#16A34A"/>
                            <DataGridTextColumn Header="Lệch" Binding="{Binding DiscrepancyQuantity, StringFormat='{}{0:+#,##0.###;-#,##0.###;0}'}" Width="65" IsReadOnly="True" FontWeight="Bold" Foreground="#DC2626"/>
                            <DataGridTextColumn Header="Lý Do Sai Lệch" Binding="{Binding DiscrepancyReason}" Width="150" IsReadOnly="True" FontSize="10"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Ghi chú đối soát kiểm đếm nếu có -->
                    <Border Background="#FFFBEB" CornerRadius="6" Padding="10,6" Margin="0,12,0,20" BorderBrush="#FDE68A" BorderThickness="1">
                        <TextBlock x:Name="TxtReconNote" Text="Biên bản đối soát: Khớp hoàn toàn số lượng xuất nhận." FontSize="11" Foreground="#B45309" TextWrapping="Wrap"/>
                    </Border>

                    <!-- Chữ ký 3 bên -->
                    <Grid Margin="0,20,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                            <TextBlock Text="NGƯỜI LẬP YÊU CẦU" FontWeight="Bold" FontSize="11" Foreground="#334155" HorizontalAlignment="Center"/>
                            <TextBlock Text="(Ký &amp; ghi rõ họ tên)" FontSize="10" Foreground="#94A3B8" HorizontalAlignment="Center" Margin="0,2,0,50"/>
                            <TextBlock x:Name="TxtReqName" Text="Nguyễn Văn A" FontWeight="SemiBold" FontSize="11" Foreground="#0F172A" HorizontalAlignment="Center"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                            <TextBlock Text="THỦ KHO XUẤT HÀNG" FontWeight="Bold" FontSize="11" Foreground="#334155" HorizontalAlignment="Center"/>
                            <TextBlock Text="(Ký &amp; ghi rõ họ tên)" FontSize="10" Foreground="#94A3B8" HorizontalAlignment="Center" Margin="0,2,0,50"/>
                            <TextBlock x:Name="TxtDispName" Text="Trần Thị B" FontWeight="SemiBold" FontSize="11" Foreground="#0F172A" HorizontalAlignment="Center"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                            <TextBlock Text="THỦ KHO NHẬN HÀNG" FontWeight="Bold" FontSize="11" Foreground="#334155" HorizontalAlignment="Center"/>
                            <TextBlock Text="(Ký &amp; ghi rõ họ tên)" FontSize="10" Foreground="#94A3B8" HorizontalAlignment="Center" Margin="0,2,0,50"/>
                            <TextBlock x:Name="TxtRecName" Text="Lê Văn C" FontWeight="SemiBold" FontSize="11" Foreground="#0F172A" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>
        </ScrollViewer>

        <!-- Thanh nút in và đóng -->
        <DockPanel Grid.Row="1" Margin="0,15,0,0">
            <TextBlock Text="💡 Bạn có thể bấm In để xuất ra máy in hóa đơn/khổ A4 hoặc lưu PDF" FontSize="11" Foreground="#64748B" VerticalAlignment="Center"/>

            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Đóng" Click="BtnClose_Click"
                        Width="90" Height="36" Background="#E2E8F0" Foreground="#334155" FontWeight="SemiBold" BorderThickness="0" Cursor="Hand" Margin="0,0,10,0">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="6"/>
                        </Style>
                    </Button.Resources>
                </Button>

                <Button Content="🖨️ In Phiếu" Click="BtnPrint_Click"
                        Padding="18,0" Height="36" Background="#2563EB" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="6"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
