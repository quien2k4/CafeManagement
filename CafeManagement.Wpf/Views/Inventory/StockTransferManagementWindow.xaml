<Window x:Class="CafeManagement.Wpf.Views.Inventory.StockTransferManagementWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Quản Lý Điều Chuyển Nguyên Liệu Liên Chi Nhánh &amp; Đối Soát Sai Lệch"
        Height="780" Width="1240"
        WindowStartupLocation="CenterScreen"
        Background="#F1F5F9"
        FontFamily="Segoe UI">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /> <!-- Header & Toolbar -->
            <RowDefinition Height="Auto" /> <!-- Filter Pills & Search -->
            <RowDefinition Height="*" />    <!-- Bố cục 2 cột: Danh sách & Chi tiết -->
        </Grid.RowDefinitions>

        <!-- 1. Header & Thanh tác vụ chính -->
        <Border Grid.Row="0" Background="White" CornerRadius="12" Padding="20,16" Margin="0,0,0,15" BorderBrush="#E2E8F0" BorderThickness="1">
            <DockPanel>
                <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center">
                    <TextBlock Text="🚚 QUẢN LÝ ĐIỀU CHUYỂN NGUYÊN LIỆU LIÊN CHI NHÁNH" FontWeight="Bold" FontSize="18" Foreground="#1E293B"/>
                    <TextBlock Text="Quy trình 6 giai đoạn: Yêu cầu ➔ Phê duyệt ➔ Xuất kho In-transit ➔ Nhận hàng ➔ Đối soát sai lệch ➔ Hoàn tất" FontSize="12" Foreground="#64748B" Margin="0,3,0,0"/>
                </StackPanel>

                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="➕ Tạo Yêu Cầu Điều Chuyển" Click="BtnCreateRequest_Click"
                            Background="#2563EB" Foreground="White" FontWeight="Bold" FontSize="13" Padding="16,10" Margin="0,0,10,0" BorderThickness="0" Cursor="Hand">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="8"/>
                            </Style>
                        </Button.Resources>
                    </Button>

                    <Button Content="🔄 Làm mới" Click="BtnRefresh_Click"
                            Background="#F1F5F9" Foreground="#334155" FontWeight="Bold" FontSize="13" Padding="14,10" BorderThickness="0" Cursor="Hand">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="8"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- 2. Thanh lọc trạng thái & Tìm kiếm -->
        <Border Grid.Row="1" Background="White" CornerRadius="12" Padding="14,10" Margin="0,0,0,15" BorderBrush="#E2E8F0" BorderThickness="1">
            <DockPanel>
                <!-- Filter Pills -->
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                    <RadioButton Content="Tất cả" GroupName="StatusFilter" IsChecked="True" Checked="Filter_Checked" Tag="ALL"
                                 Margin="0,0,6,0" Style="{StaticResource {x:Type ToggleButton}}" Padding="12,6" FontSize="11" FontWeight="SemiBold"/>
                    <RadioButton Content="⏳ Chờ duyệt" GroupName="StatusFilter" Checked="Filter_Checked" Tag="REQUESTED"
                                 Margin="0,0,6,0" Style="{StaticResource {x:Type ToggleButton}}" Padding="12,6" FontSize="11" FontWeight="SemiBold"/>
                    <RadioButton Content="🚚 Đang vận chuyển" GroupName="StatusFilter" Checked="Filter_Checked" Tag="IN_TRANSIT"
                                 Margin="0,0,6,0" Style="{StaticResource {x:Type ToggleButton}}" Padding="12,6" FontSize="11" FontWeight="SemiBold"/>
                    <RadioButton Content="📦 Cần kiểm đếm nhận" GroupName="StatusFilter" Checked="Filter_Checked" Tag="NEED_RECEIVE"
                                 Margin="0,0,6,0" Style="{StaticResource {x:Type ToggleButton}}" Padding="12,6" FontSize="11" FontWeight="SemiBold"/>
                    <RadioButton Content="✅ Đã hoàn tất" GroupName="StatusFilter" Checked="Filter_Checked" Tag="COMPLETED"
                                 Margin="0,0,6,0" Style="{StaticResource {x:Type ToggleButton}}" Padding="12,6" FontSize="11" FontWeight="SemiBold"/>
                </StackPanel>

                <!-- Search box -->
                <Border DockPanel.Dock="Right" Background="#F8FAFC" CornerRadius="8" BorderBrush="#E2E8F0" BorderThickness="1" Width="260" HorizontalAlignment="Right">
                    <Grid>
                        <TextBox x:Name="TxtSearch" Text="{Binding SearchKeyword, UpdateSourceTrigger=PropertyChanged}" 
                                 Height="32" Padding="10,0" VerticalContentAlignment="Center" Background="Transparent" BorderThickness="0" FontSize="12"/>
                        <TextBlock Text="🔍 Tìm mã phiếu, chi nhánh..." FontSize="11" Foreground="#94A3B8" VerticalAlignment="Center" Margin="12,0,0,0" IsHitTestVisible="False">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=TxtSearch}" Value="">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </Border>
            </DockPanel>
        </Border>

        <!-- 3. Bố cục 2 Cột: Bảng danh sách phiếu (Trái) & Thẻ chi tiết phiếu (Phải) -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="5.2*" />
                <ColumnDefinition Width="4.8*" />
            </Grid.ColumnDefinitions>

            <!-- CỘT TRÁI: DANH SÁCH CÁC PHIẾU ĐIỀU CHUYỂN -->
            <Border Grid.Column="0" Background="White" CornerRadius="12" Padding="14" Margin="0,0,12,0" BorderBrush="#E2E8F0" BorderThickness="1">
                <DataGrid x:Name="GridTransfers" ItemsSource="{Binding Transfers}" SelectedItem="{Binding SelectedTransfer, Mode=TwoWay}"
                          AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" IsReadOnly="True"
                          HeadersVisibility="Column" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#F1F5F9"
                          RowHeight="48" Background="White" BorderThickness="0" SelectionMode="Single">
                    <DataGrid.Columns>
                        <!-- Mã phiếu -->
                        <DataGridTemplateColumn Header="Mã Phiếu" Width="135">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel VerticalAlignment="Center" Margin="4,0">
                                        <TextBlock Text="{Binding TransferCode}" FontWeight="Bold" FontSize="12" Foreground="#2563EB"/>
                                        <TextBlock Text="{Binding RequestedDate, StringFormat='{}{0:dd/MM HH:mm}'}" FontSize="10" Foreground="#94A3B8"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Lộ trình xuất ➔ nhận -->
                        <DataGridTemplateColumn Header="Lộ Trình Điều Chuyển" Width="*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel VerticalAlignment="Center" Margin="4,0">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding FromBranchName}" FontWeight="SemiBold" FontSize="12" Foreground="#334155"/>
                                            <TextBlock Text=" ➔ " FontWeight="Bold" FontSize="12" Foreground="#2563EB"/>
                                            <TextBlock Text="{Binding ToBranchName}" FontWeight="SemiBold" FontSize="12" Foreground="#0F172A"/>
                                        </StackPanel>
                                        <TextBlock Text="{Binding TotalItemsCount, StringFormat='Số lượng: {0} loại nguyên liệu'}" FontSize="10" Foreground="#64748B" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Trạng thái -->
                        <DataGridTemplateColumn Header="Trạng Thái" Width="140">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Background="#F1F5F9" CornerRadius="6" Padding="8,4" HorizontalAlignment="Left" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding StatusBadgeText}" FontSize="11" FontWeight="Bold" Foreground="{Binding StatusColorHex}"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <!-- CỘT PHẢI: CHI TIẾT PHIẾU ĐƯỢC CHỌN & CÁC NÚT DUYỆT / NHẬN / ĐỐI SOÁT -->
            <Border Grid.Column="1" Background="White" CornerRadius="12" Padding="20" BorderBrush="#E2E8F0" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" /> <!-- Header chi tiết & Trạng thái lớn -->
                        <RowDefinition Height="Auto" /> <!-- Quy trình 4 mốc thời gian -->
                        <RowDefinition Height="*" />    <!-- Bảng chi tiết nguyên liệu -->
                        <RowDefinition Height="Auto" /> <!-- Ghi chú đối soát & chênh lệch -->
                        <RowDefinition Height="Auto" /> <!-- Thanh nút hành động -->
                    </Grid.RowDefinitions>

                    <!-- 1. Header chi tiết -->
                    <DockPanel Grid.Row="0" Margin="0,0,0,14">
                        <StackPanel DockPanel.Dock="Left">
                            <TextBlock Text="{Binding SelectedTransfer.TransferCode, FallbackValue='(Chưa chọn phiếu)'}" FontWeight="Bold" FontSize="16" Foreground="#1E293B"/>
                            <TextBlock Text="{Binding SelectedTransfer.RequestedDate, StringFormat='Ngày tạo: {0:dd/MM/yyyy HH:mm}', FallbackValue='--'}" FontSize="11" Foreground="#64748B" Margin="0,2,0,0"/>
                        </StackPanel>

                        <Border DockPanel.Dock="Right" CornerRadius="8" Padding="12,6" HorizontalAlignment="Right" VerticalAlignment="Center" Background="#F1F5F9">
                            <TextBlock Text="{Binding SelectedTransfer.StatusBadgeText, FallbackValue='--'}" FontWeight="Bold" FontSize="13" Foreground="{Binding SelectedTransfer.StatusColorHex}"/>
                        </Border>
                    </DockPanel>

                    <!-- 2. Thẻ 4 mốc thời gian của vòng đời điều chuyển -->
                    <Border Grid.Row="1" Background="#F8FAFC" CornerRadius="8" Padding="12,8" Margin="0,0,0,12" BorderBrush="#E2E8F0" BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- Mốc 1: Yêu cầu -->
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="1. YÊU CẦU" FontSize="10" FontWeight="Bold" Foreground="#64748B"/>
                                <TextBlock Text="{Binding SelectedTransfer.RequestedByName, FallbackValue='--'}" FontSize="11" FontWeight="SemiBold" Foreground="#334155" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding SelectedTransfer.RequestedDate, StringFormat='{}{0:HH:mm dd/MM}'}" FontSize="10" Foreground="#94A3B8"/>
                            </StackPanel>

                            <!-- Mốc 2: Phê duyệt -->
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="2. PHÊ DUYỆT" FontSize="10" FontWeight="Bold" Foreground="#64748B"/>
                                <TextBlock Text="{Binding SelectedTransfer.ApprovedByName, FallbackValue='(Chờ duyệt)'}" FontSize="11" FontWeight="SemiBold" Foreground="#334155" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding SelectedTransfer.ApprovedDate, StringFormat='{}{0:HH:mm dd/MM}', FallbackValue='--'}" FontSize="10" Foreground="#94A3B8"/>
                            </StackPanel>

                            <!-- Mốc 3: Xuất kho -->
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="3. XUẤT KHO" FontSize="10" FontWeight="Bold" Foreground="#64748B"/>
                                <TextBlock Text="{Binding SelectedTransfer.DispatchedByName, FallbackValue='(Chưa xuất)'}" FontSize="11" FontWeight="SemiBold" Foreground="#334155" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding SelectedTransfer.DispatchedDate, StringFormat='{}{0:HH:mm dd/MM}', FallbackValue='--'}" FontSize="10" Foreground="#94A3B8"/>
                            </StackPanel>

                            <!-- Mốc 4: Nhận & Đối soát -->
                            <StackPanel Grid.Column="3">
                                <TextBlock Text="4. NHẬN &amp; ĐỐI SOÁT" FontSize="10" FontWeight="Bold" Foreground="#64748B"/>
                                <TextBlock Text="{Binding SelectedTransfer.ReceivedByName, FallbackValue='(Chờ nhận)'}" FontSize="11" FontWeight="SemiBold" Foreground="#334155" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding SelectedTransfer.ReceivedDate, StringFormat='{}{0:HH:mm dd/MM}', FallbackValue='--'}" FontSize="10" Foreground="#94A3B8"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- 3. Bảng danh sách nguyên liệu trong phiếu -->
                    <Border Grid.Row="2" Background="White" CornerRadius="8" Padding="4" Margin="0,0,0,10" BorderBrush="#E2E8F0" BorderThickness="1">
                        <DataGrid ItemsSource="{Binding SelectedTransfer.Details}" AutoGenerateColumns="False" CanUserAddRows="False"
                                  HeadersVisibility="Column" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#F1F5F9"
                                  RowHeight="36" Background="White" BorderThickness="0" IsReadOnly="True" SelectionMode="Single">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Nguyên Liệu" Binding="{Binding IngredientName}" Width="*" FontWeight="Bold"/>
                                <DataGridTextColumn Header="ĐVT" Binding="{Binding Uom}" Width="45" Foreground="#64748B"/>
                                <DataGridTextColumn Header="Yêu Cầu" Binding="{Binding RequestedQuantity, StringFormat='{}{0:N1}'}" Width="65"/>
                                <DataGridTextColumn Header="Xuất Đi" Binding="{Binding DispatchedQuantity, StringFormat='{}{0:N1}'}" Width="65" FontWeight="SemiBold"/>
                                <DataGridTextColumn Header="Thực Nhận" Binding="{Binding ReceivedQuantity, StringFormat='{}{0:N1}'}" Width="75" FontWeight="Bold" Foreground="#16A34A"/>
                                <DataGridTemplateColumn Header="Lệch" Width="65">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding DiscrepancyQuantity, StringFormat='{}{0:+#,##0.###;-#,##0.###;0}'}" FontWeight="Bold" FontSize="11"
                                                       VerticalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="#DC2626"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding DiscrepancyQuantity}" Value="0">
                                                                <Setter Property="Foreground" Value="#64748B"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Lý Do Sai Lệch" Binding="{Binding DiscrepancyReason}" Width="110" FontSize="10"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>

                    <!-- 4. Ghi chú & Đối soát -->
                    <Border Grid.Row="3" Background="#FFFBEB" CornerRadius="8" Padding="12,8" Margin="0,0,0,12" BorderBrush="#FDE68A" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="{Binding SelectedTransfer.RequestNote, StringFormat='📝 Ghi chú yêu cầu: {0}', FallbackValue='📝 Ghi chú yêu cầu: Không có'}" FontSize="11" Foreground="#475569"/>
                            <TextBlock Text="{Binding SelectedTransfer.ReconciliationNote, StringFormat='⚖️ Biên bản đối soát: {0}', FallbackValue='⚖️ Biên bản đối soát: Chưa kiểm đếm'}" 
                                       FontSize="11" FontWeight="SemiBold" Foreground="#B45309" Margin="0,3,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- 5. Thanh nút thao tác theo ngữ cảnh -->
                    <DockPanel Grid.Row="4">
                        <!-- Nút in biên bản -->
                        <Button DockPanel.Dock="Left" Content="🖨️ In Biên Bản" Click="BtnPrintSlip_Click"
                                Background="#F1F5F9" Foreground="#334155" FontWeight="SemiBold" FontSize="12" Padding="12,8" BorderThickness="0" Cursor="Hand">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="6"/>
                                </Style>
                            </Button.Resources>
                        </Button>

                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                            <!-- Nút Hủy -->
                            <Button Content="Hủy phiếu" Click="BtnCancel_Click"
                                    Visibility="{Binding CanCancel, Converter={StaticResource BoolToVis}}"
                                    Background="#FFF1F2" Foreground="#E11D48" FontWeight="SemiBold" FontSize="12" Padding="12,8" Margin="0,0,8,0" BorderThickness="0" Cursor="Hand">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="6"/>
                                    </Style>
                                </Button.Resources>
                            </Button>

                            <!-- Nút Từ chối (Dành cho Chi nhánh nguồn khi status = REQUESTED) -->
                            <Button Content="❌ Từ chối" Click="BtnReject_Click"
                                    Visibility="{Binding CanApproveOrDispatch, Converter={StaticResource BoolToVis}}"
                                    Background="#FEE2E2" Foreground="#DC2626" FontWeight="Bold" FontSize="12" Padding="12,8" Margin="0,0,8,0" BorderThickness="0" Cursor="Hand">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="6"/>
                                    </Style>
                                </Button.Resources>
                            </Button>

                            <!-- Nút Duyệt & Xuất Kho (Dành cho Chi nhánh nguồn) -->
                            <Button Content="🚀 Duyệt &amp; Xuất Kho Ngay" Click="BtnDispatch_Click"
                                    Visibility="{Binding CanApproveOrDispatch, Converter={StaticResource BoolToVis}}"
                                    Background="#2563EB" Foreground="White" FontWeight="Bold" FontSize="12" Padding="14,8" Margin="0,0,8,0" BorderThickness="0" Cursor="Hand">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="6"/>
                                    </Style>
                                </Button.Resources>
                            </Button>

                            <!-- Nút Kiểm Đếm & Nhận Hàng (Dành cho Chi nhánh đích khi IN_TRANSIT) -->
                            <Button Content="📦 Kiểm Đếm &amp; Đối Soát Nhập Kho" Click="BtnReconcile_Click"
                                    Visibility="{Binding CanReceiveAndReconcile, Converter={StaticResource BoolToVis}}"
                                    Background="#16A34A" Foreground="White" FontWeight="Bold" FontSize="12" Padding="16,8" BorderThickness="0" Cursor="Hand">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="6"/>
                                    </Style>
                                </Button.Resources>
                            </Button>
                        </StackPanel>
                    </DockPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
